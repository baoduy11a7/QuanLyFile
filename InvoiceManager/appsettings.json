{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=InvoiceManagerDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "InvoiceSettings": {
    "StorageRootPath": "App_Data/RawFiles",
    "WatchFolderPath": "App_Data/WatchFolder",
    "MaxFileSizeMb": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*"
}
