@model List<InvoiceManager.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Nhật ký Kiểm toán (Audit Log)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-primary mb-1"><i class="bi bi-shield-check me-2"></i> Nhật ký Kiểm toán & Truy vết Dữ liệu Thuế</h4>
        <p class="text-muted small mb-0">Theo dõi toàn bộ các thao tác nhạy cảm: Xem, Xuất Excel/PDF, Import và Xóa hóa đơn</p>
    </div>
    <span class="badge bg-light text-dark border font-monospace">Tổng bản ghi trang này: @Model.Count</span>
</div>

<div class="table-responsive table-invoice">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th style="width: 160px;">Thời gian</th>
                <th style="width: 140px;">Người thực hiện</th>
                <th style="width: 150px;">Hành động</th>
                <th>Đối tượng / Hóa đơn</th>
                <th>Chi tiết thao tác</th>
                <th style="width: 120px;" class="text-end">Địa chỉ IP</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var log in Model)
                {
                    <tr>
                        <td class="font-monospace small text-muted">@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>
                            <strong class="small text-dark">@log.UserName</strong>
                        </td>
                        <td>
                            @if (log.Action.Contains("Xuất"))
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">@log.Action</span>
                            }
                            else if (log.Action.Contains("Import"))
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@log.Action</span>
                            }
                            else if (log.Action.Contains("Xem"))
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle">@log.Action</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">@log.Action</span>
                            }
                        </td>
                        <td>
                            <strong class="font-monospace text-primary small">@log.Target</strong>
                        </td>
                        <td class="small text-muted text-truncate" style="max-width: 320px;" title="@log.Details">
                            @log.Details
                        </td>
                        <td class="text-end font-monospace small text-muted">@log.IpAddress</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                        Chưa có bản ghi nhật ký kiểm toán nào.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-end mb-0">
            @for (int p = 1; p <= ViewBag.TotalPages; p++)
            {
                <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
