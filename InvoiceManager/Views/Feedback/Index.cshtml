@model List<InvoiceManager.Models.Entities.FeatureRequest>
@{
    ViewData["Title"] = "Báo lỗi & Yêu cầu tính năng";
    var taxAccount = ViewBag.CurrentTaxAccount as InvoiceManager.Models.Entities.TaxAccount;
    bool isAdmin = ViewBag.IsAdmin == true;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i class="bi bi-chat-left-dots-fill text-primary me-2"></i>Báo lỗi & Yêu cầu tính năng
            </h4>
            <div class="text-muted small">Kênh tiếp nhận phản hồi, báo cáo lỗi nghiệp vụ và đề xuất nâng cấp hệ thống hóa đơn</div>
        </div>
        <div>
            <button type="button" class="btn btn-primary fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#feedbackModal">
                <i class="bi bi-plus-circle me-1"></i> Gửi yêu cầu / Báo lỗi mới
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-primary">
                <div class="text-muted small fw-semibold">Tổng số yêu cầu</div>
                <div class="fs-4 fw-bold text-dark mt-1">@ViewBag.TotalCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-warning">
                <div class="text-muted small fw-semibold">Chờ tiếp nhận</div>
                <div class="fs-4 fw-bold text-warning mt-1">@ViewBag.PendingCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-info">
                <div class="text-muted small fw-semibold">Đang xử lý</div>
                <div class="fs-4 fw-bold text-info mt-1">@ViewBag.ProcessingCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-success">
                <div class="text-muted small fw-semibold">Đã xử lý / Hoàn thành</div>
                <div class="fs-4 fw-bold text-success mt-1">@ViewBag.CompletedCount</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <select name="requestType" class="form-select form-select-sm">
                        <option value="">-- Tất cả loại yêu cầu --</option>
                        <option value="Báo lỗi" selected="@(ViewBag.RequestTypeFilter == "Báo lỗi")">🐞 Báo lỗi hệ thống</option>
                        <option value="Yêu cầu tính năng" selected="@(ViewBag.RequestTypeFilter == "Yêu cầu tính năng")">💡 Yêu cầu tính năng mới</option>
                        <option value="Hỗ trợ nghiệp vụ" selected="@(ViewBag.RequestTypeFilter == "Hỗ trợ nghiệp vụ")">🛠 Hỗ trợ nghiệp vụ đối soát</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select form-select-sm">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Chờ tiếp nhận" selected="@(ViewBag.StatusFilter == "Chờ tiếp nhận")">Chờ tiếp nhận</option>
                        <option value="Đang xử lý" selected="@(ViewBag.StatusFilter == "Đang xử lý")">Đang xử lý</option>
                        <option value="Đã xử lý" selected="@(ViewBag.StatusFilter == "Đã xử lý")">Đã xử lý</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="keyword" class="form-control" placeholder="Tìm theo tiêu đề, nội dung, người gửi..." value="@ViewBag.Keyword" />
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                        <i class="bi bi-funnel"></i> Lọc
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.RequestTypeFilter) || !string.IsNullOrEmpty(ViewBag.StatusFilter) || !string.IsNullOrEmpty(ViewBag.Keyword))
                    {
                        <a asp-action="Index" class="btn btn-outline-danger btn-sm" title="Xóa lọc">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Table of Requests -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;" class="text-center">STT</th>
                            <th style="width: 150px;">Phân loại</th>
                            <th>Tiêu đề & Nội dung</th>
                            <th style="width: 180px;">Đơn vị / MST</th>
                            <th style="width: 150px;">Người liên hệ</th>
                            <th style="width: 120px;">Ngày gửi</th>
                            <th class="text-center" style="width: 140px;">Trạng thái</th>
                            <th class="text-center" style="width: 110px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            int idx = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center text-muted">@idx</td>
                                    <td>
                                        @if (item.RequestType == "Báo lỗi")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-bug me-1"></i> Báo lỗi
                                            </span>
                                        }
                                        else if (item.RequestType == "Yêu cầu tính năng")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="bi bi-lightbulb me-1"></i> Tính năng mới
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                                <i class="bi bi-tools me-1"></i> Nghiệp vụ
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Title</div>
                                        <div class="small text-muted text-truncate" style="max-width: 380px;" title="@item.Description">
                                            @item.Description
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@(item.TaxAccount?.CompanyName ?? "Chung")</div>
                                        <div class="small text-muted font-monospace">@(item.TaxAccount?.TaxCode ?? "")</div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@(item.ContactName ?? "-")</div>
                                        <div class="small text-muted">@(item.ContactPhone ?? "-")</div>
                                    </td>
                                    <td class="small text-muted">
                                        @item.CreatedAt.ToString("dd/MM/yyyy")
                                        <div style="font-size: 0.7rem;">@item.CreatedAt.ToString("HH:mm")</div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Status == "Chờ tiếp nhận")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Chờ tiếp nhận</span>
                                        }
                                        else if (item.Status == "Đang xử lý")
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">Đang xử lý</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Đã xử lý</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-outline-primary btn-sm p-1 px-2" title="Xem chi tiết yêu cầu" onclick="viewDetail('@Html.Raw(Html.Encode(item.Title))', '@Html.Raw(Html.Encode(item.Description))', '@item.RequestType', '@item.Status', '@(item.ContactName ?? "")', '@(item.ContactPhone ?? "")', '@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")')">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            @if (isAdmin)
                                            {
                                                <!-- Dropdown cập nhật trạng thái nhanh -->
                                                <div class="dropdown">
                                                    <button class="btn btn-outline-secondary btn-sm p-1 px-2" data-bs-toggle="dropdown" title="Cập nhật trạng thái">
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                                        <li class="dropdown-header small">Đổi trạng thái:</li>
                                                        <li>
                                                            <form asp-action="UpdateStatus" method="post" class="m-0">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <input type="hidden" name="status" value="Chờ tiếp nhận" />
                                                                <button type="submit" class="dropdown-item small text-warning"><i class="bi bi-hourglass me-2"></i>Chờ tiếp nhận</button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form asp-action="UpdateStatus" method="post" class="m-0">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <input type="hidden" name="status" value="Đang xử lý" />
                                                                <button type="submit" class="dropdown-item small text-info"><i class="bi bi-gear-wide-connected me-2"></i>Đang xử lý</button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form asp-action="UpdateStatus" method="post" class="m-0">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <input type="hidden" name="status" value="Đã xử lý" />
                                                                <button type="submit" class="dropdown-item small text-success"><i class="bi bi-check-circle me-2"></i>Đã xử lý</button>
                                                            </form>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc muốn xóa yêu cầu này?');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <button type="submit" class="dropdown-item small text-danger"><i class="bi bi-trash me-2"></i>Xóa yêu cầu</button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2"></i>
                                    <div class="mt-2 fw-semibold">Không có phản hồi hoặc yêu cầu nào phù hợp.</div>
                                    <button type="button" class="btn btn-outline-primary btn-sm mt-3" data-bs-toggle="modal" data-bs-target="#feedbackModal">
                                        <i class="bi bi-plus-circle me-1"></i> Gửi yêu cầu ngay
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi Tiết Yêu Cầu -->
<div class="modal fade" id="modalViewFeedback" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="detailTitle">Chi tiết yêu cầu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex gap-2 mb-3">
                    <span id="detailTypeBadge" class="badge"></span>
                    <span id="detailStatusBadge" class="badge"></span>
                    <span class="text-muted small ms-auto" id="detailTime"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Nội dung yêu cầu / Mô tả lỗi:</label>
                    <div class="p-3 bg-light rounded border text-dark" id="detailDescription" style="white-space: pre-wrap; font-size: 0.95rem;"></div>
                </div>
                <div class="row g-2 border-top pt-3 text-muted small">
                    <div class="col-sm-6">
                        <strong>Người gửi:</strong> <span id="detailContactName"></span>
                    </div>
                    <div class="col-sm-6">
                        <strong>Số điện thoại:</strong> <span id="detailContactPhone"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewDetail(title, desc, type, status, name, phone, time) {
            $('#detailTitle').text(title);
            $('#detailDescription').text(desc);
            $('#detailTypeBadge').text(type).attr('class', 'badge ' + (type === 'Báo lỗi' ? 'bg-danger' : type === 'Yêu cầu tính năng' ? 'bg-primary' : 'bg-info'));
            $('#detailStatusBadge').text(status).attr('class', 'badge ' + (status === 'Chờ tiếp nhận' ? 'bg-warning text-dark' : status === 'Đang xử lý' ? 'bg-info' : 'bg-success'));
            $('#detailContactName').text(name || '-');
            $('#detailContactPhone').text(phone || '-');
            $('#detailTime').text(time);
            $('#modalViewFeedback').modal('show');
        }
    </script>
}
