@model InvoiceManager.Models.Entities.Invoice

@functions {
    public static string NumberToVietnameseWords(decimal number)
    {
        if (number == 0) return "Không đồng";
        long n = (long)Math.Round(number);
        if (n == 0) return "Không đồng";

        string[] units = { "", "nghìn", "triệu", "tỷ", "nghìn tỷ", "triệu tỷ" };
        string[] digits = { "không", "một", "hai", "ba", "bốn", "năm", "sáu", "bảy", "tám", "chín" };

        string ReadThreeDigits(int num, bool isFirstGroup)
        {
            int h = num / 100;
            int t = (num % 100) / 10;
            int u = num % 10;

            if (num == 0) return "";
            var sb = new System.Text.StringBuilder();

            if (!isFirstGroup || h > 0)
            {
                sb.Append(digits[h]).Append(" trăm ");
            }

            if (t > 1)
            {
                sb.Append(digits[t]).Append(" mươi ");
                if (u == 1) sb.Append("mốt ");
                else if (u == 5) sb.Append("lăm ");
                else if (u > 0) sb.Append(digits[u]).Append(" ");
            }
            else if (t == 1)
            {
                sb.Append("mười ");
                if (u == 5) sb.Append("lăm ");
                else if (u > 0) sb.Append(digits[u]).Append(" ");
            }
            else if (t == 0 && u > 0)
            {
                if (!isFirstGroup || h > 0) sb.Append("linh ");
                sb.Append(digits[u]).Append(" ");
            }

            return sb.ToString().Trim();
        }

        var groups = new System.Collections.Generic.List<int>();
        long temp = n;
        while (temp > 0)
        {
            groups.Add((int)(temp % 1000));
            temp /= 1000;
        }

        var result = new System.Text.StringBuilder();
        for (int i = groups.Count - 1; i >= 0; i--)
        {
            int grp = groups[i];
            if (grp > 0)
            {
                string grpStr = ReadThreeDigits(grp, i == groups.Count - 1);
                result.Append(grpStr).Append(" ").Append(units[i]).Append(" ");
            }
        }

        string res = result.ToString().Trim();
        if (string.IsNullOrEmpty(res)) return "Không đồng";

        res = char.ToUpper(res[0]) + res.Substring(1).Trim() + " đồng chẵn.";
        return res;
    }
}

<div class="px-3 pt-2 pb-3">
    <!-- Nav tabs & Toolbar xem biểu mẫu hóa đơn chuẩn Cổng Thuế -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 pb-2 border-bottom gap-2">
        <ul class="nav nav-tabs border-0 m-0" id="invoiceDetailTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold py-1 px-3" id="preview-tab" data-bs-toggle="tab" data-bs-target="#preview-content" type="button" role="tab">
                    <i class="bi bi-file-earmark-text text-primary me-1"></i> Biểu mẫu Hóa đơn gốc (Cổng Thuế)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-1 px-3" id="xml-tab" data-bs-toggle="tab" data-bs-target="#xml-content" type="button" role="tab">
                    <i class="bi bi-file-earmark-code text-success me-1"></i> Dữ liệu XML gốc
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-1 px-3" id="audit-tab" data-bs-toggle="tab" data-bs-target="#audit-content" type="button" role="tab">
                    <i class="bi bi-shield-check text-info me-1"></i> Chứng từ & Đối soát
                </button>
            </li>
        </ul>

        <!-- Bộ công cụ thao tác file gốc và kích thước Cổng Thuế -->
        <div class="d-flex align-items-center gap-1 ms-auto flex-wrap" id="invoiceViewControls">
            @{
                bool hasOriginalPdf = !string.IsNullOrEmpty(Model.RawPdfPath) && System.IO.File.Exists(Model.RawPdfPath);
            }
            @if (hasOriginalPdf)
            {
                <a href="/Export/DownloadPdf/@Model.Id" class="btn btn-sm btn-danger py-1 px-2 fw-semibold" title="Tải file PDF gốc của nhà cung cấp" download>
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Tải PDF gốc
                </a>
            }
            else
            {
                <a href="/Export/DownloadPdf/@Model.Id" class="btn btn-sm btn-danger py-1 px-2 fw-semibold" title="Tải file PDF chuẩn mẫu Cổng Thuế" download>
                    <i class="bi bi-file-earmark-pdf me-1"></i> Tải PDF
                </a>
                <label class="btn btn-sm btn-outline-secondary py-1 px-2 fw-semibold mb-0" style="cursor: pointer;" title="Đính kèm file PDF gốc do bên bán gửi (MISA, Viettel, VNPT...)">
                    <i class="bi bi-paperclip me-1"></i> Đính kèm PDF gốc
                    <input type="file" accept=".pdf" class="d-none" onchange="uploadOriginalPdfModal(@Model.Id, this)">
                </label>
            }

            <a href="/Invoice/DownloadRawXml/@Model.Id" class="btn btn-sm btn-outline-success py-1 px-2 fw-semibold" title="Tải file XML gốc có chữ ký số điện tử của Cơ quan Thuế" download>
                <i class="bi bi-file-earmark-code-fill me-1"></i> Tải XML gốc
            </a>

            <div class="vr mx-1 d-none d-md-inline"></div>

            <span class="small text-muted me-1 d-none d-md-inline" style="font-size: 0.8rem;">Zoom:</span>
            <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2" onclick="adjustInvoiceZoom(-0.1)" title="Thu nhỏ">
                <i class="bi bi-zoom-out"></i>
            </button>
            <button type="button" class="btn btn-light btn-sm border py-1 px-2 fw-semibold font-monospace" id="lblInvoiceZoom" onclick="resetInvoiceZoom()" title="Kích thước ban đầu 100% Cổng Thuế" style="font-size: 0.8rem;">
                100%
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2" onclick="adjustInvoiceZoom(0.1)" title="Phóng to">
                <i class="bi bi-zoom-in"></i>
            </button>
            <a href="/Invoice/ViewHtml/@Model.Id" target="_blank" class="btn btn-outline-primary btn-sm py-1 px-2 fw-semibold ms-1" title="Mở trang in chuẩn A4 trong tab mới">
                <i class="bi bi-box-arrow-up-right me-1"></i> Xem toàn trang
            </a>
        </div>
    </div>

    <!-- Tab contents -->
    <div class="tab-content" id="invoiceDetailTabContent">
        <!-- Tab 1: Biểu mẫu hóa đơn điện tử chuẩn A4 theo Cổng Thuế -->
        <div class="tab-pane fade show active" id="preview-content" role="tabpanel">
            <div id="invoiceViewerContainer" style="background: #e2e8f0; padding: 12px 6px; overflow-y: auto; overflow-x: auto; -webkit-overflow-scrolling: touch; max-height: calc(88vh - 120px); border-radius: 8px;">
                <div id="invoicePaperWrapper" style="display: block; width: 100%; text-align: center;">
                    @{
                        var symbolWithMau = (!string.IsNullOrEmpty(Model.InvoiceSymbol) && !char.IsDigit(Model.InvoiceSymbol[0]))
                            ? $"1{Model.InvoiceSymbol}"
                            : Model.InvoiceSymbol;
                        var invoiceTitle = (Model.InvoiceSymbol != null && (Model.InvoiceSymbol.StartsWith("2") || Model.InvoiceSymbol.Contains("2C")))
                            ? "HÓA ĐƠN BÁN HÀNG"
                            : "HÓA ĐƠN GIÁ TRỊ GIA TĂNG";
                    }
                    <!-- Khung viền đôi chuẩn văn bản hành chính Hóa đơn điện tử Cổng Thuế (hoadondientu.gdt.gov.vn) -->
                    <div id="invoicePaperSheet" style="display: inline-block; text-align: left; width: 100%; max-width: 840px; background: #ffffff; border: 2px solid #000000; outline: 1px solid #000000; outline-offset: -5px; padding: 25px 35px; box-shadow: 0 4px 25px rgba(0,0,0,0.15); box-sizing: border-box; font-family: 'Times New Roman', Times, serif; color: #000000; line-height: 1.5; transform-origin: top center; transition: transform 0.15s ease; height: auto !important;">
                        
                        <!-- 1. Header Quốc hiệu & Mẫu số - Ký hiệu chuẩn Cổng Thuế -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                            <div style="width: 48%; text-align: center;">
                                <div style="font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.2px;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                                <div style="font-size: 12.5px; font-weight: bold; margin-top: 2px;">Độc lập - Tự do - Hạnh phúc</div>
                                <div style="width: 140px; height: 1px; background: #000000; margin: 4px auto 0 auto;"></div>
                            </div>
                            <div style="width: 48%; text-align: right; font-size: 13px; line-height: 1.6;">
                                <div>Mẫu số - Ký hiệu (Serial No.): <strong style="font-size: 14px; color: #b91c1c;">@symbolWithMau</strong></div>
                                <div>Số (Invoice No.): <strong style="font-size: 18px; color: #b91c1c;">@Model.InvoiceNumber</strong></div>
                            </div>
                        </div>

                        <!-- 2. Tiêu đề Hóa đơn -->
                        <div style="text-align: center; margin: 8px 0 14px 0;">
                            <h2 style="margin: 0; color: #b91c1c; font-weight: bold; text-transform: uppercase; font-size: 22px; letter-spacing: 0.5px;">
                                @invoiceTitle
                            </h2>
                            <div style="font-size: 13px; font-style: italic; color: #374151; margin-top: 3px;">
                                (Bản thể hiện của hóa đơn điện tử)
                            </div>
                            <div style="font-size: 13.5px; margin-top: 4px;">
                                Ngày @Model.IssueDate.Day.ToString("00") tháng @Model.IssueDate.Month.ToString("00") năm @Model.IssueDate.Year
                            </div>
                        </div>

                        <!-- 3. Khung xác thực CQT -->
                        @if (!string.IsNullOrWhiteSpace(Model.TaxAuthorityCode))
                        {
                            <div style="margin: 6px 0 12px 0; padding: 6px 12px; border: 1px dashed #2563eb; background: #eff6ff; font-size: 12px; border-radius: 3px;">
                                <strong>Mã của cơ quan thuế:</strong> <span style="font-family: monospace; font-weight: bold; color: #1e40af; font-size: 13px;">@Model.TaxAuthorityCode</span><br />
                                <span style="font-style: italic; color: #1d4ed8; font-size: 11.5px;">(Hóa đơn điện tử có mã của cơ quan thuế được cấp bởi Cổng thông tin Tổng cục Thuế)</span>
                            </div>
                        }
                        else
                        {
                            <div style="margin: 4px 0 10px 0; font-size: 12px; font-style: italic; color: #4b5563; text-align: right;">
                                (Hóa đơn điện tử không có mã của cơ quan thuế)
                            </div>
                        }

                        <!-- 4. Thông tin Người Bán (Đơn vị bán hàng) -->
                        <div style="border-top: 1px solid #000000; border-bottom: 1px solid #000000; padding: 8px 0; margin-bottom: 8px; font-size: 13.5px; line-height: 1.6;">
                            <div><strong>Đơn vị bán hàng (Seller):</strong> <span style="font-weight: bold; text-transform: uppercase;">@Model.SellerName</span></div>
                            <div><strong>Mã số thuế (Tax code):</strong> <strong style="font-size: 14px; font-family: monospace; letter-spacing: 0.5px;">@Model.SellerTaxCode</strong></div>
                            <div><strong>Địa chỉ (Address):</strong> @Model.SellerAddress</div>
                        </div>

                        <!-- 5. Thông tin Người Mua (Đơn vị mua hàng) -->
                        <div style="border-bottom: 1px solid #000000; padding-bottom: 8px; margin-bottom: 14px; font-size: 13.5px; line-height: 1.6;">
                            <div><strong>Họ tên người mua hàng (Buyer):</strong> @(string.IsNullOrWhiteSpace(Model.BuyerName) ? "Người mua không lấy hóa đơn" : Model.BuyerName)</div>
                            <div><strong>Tên đơn vị (Company name):</strong> @(string.IsNullOrWhiteSpace(Model.BuyerName) ? "---" : Model.BuyerName)</div>
                            <div><strong>Mã số thuế (Tax code):</strong> <strong style="font-size: 14px; font-family: monospace; letter-spacing: 0.5px;">@(string.IsNullOrWhiteSpace(Model.BuyerTaxCode) ? "---" : Model.BuyerTaxCode)</strong></div>
                            <div><strong>Địa chỉ (Address):</strong> @(string.IsNullOrWhiteSpace(Model.BuyerAddress) ? "---" : Model.BuyerAddress)</div>
                            <div><strong>Hình thức thanh toán (Payment method):</strong> TM/CK &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <strong>Đồng tiền thanh toán:</strong> VND</div>
                        </div>

                        <!-- 6. Bảng chi tiết hàng hóa, dịch vụ chuẩn mẫu Cổng Thuế -->
                        <div style="overflow-x: auto; width: 100%; margin-bottom: 0;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 13px; border: 1px solid #000000;">
                                <thead>
                                    <tr style="background: #f8fafc; text-align: center; font-weight: bold; color: #000000;">
                                        <th style="width: 40px; border: 1px solid #000000; padding: 6px 4px;">STT</th>
                                        <th style="border: 1px solid #000000; padding: 6px 8px;">Tên hàng hóa, dịch vụ</th>
                                        <th style="width: 65px; border: 1px solid #000000; padding: 6px 4px;">ĐVT</th>
                                        <th style="width: 75px; border: 1px solid #000000; padding: 6px 4px;">Số lượng</th>
                                        <th style="width: 105px; border: 1px solid #000000; padding: 6px 6px;">Đơn giá</th>
                                        <th style="width: 115px; border: 1px solid #000000; padding: 6px 6px;">Thành tiền</th>
                                        <th style="width: 70px; border: 1px solid #000000; padding: 6px 4px;">Thuế suất</th>
                                        <th style="width: 105px; border: 1px solid #000000; padding: 6px 6px;">Tiền thuế</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Details.Any())
                                    {
                                        foreach (var d in Model.Details.OrderBy(x => x.LineNumber))
                                        {
                                            <tr>
                                                <td style="text-align: center; border: 1px solid #000000; padding: 6px 4px;">@d.LineNumber</td>
                                                <td style="border: 1px solid #000000; padding: 6px 8px;">
                                                    <div>@d.ItemName</div>
                                                    @if (!string.IsNullOrEmpty(d.ItemCode))
                                                    {
                                                        <div style="font-size: 11px; color: #475569; font-family: monospace;">Mã: @d.ItemCode</div>
                                                    }
                                                </td>
                                                <td style="text-align: center; border: 1px solid #000000; padding: 6px 4px;">@d.Unit</td>
                                                <td style="text-align: right; border: 1px solid #000000; padding: 6px 6px;">@d.Quantity.ToString("N0")</td>
                                                <td style="text-align: right; border: 1px solid #000000; padding: 6px 6px;">@d.UnitPrice.ToString("N0") đ</td>
                                                <td style="text-align: right; border: 1px solid #000000; padding: 6px 6px; font-weight: bold;">@d.AmountBeforeTax.ToString("N0") đ</td>
                                                <td style="text-align: center; border: 1px solid #000000; padding: 6px 4px;">@(d.TaxRate == -1 ? "KCT" : $"{d.TaxRate}%")</td>
                                                <td style="text-align: right; border: 1px solid #000000; padding: 6px 6px;">@d.TaxAmount.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td style="text-align: center; border: 1px solid #000000; padding: 6px 4px;">1</td>
                                            <td style="border: 1px solid #000000; padding: 6px 8px;">Hàng hóa, dịch vụ theo hóa đơn gốc</td>
                                            <td style="text-align: center; border: 1px solid #000000; padding: 6px 4px;">Lô/Gói</td>
                                            <td style="text-align: right; border: 1px solid #000000; padding: 6px 6px;">1</td>
                                            <td style="text-align: right; border: 1px solid #000000; padding: 6px 6px;">@Model.AmountBeforeTax.ToString("N0") đ</td>
                                            <td style="text-align: right; border: 1px solid #000000; padding: 6px 6px; font-weight: bold;">@Model.AmountBeforeTax.ToString("N0") đ</td>
                                            <td style="text-align: center; border: 1px solid #000000; padding: 6px 4px;">10%</td>
                                            <td style="text-align: right; border: 1px solid #000000; padding: 6px 6px;">@Model.TaxAmount.ToString("N0") đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- 7. Khung tổng cộng tiền thanh toán chuẩn Cổng Thuế -->
                        <div style="border: 1px solid #000000; border-top: none; padding: 8px 12px; font-size: 13.5px;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="text-align: right; padding: 4px 8px;"><strong>Cộng tiền hàng (chưa có thuế GTGT):</strong></td>
                                    <td style="text-align: right; padding: 4px 8px; width: 140px; font-weight: bold;">@Model.AmountBeforeTax.ToString("N0") VND</td>
                                </tr>
                                <tr>
                                    <td style="text-align: right; padding: 4px 8px;"><strong>Tiền thuế GTGT:</strong></td>
                                    <td style="text-align: right; padding: 4px 8px; font-weight: bold;">@Model.TaxAmount.ToString("N0") VND</td>
                                </tr>
                                <tr style="border-top: 1px dashed #64748b;">
                                    <td style="text-align: right; padding: 6px 8px; font-size: 14.5px;"><strong>Tổng cộng tiền thanh toán:</strong></td>
                                    <td style="text-align: right; padding: 6px 8px; font-weight: bold; font-size: 16px; color: #b91c1c;">@Model.TotalAmount.ToString("N0") VND</td>
                                </tr>
                            </table>
                            <div style="margin-top: 6px; font-style: italic; border-top: 1px dashed #cbd5e1; padding-top: 6px;">
                                <strong>Số tiền viết bằng chữ:</strong> @NumberToVietnameseWords(Model.TotalAmount)
                            </div>
                        </div>

                        <!-- 8. Chữ ký điện tử Người mua & Người bán -->
                        <div style="display: flex; justify-content: space-between; margin-top: 25px; padding: 0 40px; text-align: center; font-size: 13px;">
                            <div style="width: 45%;">
                                <div style="font-weight: bold;">NGƯỜI MUA HÀNG</div>
                                <div style="font-style: italic; font-size: 11.5px;">(Ký, ghi rõ họ tên)</div>
                            </div>
                            <div style="width: 45%;">
                                <div style="font-weight: bold;">NGƯỜI BÁN HÀNG</div>
                                <div style="font-style: italic; font-size: 11.5px;">(Chữ ký điện tử, chữ ký số)</div>
                                <div style="margin-top: 8px; border: 1.5px solid #16a34a; background: #f0fdf4; color: #15803d; padding: 6px 12px; border-radius: 4px; font-size: 11.5px; font-weight: bold; display: inline-block;">
                                    ✓ ĐÃ KÝ ĐIỆN TỬ HỢP LỆ<br />
                                    <span style="font-size: 12px; text-transform: uppercase;">@Model.SellerName</span><br />
                                    <span style="font-size: 10.5px; font-weight: normal; color: #475569;">Ngày ký: @Model.IssueDate.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <!-- 9. Footer Cổng Thuế -->
                        <div style="margin-top: 25px; border-top: 1px solid #94a3b8; padding-top: 6px; font-size: 11px; color: #475569; display: flex; justify-content: space-between;">
                            <div>Tra cứu hóa đơn tại Cổng thông tin HĐĐT - Tổng cục Thuế: <strong>https://hoadondientu.gdt.gov.vn</strong></div>
                            <div>Mã tra cứu: <strong>@symbolWithMau-@Model.InvoiceNumber</strong></div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: XML Gốc -->
        <div class="tab-pane fade" id="xml-content" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-muted">Dữ liệu XML gốc đối soát pháp lý với Cơ quan Thuế (Nghị định 123/2020/NĐ-CP)</span>
                <div class="d-flex gap-1">
                    <a href="/Invoice/DownloadRawXml/@Model.Id" class="btn btn-sm btn-outline-success" download title="Tải file XML gốc về máy tính">
                        <i class="bi bi-download me-1"></i> Tải XML gốc (.xml)
                    </a>
                    <a href="/Invoice/ViewRawXml/@Model.Id" target="_blank" class="btn btn-sm btn-outline-secondary" title="Xem nội dung XML trên tab mới">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Mở toàn trang
                    </a>
                </div>
            </div>
            <pre class="bg-dark text-light p-3 rounded" style="max-height: 480px; overflow: auto; font-size: 0.775rem;"><code><iframe src="/Invoice/ViewRawXml/@Model.Id" style="width: 100%; height: 440px; border: none; background: white;"></iframe></code></pre>
        </div>

        <!-- Tab 3: Đối soát kế toán -->
        <div class="tab-pane fade" id="audit-content" role="tabpanel">
            <div class="card p-3 border-0 bg-light">
                <h6 class="fw-bold text-dark"><i class="bi bi-journal-check me-2"></i>Thông tin quản trị kế toán</h6>
                <ul class="list-group list-group-flush bg-transparent">
                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                        <span>Trạng thái vào sổ:</span>
                        <strong>@(Model.IsReconciled ? $"Đã vào sổ ({Model.ReconciledRefNo})" : "Chưa vào sổ kế toán")</strong>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                        <span>Thời điểm nhập hệ thống:</span>
                        <span>@Model.ImportedAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                        <span>Nhà cung cấp giải pháp HĐĐT:</span>
                        <span class="badge bg-secondary">@Model.SourceProvider</span>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                        <span>Tệp lưu trữ XML gốc:</span>
                        <span class="font-monospace small text-truncate" style="max-width: 400px;">@(Model.RawXmlPath ?? "Lưu trữ DB")</span>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                        <span>Tệp lưu trữ PDF gốc:</span>
                        <span class="font-monospace small text-truncate" style="max-width: 400px;">@(string.IsNullOrEmpty(Model.RawPdfPath) ? "Chưa có file PDF gốc bên bán" : Model.RawPdfPath)</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    var currentInvoiceScale = 1.0;

    function applyScale() {
        var sheet = document.getElementById('invoicePaperSheet');
        var wrapper = document.getElementById('invoicePaperWrapper');
        if (!sheet) return;
        sheet.style.transform = 'scale(' + currentInvoiceScale + ')';
        if (wrapper) {
            if (currentInvoiceScale !== 1.0) {
                wrapper.style.height = (sheet.offsetHeight * currentInvoiceScale + 30) + 'px';
            } else {
                wrapper.style.height = 'auto';
            }
        }
        var lbl = document.getElementById('lblInvoiceZoom');
        if (lbl) {
            lbl.innerText = Math.round(currentInvoiceScale * 100) + '%';
        }
    }

    function adjustInvoiceZoom(delta) {
        currentInvoiceScale = Math.max(0.6, Math.min(1.4, Math.round((currentInvoiceScale + delta) * 10) / 10));
        applyScale();
    }

    function resetInvoiceZoom() {
        currentInvoiceScale = 1.0;
        applyScale();
    }

    // Luôn giữ nguyên kích thước ban đầu 100% chuẩn Cổng Thuế khi mở hóa đơn
    currentInvoiceScale = 1.0;
    applyScale();

    function uploadOriginalPdfModal(invoiceId, input) {
        if (!input.files || input.files.length === 0) return;
        var file = input.files[0];
        if (!file.name.toLowerCase().endsWith('.pdf')) {
            alert('Vui lòng chỉ chọn file định dạng .pdf');
            return;
        }

        var formData = new FormData();
        formData.append('pdfFile', file);

        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        var token = tokenInput ? tokenInput.value : '';

        var btn = input.closest('label');
        if (btn) btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang tải...';

        fetch('/Invoice/UploadOriginalPdf/' + invoiceId, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                if (typeof openInvoiceModal === 'function') {
                    openInvoiceModal(invoiceId);
                } else {
                    location.reload();
                }
            } else {
                alert(data.message || 'Lỗi khi tải file PDF lên.');
                if (btn) btn.innerHTML = '<i class="bi bi-paperclip me-1"></i> Đính kèm PDF gốc<input type="file" accept=".pdf" class="d-none" onchange="uploadOriginalPdfModal(' + invoiceId + ', this)">';
            }
        })
        .catch(function(err) {
            alert('Lỗi kết nối khi tải file.');
            if (btn) btn.innerHTML = '<i class="bi bi-paperclip me-1"></i> Đính kèm PDF gốc<input type="file" accept=".pdf" class="d-none" onchange="uploadOriginalPdfModal(' + invoiceId + ', this)">';
        });
    }
</script>
