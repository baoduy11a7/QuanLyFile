@model InvoiceManager.Models.Entities.Invoice

@{
    var validFiles = Model.Files?.Where(f => f.Status == "Valid"
        && !f.Source.StartsWith("Mock", StringComparison.OrdinalIgnoreCase)
        && !f.OriginalFileName.StartsWith("Mock_", StringComparison.OrdinalIgnoreCase)).ToList()
        ?? new List<InvoiceManager.Models.Entities.InvoiceFile>();

    var pdfOriginalFile = validFiles.FirstOrDefault(f => string.Equals(f.FileExtension, ".pdf", StringComparison.OrdinalIgnoreCase));
    bool hasOriginalPdf = pdfOriginalFile != null && System.IO.File.Exists(pdfOriginalFile.FilePath);
    if (!hasOriginalPdf && !string.IsNullOrEmpty(Model.RawPdfPath)
        && !Model.RawPdfPath.Contains("Mock_", StringComparison.OrdinalIgnoreCase)
        && System.IO.File.Exists(Model.RawPdfPath))
    {
        hasOriginalPdf = true;
    }
}

<div id="originalPdfViewerContainer" class="w-100 h-100 overflow-hidden" style="background: #525659;">
    @if (hasOriginalPdf)
    {
        <iframe src="/api/invoices/@Model.Id/original-pdf" class="w-100 h-100 border-0 d-block" style="background: #525659; overflow: hidden;" title="Bản thể hiện PDF gốc @Model.InvoiceSymbol - @Model.InvoiceNumber"></iframe>
    }
    else
    {
        <div class="d-flex flex-column justify-content-center align-items-center text-white h-100">
            <div class="spinner-border text-light mb-3" role="status"></div>
            <div class="fw-semibold">Đang tải PDF hóa đơn gốc từ Tổng cục Thuế (@Model.InvoiceSymbol - @Model.InvoiceNumber)...</div>
        </div>
    }
</div>

<script>
    function escapeHtmlText(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function viewOriginalPdf(invoiceId) {
        var container = document.getElementById('originalPdfViewerContainer');
        if (container) {
            container.innerHTML =
                '<div class="d-flex flex-column justify-content-center align-items-center text-white h-100">' +
                    '<div class="spinner-border text-light mb-3" role="status"></div>' +
                    '<div class="fw-semibold">Đang tải PDF hóa đơn gốc từ Tổng cục Thuế...</div>' +
                '</div>';
        }

        fetch('/api/invoices/' + invoiceId + '/original-pdf', {
            method: 'GET',
            headers: {
                'Accept': 'application/pdf, application/json'
            }
        })
        .then(function(res) {
            var contentType = (res.headers.get('content-type') || '').toLowerCase();
            if (res.ok && contentType.indexOf('application/pdf') !== -1) {
                return res.blob().then(function(blob) {
                    var blobUrl = URL.createObjectURL(blob);
                    if (container) {
                        container.innerHTML =
                            '<iframe src="' + blobUrl + '" class="w-100 h-100 border-0 d-block" style="background: #525659; overflow: hidden;" title="Bản thể hiện PDF gốc"></iframe>';
                    }
                });
            }

            return res.text().then(function(text) {
                var errObj = null;
                try { errObj = JSON.parse(text); } catch (e) { }
                var msg = (errObj && errObj.message) ? errObj.message : (text || ('Lỗi HTTP ' + res.status + ' khi gọi Tổng cục Thuế.'));
                var code = (errObj && errObj.errorCode) ? errObj.errorCode : ('HTTP_' + res.status);

                if (container) {
                    container.innerHTML =
                        '<div class="d-flex justify-content-center align-items-center p-4 h-100" style="background: #f8fafc;">' +
                            '<div class="alert alert-danger text-start shadow-sm mb-0" style="max-width: 680px;">' +
                                '<div class="d-flex align-items-center mb-2">' +
                                    '<i class="bi bi-exclamation-octagon-fill fs-4 me-2 text-danger"></i>' +
                                    '<strong class="fs-6">Không thể lấy tệp PDF gốc từ Tổng cục Thuế (' + escapeHtmlText(code) + ')</strong>' +
                                '</div>' +
                                '<div class="small text-dark mb-3">' + escapeHtmlText(msg) + '</div>' +
                                '<button type="button" class="btn btn-sm btn-danger" onclick="viewOriginalPdf(' + invoiceId + ')">' +
                                    '<i class="bi bi-arrow-clockwise me-1"></i> Thử lại' +
                                '</button>' +
                            '</div>' +
                        '</div>';
                }
            });
        })
        .catch(function(err) {
            if (container) {
                container.innerHTML =
                    '<div class="d-flex justify-content-center align-items-center p-4 h-100" style="background: #f8fafc;">' +
                        '<div class="alert alert-danger mb-0" style="max-width: 650px;">' +
                            '<strong>Lỗi kết nối khi gọi API lấy PDF gốc:</strong> ' + escapeHtmlText(err.message || err) +
                        '</div>' +
                    '</div>';
            }
        });
    }

    function downloadOriginalPdf(invoiceId, symbol, number) {
        fetch('/api/invoices/' + invoiceId + '/original-pdf/download', {
            method: 'GET',
            headers: {
                'Accept': 'application/pdf, application/json'
            }
        })
        .then(function(res) {
            var contentType = (res.headers.get('content-type') || '').toLowerCase();
            if (res.ok && contentType.indexOf('application/pdf') !== -1) {
                var disposition = res.headers.get('content-disposition') || '';
                var fileName = (symbol && number) ? ('HD_' + symbol + '_' + number + '.pdf') : ('HoaDon_' + invoiceId + '.pdf');
                var match = disposition.match(/filename\*?=(?:UTF-8'')?["']?([^;"'\r\n]+)/i);
                if (match && match[1]) {
                    try { fileName = decodeURIComponent(match[1]); } catch (e) { fileName = match[1]; }
                }

                return res.blob().then(function(blob) {
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    setTimeout(function() { URL.revokeObjectURL(url); }, 5000);
                });
            }

            return res.text().then(function(text) {
                var errObj = null;
                try { errObj = JSON.parse(text); } catch (e) { }
                var msg = (errObj && errObj.message) ? errObj.message : (text || ('Lỗi HTTP ' + res.status + ' khi tải PDF gốc.'));
                alert('Không thể tải PDF gốc: ' + msg);
            });
        })
        .catch(function(err) {
            alert('Lỗi kết nối khi tải PDF gốc: ' + (err.message || err));
        });
    }

    @if (!hasOriginalPdf)
    {
        <text>
        setTimeout(function() {
            viewOriginalPdf(@Model.Id);
        }, 30);
        </text>
    }
</script>
