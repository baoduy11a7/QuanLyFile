@model InvoiceManager.Models.Entities.Invoice

@functions {
    public static string NumberToVietnameseWords(decimal number)
    {
        if (number == 0) return "Không đồng";
        long n = (long)Math.Round(number);
        if (n == 0) return "Không đồng";

        string[] units = { "", "nghìn", "triệu", "tỷ", "nghìn tỷ", "triệu tỷ" };
        string[] digits = { "không", "một", "hai", "ba", "bốn", "năm", "sáu", "bảy", "tám", "chín" };

        string ReadThreeDigits(int num, bool isFirstGroup)
        {
            int h = num / 100;
            int t = (num % 100) / 10;
            int u = num % 10;

            if (num == 0) return "";
            var sb = new System.Text.StringBuilder();

            if (!isFirstGroup || h > 0)
            {
                sb.Append(digits[h]).Append(" trăm ");
            }

            if (t > 1)
            {
                sb.Append(digits[t]).Append(" mươi ");
                if (u == 1) sb.Append("mốt ");
                else if (u == 5) sb.Append("lăm ");
                else if (u > 0) sb.Append(digits[u]).Append(" ");
            }
            else if (t == 1)
            {
                sb.Append("mười ");
                if (u == 5) sb.Append("lăm ");
                else if (u > 0) sb.Append(digits[u]).Append(" ");
            }
            else if (t == 0 && u > 0)
            {
                if (!isFirstGroup || h > 0) sb.Append("linh ");
                sb.Append(digits[u]).Append(" ");
            }

            return sb.ToString().Trim();
        }

        var groups = new System.Collections.Generic.List<int>();
        long temp = n;
        while (temp > 0)
        {
            groups.Add((int)(temp % 1000));
            temp /= 1000;
        }

        var result = new System.Text.StringBuilder();
        for (int i = groups.Count - 1; i >= 0; i--)
        {
            int grp = groups[i];
            if (grp > 0)
            {
                string grpStr = ReadThreeDigits(grp, i == groups.Count - 1);
                result.Append(grpStr).Append(" ").Append(units[i]).Append(" ");
            }
        }

        string res = result.ToString().Trim();
        if (string.IsNullOrEmpty(res)) return "Không đồng";

        res = char.ToUpper(res[0]) + res.Substring(1).Trim() + " đồng chẵn.";
        return res;
    }
}

<div class="px-3 pt-2 pb-3">
    <!-- Nav tabs & Toolbar xem biểu mẫu hóa đơn chuẩn Cổng Thuế -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 pb-2 border-bottom gap-2">
        <ul class="nav nav-tabs border-0 m-0" id="invoiceDetailTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold py-1 px-3" id="preview-tab" data-bs-toggle="tab" data-bs-target="#preview-content" type="button" role="tab">
                    <i class="bi bi-file-earmark-text text-primary me-1"></i> Biểu mẫu Hóa đơn gốc (Cổng Thuế)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-1 px-3" id="xml-tab" data-bs-toggle="tab" data-bs-target="#xml-content" type="button" role="tab">
                    <i class="bi bi-file-earmark-code text-success me-1"></i> Dữ liệu XML gốc
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-1 px-3" id="audit-tab" data-bs-toggle="tab" data-bs-target="#audit-content" type="button" role="tab">
                    <i class="bi bi-shield-check text-info me-1"></i> Chứng từ & Đối soát
                </button>
            </li>
        </ul>

        <!-- Bộ công cụ hiển thị chuẩn kích thước ban đầu Cổng Thuế -->
        <div class="d-flex align-items-center gap-1 ms-auto" id="invoiceViewControls">
            <span class="small text-muted me-1 d-none d-md-inline" style="font-size: 0.8rem;">Kích thước:</span>
            <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2" onclick="adjustInvoiceZoom(-0.1)" title="Thu nhỏ">
                <i class="bi bi-zoom-out"></i>
            </button>
            <button type="button" class="btn btn-light btn-sm border py-1 px-2 fw-semibold font-monospace" id="lblInvoiceZoom" onclick="resetInvoiceZoom()" title="Kích thước ban đầu 100% Cổng Thuế" style="font-size: 0.8rem;">
                100% (Gốc)
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2" onclick="adjustInvoiceZoom(0.1)" title="Phóng to">
                <i class="bi bi-zoom-in"></i>
            </button>
            <a href="/Invoice/ViewHtml/@Model.Id" target="_blank" class="btn btn-outline-primary btn-sm py-1 px-2 fw-semibold ms-1" title="Mở trang in chuẩn A4 trong tab mới">
                <i class="bi bi-box-arrow-up-right me-1"></i> Xem toàn trang
            </a>
        </div>
    </div>

    <!-- Tab contents -->
    <div class="tab-content" id="invoiceDetailTabContent">
        <!-- Tab 1: Biểu mẫu hóa đơn điện tử chuẩn A4 theo Cổng Thuế -->
        <div class="tab-pane fade show active" id="preview-content" role="tabpanel">
            <div id="invoiceViewerContainer" style="background: #e2e8f0; padding: 12px 6px; overflow-y: auto; overflow-x: auto; -webkit-overflow-scrolling: touch; max-height: calc(88vh - 120px); border-radius: 8px;">
                <div id="invoicePaperWrapper" style="display: block; width: 100%; text-align: center;">
                    <!-- Khung viền ngoài chuẩn Hóa đơn điện tử Cổng Thuế -->
                    <div id="invoicePaperSheet" style="display: inline-block; text-align: left; width: 100%; max-width: 860px; background: #ffffff; border: 2px solid #1e3a8a; padding: 4px; box-shadow: 0 4px 25px rgba(0,0,0,0.15); box-sizing: border-box; font-family: 'Segoe UI', Arial, sans-serif; color: #1e293b; line-height: 1.5; transform-origin: top center; transition: transform 0.15s ease; height: auto !important;">
                        <!-- Khung viền trong (Inner Border) bao bọc toàn bộ nội dung từ tiêu đề đến chữ ký số -->
                        <div style="border: 1px solid #1e3a8a; padding: clamp(14px, 3.5vw, 32px) clamp(12px, 4vw, 36px); box-sizing: border-box; background: #ffffff; height: auto !important;">
                            
                            <!-- 1. Header Hóa đơn chuẩn Tổng cục Thuế -->
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
                                <div style="width: 25%;">
                                    <!-- Logo / Phân loại CQT -->
                                    <div class="badge bg-primary-subtle text-primary border border-primary-subtle p-2 text-start" style="font-size: 0.75rem; line-height: 1.3;">
                                        <div class="fw-bold"><i class="bi bi-shield-check"></i> @(Model.HasTaxCode ? "HĐ ĐIỆN TỬ CÓ MÃ" : "HĐ ĐIỆN TỬ KHÔNG MÃ")</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Cơ quan Thuế xác thực</div>
                                    </div>
                                </div>
                                <div style="width: 50%; text-align: center;">
                                    <h3 style="margin: 0; color: #1e3a8a; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; font-size: 22px;">
                                        @(Model.InvoiceSymbol.StartsWith("2") ? "HÓA ĐƠN BÁN HÀNG" : "HÓA ĐƠN GIÁ TRỊ GIA TĂNG")
                                    </h3>
                                    <div style="font-size: 13px; color: #475569; margin-top: 4px; font-style: italic;">
                                        (Bản thể hiện của hóa đơn điện tử theo Nghị định 123/2020/NĐ-CP & Thông tư 78/2021/TT-BTC)
                                    </div>
                                    <div style="font-size: 14px; margin-top: 6px; font-weight: 600;">
                                        Ngày <strong>@Model.IssueDate.Day.ToString("00")</strong> tháng <strong>@Model.IssueDate.Month.ToString("00")</strong> năm <strong>@Model.IssueDate.Year</strong>
                                    </div>
                                </div>
                                <div style="width: 25%; text-align: right; font-size: 13.5px;">
                                    <div>Ký hiệu (Serial): <strong class="text-danger font-monospace">@Model.InvoiceSymbol</strong></div>
                                    <div>Số (No.): <strong class="text-danger font-monospace" style="font-size: 18px;">@Model.InvoiceNumber</strong></div>
                                    <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                                        Mã CQT: <span class="font-monospace text-primary fw-bold">@(string.IsNullOrEmpty(Model.TaxAuthorityCode) ? "Không áp dụng" : Model.TaxAuthorityCode)</span>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Thông tin Người Bán (Đơn vị bán hàng) -->
                            <div style="border-top: 2px solid #1e3a8a; padding-top: 12px; margin-bottom: 12px; font-size: 14px;">
                                <div style="font-size: 15px; font-weight: 800; color: #1e3a8a; text-transform: uppercase; margin-bottom: 4px;">
                                    @Model.SellerName
                                </div>
                                <div style="display: flex; gap: 20px; margin-bottom: 3px;">
                                    <div>Mã số thuế (Tax code): <strong class="font-monospace" style="letter-spacing: 1.5px; font-size: 15px; color: #b91c1c;">@Model.SellerTaxCode</strong></div>
                                </div>
                                <div style="color: #334155;">
                                    Địa chỉ (Address): @Model.SellerAddress
                                </div>
                            </div>

                            <!-- 3. Thông tin Người Mua (Đơn vị mua hàng) -->
                            <div style="border-top: 1px dashed #cbd5e1; padding-top: 10px; margin-bottom: 14px; font-size: 14px;">
                                <div style="margin-bottom: 3px;">
                                    Tên đơn vị mua hàng (Buyer): <strong>@(string.IsNullOrWhiteSpace(Model.BuyerName) ? "Khách hàng không lấy hóa đơn" : Model.BuyerName)</strong>
                                </div>
                                <div style="display: flex; gap: 20px; margin-bottom: 3px;">
                                    <div>Mã số thuế (Tax code): <strong class="font-monospace" style="letter-spacing: 1px; color: #b91c1c;">@(string.IsNullOrWhiteSpace(Model.BuyerTaxCode) ? "Không có" : Model.BuyerTaxCode)</strong></div>
                                    <div>Hình thức thanh toán: <strong>TM/CK</strong></div>
                                    <div>Đồng tiền thanh toán: <strong>VND</strong></div>
                                </div>
                                <div style="color: #334155;">
                                    Địa chỉ (Address): @(string.IsNullOrWhiteSpace(Model.BuyerAddress) ? "-" : Model.BuyerAddress)
                                </div>
                            </div>

                            <!-- 4. Bảng chi tiết hàng hóa, dịch vụ chuẩn mẫu Cổng Thuế -->
                            <div style="overflow-x: auto; width: 100%; margin-bottom: 10px;">
                                <table class="table table-bordered mb-0" style="min-width: 720px; width: 100%; border-collapse: collapse; font-size: 13.5px; border-color: #94a3b8;">
                                    <thead>
                                        <tr style="background: #f1f5f9; text-align: center; font-weight: 700; color: #1e293b;">
                                            <th style="width: 45px; padding: 8px 4px;">STT</th>
                                            <th style="padding: 8px 10px;">Tên hàng hóa, dịch vụ</th>
                                            <th style="width: 65px; padding: 8px 4px;">ĐVT</th>
                                            <th style="width: 75px; padding: 8px 4px;">Số lượng</th>
                                            <th style="width: 110px; padding: 8px 6px;">Đơn giá</th>
                                            <th style="width: 125px; padding: 8px 6px;">Thành tiền</th>
                                            <th style="width: 75px; padding: 8px 4px;">Thuế suất</th>
                                            <th style="width: 115px; padding: 8px 6px;">Tiền thuế</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Details.Any())
                                        {
                                            foreach (var d in Model.Details.OrderBy(x => x.LineNumber))
                                            {
                                                <tr>
                                                    <td style="text-align: center; padding: 7px 4px;">@d.LineNumber</td>
                                                    <td style="padding: 7px 10px;">
                                                        <div style="font-weight: 600;">@d.ItemName</div>
                                                        @if (!string.IsNullOrEmpty(d.ItemCode))
                                                        {
                                                            <div style="font-size: 11.5px; color: #64748b; font-family: monospace;">Mã: @d.ItemCode</div>
                                                        }
                                                    </td>
                                                    <td style="text-align: center; padding: 7px 4px;">@d.Unit</td>
                                                    <td style="text-align: right; font-family: monospace; padding: 7px 6px;">@d.Quantity.ToString("N0")</td>
                                                    <td style="text-align: right; font-family: monospace; padding: 7px 6px;">@d.UnitPrice.ToString("N0") đ</td>
                                                    <td style="text-align: right; font-family: monospace; font-weight: 600; padding: 7px 6px;">@d.AmountBeforeTax.ToString("N0") đ</td>
                                                    <td style="text-align: center; padding: 7px 4px;">@(d.TaxRate == -1 ? "KCT" : $"{d.TaxRate}%")</td>
                                                    <td style="text-align: right; font-family: monospace; color: #dc2626; padding: 7px 6px;">@d.TaxAmount.ToString("N0") đ</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td style="text-align: center; padding: 7px 4px;">1</td>
                                                <td style="padding: 7px 10px;">Chi tiết theo hóa đơn gốc</td>
                                                <td style="text-align: center; padding: 7px 4px;">Gói</td>
                                                <td style="text-align: right; font-family: monospace; padding: 7px 6px;">1</td>
                                                <td style="text-align: right; font-family: monospace; padding: 7px 6px;">@Model.AmountBeforeTax.ToString("N0") đ</td>
                                                <td style="text-align: right; font-family: monospace; font-weight: 600; padding: 7px 6px;">@Model.AmountBeforeTax.ToString("N0") đ</td>
                                                <td style="text-align: center; padding: 7px 4px;">10%</td>
                                                <td style="text-align: right; font-family: monospace; color: #dc2626; padding: 7px 6px;">@Model.TaxAmount.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- 5. Bảng tổng hợp tiền thanh toán & Số tiền bằng chữ -->
                            <div style="margin-top: 10px; margin-bottom: 25px;">
                                <table style="width: 100%; font-size: 14px; border-collapse: collapse;">
                                    <tr>
                                        <td style="text-align: right; padding: 4px 10px; width: 70%; color: #475569;">Cộng tiền hàng (chưa thuế):</td>
                                        <td style="text-align: right; padding: 4px 10px; font-family: monospace; font-weight: 700;">@Model.AmountBeforeTax.ToString("N0") VND</td>
                                    </tr>
                                    <tr>
                                        <td style="text-align: right; padding: 4px 10px; color: #475569;">Tổng tiền thuế GTGT:</td>
                                        <td style="text-align: right; padding: 4px 10px; font-family: monospace; font-weight: 700; color: #dc2626;">@Model.TaxAmount.ToString("N0") VND</td>
                                    </tr>
                                    <tr style="border-top: 1px solid #cbd5e1; border-bottom: 1px solid #cbd5e1; background: #f8fafc;">
                                        <td style="text-align: right; padding: 8px 10px; font-weight: 800; font-size: 15px; color: #1e3a8a;">Tổng cộng tiền thanh toán:</td>
                                        <td style="text-align: right; padding: 8px 10px; font-family: monospace; font-weight: 800; font-size: 17px; color: #1e3a8a;">@Model.TotalAmount.ToString("N0") VND</td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" style="padding: 8px 10px; font-size: 13.5px; color: #1e293b;">
                                            Số tiền viết bằng chữ: <span style="font-style: italic; font-weight: 600;">@NumberToVietnameseWords(Model.TotalAmount)</span>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- 6. Chữ ký số người bán & Người mua hàng -->
                            <div style="display: flex; justify-content: space-between; text-align: center; margin-top: 20px; padding: 0 30px;">
                                <div style="width: 45%;">
                                    <strong style="font-size: 14px;">NGƯỜI MUA HÀNG (Buyer)</strong>
                                    <div style="font-size: 12px; color: #64748b; margin-top: 2px;">(Ký, ghi rõ họ tên)</div>
                                </div>
                                <div style="width: 45%;">
                                    <strong style="font-size: 14px;">NGƯỜI BÁN HÀNG (Seller)</strong>
                                    <div style="font-size: 12px; color: #64748b; margin-top: 2px;">(Chữ ký điện tử / Chữ ký số)</div>
                                    
                                    <!-- Khung con dấu điện tử CQT chuẩn -->
                                    <div style="margin-top: 15px; border: 2px solid #16a34a; background: #f0fdf4; color: #15803d; padding: 10px 14px; border-radius: 6px; text-align: left; font-size: 12px; line-height: 1.4; display: inline-block; width: 100%; box-shadow: 0 2px 6px rgba(22, 163, 74, 0.1);">
                                        <div style="font-weight: 800; font-size: 13px; margin-bottom: 2px;">
                                            <i class="bi bi-patch-check-fill me-1"></i> ĐÃ KÝ ĐIỆN TỬ HỢP LỆ
                                        </div>
                                        <div><strong>Ký bởi:</strong> @Model.SellerName</div>
                                        <div><strong>Ngày ký:</strong> @Model.IssueDate.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                        <div style="font-size: 11px; color: #166534; margin-top: 2px;">Chứng thư số hợp lệ theo chuẩn Tổng cục Thuế</div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: XML Gốc -->
        <div class="tab-pane fade" id="xml-content" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-muted">Dữ liệu XML gốc đối soát pháp lý với Cơ quan Thuế</span>
                <a href="/Invoice/ViewRawXml/@Model.Id" target="_blank" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Mở XML toàn trang
                </a>
            </div>
            <pre class="bg-dark text-light p-3 rounded" style="max-height: 480px; overflow: auto; font-size: 0.775rem;"><code><iframe src="/Invoice/ViewRawXml/@Model.Id" style="width: 100%; height: 440px; border: none; background: white;"></iframe></code></pre>
        </div>

        <!-- Tab 3: Đối soát kế toán -->
        <div class="tab-pane fade" id="audit-content" role="tabpanel">
            <div class="card p-3 border-0 bg-light">
                <h6 class="fw-bold text-dark"><i class="bi bi-journal-check me-2"></i>Thông tin quản trị kế toán</h6>
                <ul class="list-group list-group-flush bg-transparent">
                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                        <span>Trạng thái vào sổ:</span>
                        <strong>@(Model.IsReconciled ? $"Đã vào sổ ({Model.ReconciledRefNo})" : "Chưa vào sổ kế toán")</strong>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                        <span>Thời điểm nhập hệ thống:</span>
                        <span>@Model.ImportedAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                        <span>Nhà cung cấp giải pháp HĐĐT:</span>
                        <span class="badge bg-secondary">@Model.SourceProvider</span>
                    </li>
                    <li class="list-group-item bg-transparent d-flex justify-content-between">
                        <span>Tệp lưu trữ XML gốc:</span>
                        <span class="font-monospace small text-truncate" style="max-width: 400px;">@(Model.RawXmlPath ?? "Lưu trữ DB")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    var currentInvoiceScale = 1.0;

    function applyScale() {
        var sheet = document.getElementById('invoicePaperSheet');
        var wrapper = document.getElementById('invoicePaperWrapper');
        if (!sheet) return;
        sheet.style.transform = 'scale(' + currentInvoiceScale + ')';
        if (wrapper) {
            if (currentInvoiceScale !== 1.0) {
                wrapper.style.height = (sheet.offsetHeight * currentInvoiceScale + 30) + 'px';
            } else {
                wrapper.style.height = 'auto';
            }
        }
        var lbl = document.getElementById('lblInvoiceZoom');
        if (lbl) {
            lbl.innerText = Math.round(currentInvoiceScale * 100) + '%';
        }
    }

    function adjustInvoiceZoom(delta) {
        currentInvoiceScale = Math.max(0.6, Math.min(1.4, Math.round((currentInvoiceScale + delta) * 10) / 10));
        applyScale();
    }

    function resetInvoiceZoom() {
        currentInvoiceScale = 1.0;
        applyScale();
    }

    // Luôn giữ nguyên kích thước ban đầu 100% chuẩn Cổng Thuế khi mở hóa đơn
    currentInvoiceScale = 1.0;
    applyScale();
</script>
