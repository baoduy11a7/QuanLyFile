        }



        function togglePasswordVisibility(inputId) {

            var input = document.getElementById(inputId);

            if (!input) return;

            input.type = input.type === 'password' ? 'text' : 'password';

        }



        function saveGovQuickConfig() {

            var pwd = $('#govConfigPassword').val();

            if (!pwd || !pwd.trim()) {

                alert('Vui lòng nhập mật khẩu Cổng Thuế.');

                return;

            }



            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({

                url: '/Import/SaveGovConfig',

                type: 'POST',

                contentType: 'application/json',

                headers: { "RequestVerificationToken": token },

                data: JSON.stringify({

                    Username: $('#govConfigTaxCode').val(),

                    Password: pwd.trim()

                }),

                success: function(res) {

                    if (res.success) {

                        var modalEl = document.getElementById('quickGovConfigModal');

                        if (modalEl) {

                            var modal = bootstrap.Modal.getInstance(modalEl);

                            if (modal) modal.hide();

                        }

                        alert('Đã lưu mật khẩu Cổng Thuế! Bắt đầu đồng bộ tự động ngay bây giờ.');

                        triggerAutoSync();

                    } else {

                        alert(res.message || 'Lỗi khi lưu mật khẩu.');

                    }

                },

                error: function() {

                    alert('Lỗi kết nối khi lưu cấu hình.');

                }

            });

        }



