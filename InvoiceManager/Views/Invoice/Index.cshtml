</div>



@section Scripts {

    <script>
        $(document).ready(function () {
            if (typeof flatpickr !== 'undefined') {
                var vnLocale = (typeof flatpickr.l10ns !== 'undefined' && flatpickr.l10ns.vn) ? flatpickr.l10ns.vn : {
                    weekdays: {
                        shorthand: ["CN", "T2", "T3", "T4", "T5", "T6", "T7"],
                        longhand: ["Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy"]
                    },
                    months: {
                        shorthand: ["Th1", "Th2", "Th3", "Th4", "Th5", "Th6", "Th7", "Th8", "Th9", "Th10", "Th11", "Th12"],
                        longhand: ["Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6", "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12"]
                    }
                };

                flatpickr('.fdi-filter-datepicker', {
                    dateFormat: "d/m/Y",
                    allowInput: true,
                    locale: vnLocale
                });
            }

            // Kích hoạt tính năng kéo chuột trực tiếp trên bảng (Drag to Scroll)
            setupTableDragToScroll();

            // Kích hoạt thanh trượt ngang linh động nổi khi cuộn trang ở giữa bảng (Dynamic Floating Scrollbar)
            setupDynamicFloatingScrollbar();
        });

        // Chuyển đổi giữa 2 tab: Tổng quát & Chi tiết hoá đơn
        function switchInvoiceViewTab(tabKey) {
            var btnTongQuat = document.getElementById('tabBtnTongQuat');
            var btnChiTiet = document.getElementById('tabBtnChiTiet');
            var tableTongQuat = document.getElementById('invoiceTable');
            var tableChiTiet = document.getElementById('invoiceDetailTable');

            if (tabKey === 'chi-tiet') {
                if (btnTongQuat) btnTongQuat.classList.remove('active');
                if (btnChiTiet) btnChiTiet.classList.add('active');
                if (tableTongQuat) tableTongQuat.classList.add('d-none');
                if (tableChiTiet) tableChiTiet.classList.remove('d-none');
            } else {
                if (btnChiTiet) btnChiTiet.classList.remove('active');
                if (btnTongQuat) btnTongQuat.classList.add('active');
                if (tableChiTiet) tableChiTiet.classList.add('d-none');
                if (tableTongQuat) tableTongQuat.classList.remove('d-none');
            }

            // Đồng bộ lại vị trí thanh cuộn sau khi chuyển tab
            setTimeout(function() {
                if (window.updateDynamicFloatingScrollbar) {
                    window.updateDynamicFloatingScrollbar();
                }
            }, 30);
            setTimeout(function() {
                if (window.updateDynamicFloatingScrollbar) {
                    window.updateDynamicFloatingScrollbar();
                }
            }, 150);
        }

        function getActiveTableWrapper() {
            var tableDetail = document.getElementById('invoiceDetailTable');
            if (tableDetail && !tableDetail.classList.contains('d-none')) {
                return tableDetail;
            }
            return document.getElementById('invoiceTable');
        }

        // Kích hoạt tính năng kéo chuột trực tiếp trên bảng để trượt ngang linh hoạt (Grab & Drag to Scroll)
        function setupTableDragToScroll() {
            ['invoiceTable', 'invoiceDetailTable'].forEach(function(tableId) {
                var tbl = document.getElementById(tableId);
                if (tbl) {
                    var isDown = false;
                    var startX = 0;
                    var scrollLeft = 0;
                    var hasDragged = false;

                    tbl.addEventListener('mousedown', function(e) {
                        if (e.button !== 0) return;
                        if (e.target.closest('a, button, input, select, textarea, .btn, .form-check-input, .badge')) return;
                        isDown = true;
                        hasDragged = false;
                        startX = e.pageX;
                        scrollLeft = tbl.scrollLeft;
                    });

                    window.addEventListener('mouseup', function() {
                        if (isDown) {
                            isDown = false;
                            tbl.style.cursor = '';
                            tbl.classList.remove('user-select-none');
                        }
                    });

                    window.addEventListener('mousemove', function(e) {
                        if (!isDown) return;
                        var dx = e.pageX - startX;
                        if (Math.abs(dx) > 3) {
                            hasDragged = true;
                            tbl.style.cursor = 'grabbing';
                            tbl.classList.add('user-select-none');
                            e.preventDefault();
                            tbl.scrollLeft = scrollLeft - (dx * 1.2);
                        }
                    });

                    // Hỗ trợ cuộn ngang nhanh bằng Shift + cuộn chuột khi rê chuột vào bảng
                    tbl.addEventListener('wheel', function(e) {
                        if (e.shiftKey) {
                            tbl.scrollLeft += e.deltaY;
                        }
                    }, { passive: true });
                }
            });
        }

        // Thiết lập thanh trượt ngang linh động nổi khi cuộn trang ở giữa bảng (Dynamic Floating Scrollbar)
        function setupDynamicFloatingScrollbar() {
            var bar = document.getElementById('fdiDynamicScrollbar');
            var track = document.getElementById('fdiDynamicScrollbarTrack');
            if (!bar || !track) return;

            var isSyncing = false;

            function updateMetrics() {
                var activeTable = getActiveTableWrapper();
                if (!activeTable) {
                    bar.style.display = 'none';
                    return;
                }

                var tableEl = activeTable.querySelector('table');
                var contentWidth = Math.max(
                    activeTable.scrollWidth || 0,
                    tableEl ? (tableEl.scrollWidth || 0) : 0,
                    tableEl ? (tableEl.offsetWidth || 0) : 0
                );
                var containerWidth = activeTable.clientWidth || 0;

                // Nếu bảng không bị tràn ngang thì ẩn thanh trượt
                if (contentWidth <= containerWidth + 10) {
                    bar.style.display = 'none';
                    return;
                }

                var rect = activeTable.getBoundingClientRect();
                var winH = window.innerHeight || document.documentElement.clientHeight;

                // Hiển thị thanh trượt nổi bất cứ khi nào bảng đang hiển thị trên màn hình và có tràn ngang
                var isTableInView = rect.top < (winH - 20) && rect.bottom > 70;

                if (isTableInView) {
                    var left = Math.max(0, rect.left);
                    var right = Math.min(window.innerWidth, rect.right);
                    var width = right - left;

                    if (width > 50) {
                        bar.style.left = left + 'px';
                        bar.style.width = width + 'px';
                        bar.style.display = 'block';

                        track.style.width = contentWidth + 'px';

                        if (!isSyncing && Math.abs(bar.scrollLeft - activeTable.scrollLeft) > 1) {
                            bar.scrollLeft = activeTable.scrollLeft;
                        }
                        return;
                    }
                }

                bar.style.display = 'none';
            }

            // Kéo thanh trượt nổi -> cuộn bảng tương ứng
            bar.addEventListener('scroll', function() {
                if (isSyncing) return;
                isSyncing = true;
                var activeTable = getActiveTableWrapper();
                if (activeTable) {
                    activeTable.scrollLeft = bar.scrollLeft;
                }
                requestAnimationFrame(function() {
                    isSyncing = false;
                });
            });

            // Khi bảng tự cuộn (kéo chuột trên bảng, phím mũi tên, shift+lăn chuột) -> đồng bộ sang thanh trượt nổi
            ['invoiceTable', 'invoiceDetailTable'].forEach(function(tableId) {
                var el = document.getElementById(tableId);
                if (el && !el._hasDynamicScrollSync) {
                    el._hasDynamicScrollSync = true;
                    el.addEventListener('scroll', function() {
                        if (isSyncing) return;
                        isSyncing = true;
                        bar.scrollLeft = el.scrollLeft;
                        requestAnimationFrame(function() {
                            isSyncing = false;
                        });
                    }, { passive: true });
                }
            });

            window.updateDynamicFloatingScrollbar = updateMetrics;

            window.addEventListener('scroll', updateMetrics, { passive: true });
            window.addEventListener('resize', updateMetrics);

            updateMetrics();
            setTimeout(updateMetrics, 100);
            setTimeout(updateMetrics, 300);
            setTimeout(updateMetrics, 800);
            setInterval(updateMetrics, 400);
        }

        function copyLookupCodeAndOpen(code, sellerMst, event) {
            if (code && code !== '-') {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(code).catch(function () {});
                } else {
                    var temp = document.createElement("textarea");
                    temp.value = code;
                    document.body.appendChild(temp);
                    temp.select();
                    document.execCommand("copy");
                    document.body.removeChild(temp);
                }
                var msg = 'Đã sao chép mã số bí mật: <strong>' + code + '</strong>';
                if (sellerMst) {
                    msg += '<br><span style="font-size:0.88em; opacity:0.95;">MST bên bán: <strong>' + sellerMst + '</strong></span>';
                }
                showFloatingToast(msg);
            }
        }

        function showFloatingToast(message) {
            var toast = document.createElement('div');
            toast.className = 'position-fixed bottom-0 end-0 p-3';
            toast.style.zIndex = '99999';
            toast.innerHTML = '<div class="toast align-items-center text-white bg-primary border-0 show shadow-lg" role="alert"><div class="d-flex"><div class="toast-body"><i class="bi bi-clipboard-check me-2"></i>' + message + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>';
            document.body.appendChild(toast);
            setTimeout(function() {
                if (toast.parentNode) toast.parentNode.removeChild(toast);
            }, 3500);
        }

        $('#selectAll').on('change', function() {

            $('.row-select').prop('checked', $(this).is(':checked'));

            updateSelectedCount();

        });



        $(document).on('change', '.row-select', function() {

            updateSelectedCount();

            if (!$(this).is(':checked')) {

                $('#selectAll').prop('checked', false);

            } else if ($('.row-select:checked').length === $('.row-select').length) {

                $('#selectAll').prop('checked', true);

            }

        });



        function updateSelectedCount() {

            var count = $('.row-select:checked').length;

            $('#selectedCount').text(count);

            if (count > 0) {

                $('#btnDeleteSelected').removeClass('d-none');

            } else {

                $('#btnDeleteSelected').addClass('d-none');

            }

        }



        function filterRiskSuppliers() {

            $('#selectValidationResult').val('Warning');

            $('#inputPage').val(1);

            $('#filterForm').submit();

        }



        function switchInvoiceType(type) {

            $('#inputInvoiceType').val(type);

            $('#inputPage').val(1);

            $('#filterForm').submit();

        }



        function goToPage(page) {

            $('#inputPage').val(page);

            $('#filterForm').submit();

        }



        function triggerExport(actionName) {

            var params = $('#filterForm').serialize();

            window.location.href = '/Export/' + actionName + '?' + params;

        }



        function triggerBatchZip() {

            var selected = [];

            $('.row-select:checked').each(function() {

                selected.push($(this).val());

            });

            var container = $('#selectedIdsContainer');

            container.empty();

            if (selected.length > 0) {

                selected.forEach(function(id) {

                    container.append('<input type="hidden" name="selectedIds" value="' + id + '" />');

                });

            }

            $('#formBatchZip').submit();

        }



        function triggerBatchPdfZip() {

            var selected = [];

            $('.row-select:checked').each(function() {

                selected.push($(this).val());

            });

            var container = $('#selectedPdfIdsContainer');

            container.empty();

            if (selected.length > 0) {

                selected.forEach(function(id) {

                    container.append('<input type="hidden" name="selectedIds" value="' + id + '" />');

                });

            }

            $('#formBatchPdfZip').submit();

        }



        function openInvoiceModal(id) {

            $('#invoiceModal').modal('show');

            $('#invoiceModalBody').html('<div class="d-flex justify-content-center align-items-center h-100 py-5"><div class="spinner-border text-primary" role="status"></div></div>');



            $.get('/Invoice/Detail/' + id, function(html) {

                $('#invoiceModalBody').html(html);

                $('#invoiceModalFooterActions').html(

                    '<button type="button" class="btn btn-danger btn-sm" onclick="downloadOriginalPdf(' + id + ')"><i class="bi bi-file-earmark-pdf-fill me-1"></i> Tải PDF gốc</button> ' +

                    '<a href="/Invoice/DownloadRawXml/' + id + '" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="bi bi-filetype-xml me-1"></i> Tải XML gốc</a>'

                );

            }).fail(function() {

                $('#invoiceModalBody').html('<div class="alert alert-danger m-3">Không thể tải thông tin hóa đơn.</div>');

            });

        }



        function toggleInvoiceModalFullscreen() {

            var dialog = $('#invoiceModal .modal-dialog');

            var icon = $('#btnToggleInvoiceModalFullscreen i');

            if (dialog.hasClass('modal-fullscreen')) {

                dialog.removeClass('modal-fullscreen').addClass('modal-xl');

                icon.removeClass('bi-fullscreen-exit').addClass('bi-arrows-fullscreen');

            } else {

                dialog.removeClass('modal-xl').addClass('modal-fullscreen');

                icon.removeClass('bi-arrows-fullscreen').addClass('bi-fullscreen-exit');

            }

        }



        function deleteSingleInvoice(id, symbol, number) {

            if (!confirm('Bạn có chắc chắn muốn xóa hóa đơn ' + symbol + '-' + number + ' khỏi hệ thống?')) {

                return;

            }

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({

                url: '/Invoice/Delete',

                type: 'POST',

                data: { id: id, __RequestVerificationToken: token },

                success: function(res) {

                    if (res.success) {

                        location.reload();

                    } else {

                        alert(res.message || 'Lỗi khi xóa hóa đơn.');

                    }

                },

                error: function() {

                    alert('Lỗi hệ thống khi gửi yêu cầu xóa.');

                }

            });

        }



        function deleteSelectedInvoices() {

            var selectedIds = [];

            $('.row-select:checked').each(function() {

                selectedIds.push(parseInt($(this).val()));

            });

            if (selectedIds.length === 0) return;

            if (!confirm('Bạn có chắc chắn muốn xóa ' + selectedIds.length + ' hóa đơn đã chọn?')) return;



            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({

                url: '/Invoice/DeleteBatch',

                type: 'POST',

                contentType: 'application/json',

                headers: { "RequestVerificationToken": token },

                data: JSON.stringify(selectedIds),

                success: function(res) {

                    if (res.success) {

                        location.reload();

                    } else {

                        alert(res.message || 'Lỗi khi xóa hóa đơn hàng loạt.');

                    }

                }

            });

        }



        function openImportModal(tabButtonId) {

            var modalEl = document.getElementById('modalImportInvoice');

            if (!modalEl) return;

            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);

            modal.show();



            if (tabButtonId) {

                var btn = document.getElementById(tabButtonId);

                if (btn) {

                    var tab = bootstrap.Tab.getOrCreateInstance(btn);

                    tab.show();

                }

            }



            if (tabButtonId === 'tab-remote-btn') {

                setTimeout(function () {

                    if (typeof window.loadImportModalCaptcha === 'function') {

                        window.loadImportModalCaptcha();

                    }

                    if (typeof window.loadImportModalSavedConnection === 'function') {

                        window.loadImportModalSavedConnection();

                    }

                }, 80);

            }

        }



        // ==========================================

        // 1. TỰ ĐỘNG ĐỒNG BỘ & TẢI NHANH (KHÔNG CẦN NHẬP LẠI MẬT KHẨU / CAPTCHA)

        // ==========================================

        var autoSyncTimer = null;

        var currentAutoSyncJobId = null;



        function triggerAutoSync() {
            if (typeof window.openSyncInvoiceModal === 'function') {
                window.openSyncInvoiceModal();
            } else {
                var modalEl = document.getElementById('modalSyncInvoices');
                if (modalEl) {
                    var bsModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    bsModal.show();
                    if (typeof window.loadSyncHistory === 'function') window.loadSyncHistory();
                }
            }
        }

        function triggerAutoQuickDownload() {

            var token = $('input[name="__RequestVerificationToken"]').val();

            showAutoSyncProgress('Đang tải nhanh dữ liệu 30 ngày gần nhất...', 5, 'Kết nối Cổng Thuế và tự động lưu toàn bộ file gốc...');



            $.ajax({

                url: '/Import/AutoQuickDownload',

                type: 'POST',

                contentType: 'application/json',

                headers: { "RequestVerificationToken": token },

                data: JSON.stringify({

                    InvoiceType: '@filter.InvoiceType'

                }),

                success: function(res) {

                    if (res.needSetup || res.requireCaptcha) {

                        hideAutoSyncProgress();

                        openImportModalForCaptcha(res.message);

                        return;

                    }



                    if (res.success && res.jobId) {

                        currentAutoSyncJobId = res.jobId;

                        startAutoSyncPolling(res.jobId);

                    } else {

                        hideAutoSyncProgress();

                        alert(res.message || 'Không thể khởi chạy tải nhanh.');

                    }

                },

                error: function(xhr) {

                    hideAutoSyncProgress();

                    alert('Lỗi kết nối khi gửi yêu cầu tải nhanh.');

                }

            });

        }



        function triggerAutoMultiCompanySync() {

            if (!confirm('Hệ thống sẽ tự động đồng bộ hóa đơn ngầm cho tất cả các doanh nghiệp có thông tin kết nối Cổng Thuế của bạn. Tiếp tục?')) {

                return;

            }



            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({

                url: '/Import/AutoMultiCompanySync',

                type: 'POST',

                headers: { "RequestVerificationToken": token },

                success: function(res) {

                    alert(res.message || 'Đã gửi lệnh đồng bộ nhiều công ty.');

                },

                error: function() {

                    alert('Lỗi khi gửi yêu cầu đồng bộ nhiều công ty.');

                }

            });

        }



        function showAutoSyncProgress(title, percent, stage) {

            $('#autoSyncProgressBox').removeClass('d-none').addClass('d-flex');

            $('#autoSyncStatusTitle').text(title);

            $('#autoSyncPercent').text(percent + '%');

            $('#autoSyncProgressBar').css('width', percent + '%');

            $('#autoSyncStageDetail').text(stage);

        }



        function hideAutoSyncProgress() {

            if (autoSyncTimer) {

                clearInterval(autoSyncTimer);

                autoSyncTimer = null;

            }

            currentAutoSyncJobId = null;

            $('#autoSyncProgressBox').removeClass('d-flex').addClass('d-none');

        }



        function cancelAutoSync() {

            if (!currentAutoSyncJobId) {

                hideAutoSyncProgress();

                return;

            }



            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({

                url: '/Import/CancelRemoteJob',

                type: 'POST',

                contentType: 'application/json',

                headers: { "RequestVerificationToken": token },

                data: JSON.stringify({ JobId: currentAutoSyncJobId }),

                complete: function() {

                    hideAutoSyncProgress();

                    alert('Đã dừng tiến trình đồng bộ.');

                }

            });

        }



        function startAutoSyncPolling(jobId) {

            if (autoSyncTimer) clearInterval(autoSyncTimer);



            autoSyncTimer = setInterval(function() {

                $.ajax({

                    url: '/Import/RemoteStatus?jobId=' + encodeURIComponent(jobId),

                    type: 'GET',

                    success: function(res) {

                        if (!res || !res.success) return;



                        var pct = Math.max(5, Math.min(100, res.percent || 0));

                        var stage = res.stage || 'Đang xử lý dữ liệu...';

                        var summary = 'Đã tìm thấy: ' + (res.totalFound || 0) + ' HĐ | Đã lưu: ' + (res.successCount || 0) + ' HĐ | File gốc: ' + (res.filesDownloadedCount || 0);



                        showAutoSyncProgress('Đang tự động đồng bộ hóa đơn Cổng Thuế...', pct, stage + ' (' + summary + ')');



                        if (res.isFinished) {

                            clearInterval(autoSyncTimer);

                            autoSyncTimer = null;

                            if (res.status === 'Completed') {

                                $('#autoSyncStatusTitle').text('Đồng bộ hoàn tất thành công!');

                                $('#autoSyncPercent').text('100%');

                                $('#autoSyncProgressBar').css('width', '100%').removeClass('bg-primary').addClass('bg-success');

                                $('#autoSyncStageDetail').text('Hoàn thành: ' + summary + '. Đang tải lại dữ liệu...');

                                setTimeout(function() { location.reload(); }, 1200);

                            } else if (res.status === 'Failed') {

                                hideAutoSyncProgress();

                                if (res.errorMessage && (res.errorMessage.indexOf('Captcha') >= 0 || res.errorMessage.indexOf('hết hạn') >= 0 || res.errorMessage.indexOf('Tham số không') >= 0)) {

                                    openImportModalForCaptcha(res.errorMessage);

                                } else {

                                    alert('Lỗi đồng bộ: ' + (res.errorMessage || 'Không thể hoàn thành lấy dữ liệu từ Cổng thuế.'));

                                }

                            } else {

                                hideAutoSyncProgress();

                            }

                        }

                    },

                    error: function() {

                        // ignore network blips

                    }

                });

            }, 1500);

        }



        function openImportModalForCaptcha(msg) {

            hideAutoSyncProgress();

            var modalEl = document.getElementById('modalImportInvoice');

            if (modalEl) {

                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);

                var tabRemoteBtn = document.getElementById('tab-remote-btn');

                if (tabRemoteBtn) {

                    var tab = bootstrap.Tab.getOrCreateInstance(tabRemoteBtn);

                    tab.show();

                }

                modal.show();

                if (typeof loadCaptcha === 'function') loadCaptcha(true);

                if (typeof loadSavedConnection === 'function') loadSavedConnection(true);

                setTimeout(function() {

                    var capInput = document.getElementById('remoteCaptchaCode');

                    if (capInput) capInput.focus();

                }, 600);

            }

        }



