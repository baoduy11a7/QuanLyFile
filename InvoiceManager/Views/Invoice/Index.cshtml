        function formatVnd(val) {

            var num = Number(val) || 0;

            return num.toLocaleString('vi-VN') + ' đ';

        }



        function formatCurrencyInput(elem) {

            var raw = (elem.value || '').replace(/[^\d.-]/g, '');

            var num = parseFloat(raw) || 0;

            elem.value = num.toLocaleString('vi-VN');

        }



        function parseCurrencyInput(val) {

            if (!val) return 0;

            var clean = String(val).replace(/[^\d.-]/g, '');

            return parseFloat(clean) || 0;

        }



        function calculateDeclaration() {

            var periodType = $('input[name="taxPeriodType"]:checked').val() || 'Quarter';

            var quarter = parseInt($('#taxQuarter').val(), 10) || 4;

            var month = parseInt($('#taxMonth').val(), 10) || 10;

            var year = parseInt($('#taxYear').val(), 10) || 2026;

            var carriedForward = parseCurrencyInput($('#taxCarriedForward').val());

            var ct21 = $('#ct21_Checkbox').is(':checked');



            var token = $('input[name="__RequestVerificationToken"]').val();



            $('#taxIndicatorsBody td[id^="val_ct"]').html('<div class="spinner-border spinner-border-sm text-secondary" role="status"></div>');



            $.ajax({

                url: '/TaxDeclaration/Calculate',

                type: 'POST',

                contentType: 'application/json',

                headers: { "RequestVerificationToken": token },

                data: JSON.stringify({

                    PeriodType: periodType,

                    Quarter: quarter,

                    Month: month,

                    Year: year,

                    TaxCarriedForwardPreviousPeriod: carriedForward,

                    Indicator21_NoActivity: ct21

                }),

                success: function(res) {

                    if (!res || !res.success) {

                        alert(res?.message || 'Không thể tính toán tờ khai.');

                        return;

                    }



                    var d = res.data;

                    $('#taxDecCompanyName').text('Doanh nghiệp: ' + d.companyName + ' (MST: ' + d.taxCode + ')');

                    $('#taxDecPeriodLabel').text(d.periodDescription);



                    // Cập nhật các chỉ tiêu

                    $('#val_ct22').text(formatVnd(d.indicator22_TaxCarriedForwardPreviousPeriod));

                    $('#val_ct23').text(formatVnd(d.indicator23_PurchaseTotalAmountBeforeTax));

                    $('#val_ct24').text(formatVnd(d.indicator24_PurchaseTotalTaxAmount));

                    $('#val_ct24_sub').text(formatVnd(d.indicator24_PurchaseTotalTaxAmount));

                    $('#val_ct25').text(formatVnd(d.indicator25_DeductiblePurchaseTaxAmount));



                    $('#val_ct26').text(formatVnd(d.indicator26_RevenueNonTaxable));

                    $('#val_ct27').text(formatVnd(d.indicator27_RevenueTax0Percent));

                    $('#val_ct28').text(formatVnd(d.indicator28_RevenueTax5Percent));

                    $('#val_ct29').text(formatVnd(d.indicator29_TaxAmount5Percent));

                    $('#val_ct30').text(formatVnd(d.indicator30_RevenueTax8Percent));

                    $('#val_ct31').text(formatVnd(d.indicator31_TaxAmount8Percent));

                    $('#val_ct32').text(formatVnd(d.indicator32_RevenueTax10Percent));

                    $('#val_ct33').text(formatVnd(d.indicator33_TaxAmount10Percent));

                    $('#val_ct34').text(formatVnd(d.indicator34_TotalRevenue));

                    $('#val_ct35').text(formatVnd(d.indicator35_TotalOutputTax));



                    $('#val_ct36').text(formatVnd(d.indicator36_VatIncurredPeriod));

                    $('#val_ct40').text(formatVnd(d.indicator40_VatPayable));

                    $('#val_ct43').text(formatVnd(d.indicator43_VatDeductibleNextPeriod));



                    // Badges

                    $('#badgeCountMuaVao').text(d.purchaseInvoices ? d.purchaseInvoices.length : 0);

                    $('#badgeCountBanRa').text(d.soldInvoices ? d.soldInvoices.length : 0);

                    $('#badgeCount8Percent').text(d.tax8PercentReductionItems ? d.tax8PercentReductionItems.length : 0);



                    // Bảng kê mua vào

                    var mvHtml = '';

                    if (d.purchaseInvoices && d.purchaseInvoices.length > 0) {

                        for (var i = 0; i < d.purchaseInvoices.length; i++) {

                            var item = d.purchaseInvoices[i];

                            mvHtml += '<tr>' +

                                '<td class="text-center">' + (i + 1) + '</td>' +

                                '<td>' + (item.invoiceSymbol || '') + '</td>' +

                                '<td>' + (item.invoiceNumber || '') + '</td>' +

                                '<td class="text-center">' + (item.issueDate || '') + '</td>' +

                                '<td>' + (item.sellerName || '') + '</td>' +

                                '<td>' + (item.sellerTaxCode || '') + '</td>' +

                                '<td class="text-end fw-semibold">' + formatVnd(item.amountBeforeTax) + '</td>' +

                                '<td class="text-center">' + (item.taxRate || '') + '</td>' +

                                '<td class="text-end fw-semibold text-danger">' + formatVnd(item.taxAmount) + '</td>' +

                                '<td>' + (item.note || '') + '</td>' +

                            '</tr>';

                        }

                    } else {

                        mvHtml = '<tr><td colspan="10" class="text-center text-muted py-3">Không có hóa đơn mua vào trong kỳ này.</td></tr>';

                    }

                    $('#tblTaxMuaVaoBody').html(mvHtml);



                    // Bảng kê bán ra

                    var brHtml = '';

                    if (d.soldInvoices && d.soldInvoices.length > 0) {

                        for (var j = 0; j < d.soldInvoices.length; j++) {

                            var s = d.soldInvoices[j];

                            brHtml += '<tr>' +

                                '<td class="text-center">' + (j + 1) + '</td>' +

                                '<td>' + (s.invoiceSymbol || '') + '</td>' +

                                '<td>' + (s.invoiceNumber || '') + '</td>' +

                                '<td class="text-center">' + (s.issueDate || '') + '</td>' +

                                '<td>' + (s.buyerName || '') + '</td>' +

                                '<td>' + (s.buyerTaxCode || '') + '</td>' +

                                '<td class="text-end fw-semibold">' + formatVnd(s.amountBeforeTax) + '</td>' +

                                '<td class="text-center">' + (s.taxRate || '') + '</td>' +

                                '<td class="text-end fw-semibold text-primary">' + formatVnd(s.taxAmount) + '</td>' +

                                '<td>' + (s.note || '') + '</td>' +

                            '</tr>';

                        }

                    } else {

                        brHtml = '<tr><td colspan="10" class="text-center text-muted py-3">Không có hóa đơn bán ra trong kỳ này.</td></tr>';

                    }

                    $('#tblTaxBanRaBody').html(brHtml);



                    // Phụ lục giảm thuế 8%

                    var gHtml = '';

                    if (d.tax8PercentReductionItems && d.tax8PercentReductionItems.length > 0) {

                        for (var k = 0; k < d.tax8PercentReductionItems.length; k++) {

                            var g = d.tax8PercentReductionItems[k];

                            gHtml += '<tr>' +

                                '<td class="text-center">' + (k + 1) + '</td>' +

                                '<td>' + (g.itemName || '') + '</td>' +

                                '<td>' + (g.invoiceSymbol || '') + ' - ' + (g.invoiceNumber || '') + '</td>' +

                                '<td class="text-center">' + (g.issueDate || '') + '</td>' +

                                '<td class="text-end fw-semibold">' + formatVnd(g.amountBeforeTax) + '</td>' +

                                '<td class="text-center fw-bold text-danger">8%</td>' +

                                '<td class="text-end fw-semibold">' + formatVnd(g.taxAmount8Percent) + '</td>' +

                                '<td class="text-end fw-bold text-success">' + formatVnd(g.taxReducedAmount2Percent) + '</td>' +

                            '</tr>';

                        }

                    } else {

                        gHtml = '<tr><td colspan="8" class="text-center text-muted py-3">Không có mặt hàng chịu thuế 8% trong kỳ này.</td></tr>';

                    }

                    $('#tblTax8PercentBody').html(gHtml);

                },

                error: function() {

                    alert('Lỗi kết nối khi tính toán tờ khai thuế.');

                }

            });

        }



        function exportTaxDeclarationXml() {

            var periodType = $('input[name="taxPeriodType"]:checked').val() || 'Quarter';

            var quarter = parseInt($('#taxQuarter').val(), 10) || 4;

            var month = parseInt($('#taxMonth').val(), 10) || 10;

            var year = parseInt($('#taxYear').val(), 10) || 2026;

            var carriedForward = parseCurrencyInput($('#taxCarriedForward').val());

            var ct21 = $('#ct21_Checkbox').is(':checked');



            var url = '/TaxDeclaration/ExportXml?PeriodType=' + encodeURIComponent(periodType) +

                '&Quarter=' + quarter +

                '&Month=' + month +

                '&Year=' + year +

                '&TaxCarriedForwardPreviousPeriod=' + carriedForward +

                '&Indicator21_NoActivity=' + ct21;



            window.location.href = url;

        }



