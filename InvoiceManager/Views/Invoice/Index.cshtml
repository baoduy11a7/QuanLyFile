@model InvoiceManager.Models.ViewModels.InvoiceIndexViewModel

@{

    ViewData["Title"] = "Quản lý Hóa đơn & Kế toán";

    var filter = Model.Filter;

    var summary = Model.Summary;

    bool isBanRa = string.Equals(filter.InvoiceType, "BanRa", StringComparison.OrdinalIgnoreCase);

}



<style>

    .fdi-subheader {

        background: #ffffff;

        border: 1px solid #e2e8f0;

        border-radius: 8px;

        padding: 8px 16px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        flex-wrap: wrap;

        gap: 10px;

    }

    .fdi-subheader-tab {

        display: inline-flex;

        align-items: center;

        gap: 6px;

        color: #1d4ed8;

        font-weight: 600;

        font-size: 0.875rem;

        padding: 4px 10px;

        background: #eff6ff;

        border-radius: 6px;

    }

    .fdi-nav-bar {

        display: flex;

        align-items: center;

        justify-content: space-between;

        flex-wrap: wrap;

        gap: 12px;

        border-bottom: 1px solid #e2e8f0;

        padding: 0 4px;

    }

    .fdi-underline-tabs {

        display: flex;

        align-items: center;

        gap: 24px;

    }

    .fdi-tab-link {

        background: none;

        border: none;

        border-bottom: 2.5px solid transparent;

        padding: 10px 4px;

        font-size: 0.875rem;

        font-weight: 500;

        color: #64748b;

        cursor: pointer;

        text-decoration: none;

        transition: all 0.15s ease;

    }

    .fdi-tab-link:hover {

        color: #1d4ed8;

    }

    .fdi-tab-link.active {

        color: #1d4ed8;

        font-weight: 600;

        border-bottom-color: #2563eb;

    }

    .fdi-filter-card {

        background: #ffffff;

        border: 1px solid #e2e8f0;

        border-radius: 8px;

        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);

    }

    .fdi-filter-header {

        padding: 12px 18px;

        border-bottom: 1px solid #f1f5f9;

        display: flex;

        align-items: center;

        justify-content: space-between;

        cursor: pointer;

    }

    .fdi-filter-title {

        font-size: 0.95rem;

        font-weight: 600;

        color: #1e293b;

        display: flex;

        align-items: center;

        gap: 8px;

        margin: 0;

    }

    .fdi-form-row {

        display: flex;

        align-items: center;

        margin-bottom: 10px;

    }

    .fdi-form-label {

        width: 165px;

        flex-shrink: 0;

        font-size: 0.82rem;

        font-weight: 500;

        color: #334155;

        margin-bottom: 0;

    }

    .fdi-form-input {

        flex-grow: 1;

    }

    .fdi-form-input .form-control,

    .fdi-form-input .form-select {

        font-size: 0.82rem;

        border-color: #e2e8f0;

        padding: 5px 10px;

        border-radius: 6px;

    }

    .fdi-form-input .form-control:focus,

    .fdi-form-input .form-select:focus {

        border-color: #3b82f6;

        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.12);

    }

    .fdi-date-box {

        position: relative;

        flex: 1;

    }

    .fdi-date-box span.date-sub-label {

        position: absolute;

        top: -7px;

        left: 10px;

        background: #fff;

        padding: 0 4px;

        font-size: 0.68rem;

        color: #64748b;

        line-height: 1;

        z-index: 2;

    }

    .fdi-date-box .date-box-icon {

        position: absolute;

        right: 9px;

        top: 50%;

        transform: translateY(-50%);

        color: #64748b;

        pointer-events: none;

        font-size: 0.82rem;

        z-index: 2;

    }

    .fdi-filter-datepicker {

        padding-right: 28px !important;

        font-size: 0.85rem !important;

        cursor: pointer;

    }

    .fdi-table-card {

        background: #ffffff;

        border: 1px solid #e2e8f0;

        border-radius: 8px;

        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);

        overflow: visible;

    }

    .fdi-table-topbar {

        padding: 8px 16px;

        border-bottom: 1px solid #e2e8f0;

        display: flex;

        align-items: center;

        justify-content: space-between;

        flex-wrap: wrap;

        gap: 10px;

        background: #ffffff;

    }

    .fdi-summary-pills {

        display: flex;

        align-items: center;

        gap: 12px;

        flex-wrap: wrap;

        font-size: 0.8rem;

    }

    .fdi-summary-pill {

        background: #f8fafc;

        border: 1px solid #e2e8f0;

        border-radius: 6px;

        padding: 3px 10px;

        color: #475569;

    }

    .fdi-table th {

        background: #f8fafc !important;

        color: #334155 !important;

        font-size: 0.78rem !important;

        font-weight: 600 !important;

        border-bottom: 1px solid #e2e8f0 !important;

        padding: 10px 10px !important;

        vertical-align: middle;

    }

    .fdi-table td {

        font-size: 0.81rem;

        padding: 9px 10px;

        border-bottom: 1px solid #f1f5f9;

        color: #1e293b;

        vertical-align: middle;

    }

    .fdi-table tbody tr:hover {

        background-color: #f8fafc;

    }

    /* Thanh cuộn tự nhiên của bảng: ẩn đi để dùng thanh trượt nổi thống nhất */
    #invoiceTable,
    #invoiceDetailTable {
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
    }

    #invoiceTable::-webkit-scrollbar,
    #invoiceDetailTable::-webkit-scrollbar {
        display: none !important;
        height: 0px !important;
    }

    /* Thanh cuộn ngang linh động nổi ở đáy màn hình khi xem dữ liệu bảng (Floating Scrollbar) */
    #fdiDynamicScrollbar {
        position: fixed !important;
        bottom: 0 !important;
        height: 18px !important;
        background: #f1f5f9 !important;
        border-top: 2px solid #cbd5e1 !important;
        overflow-x: scroll !important;
        overflow-y: hidden !important;
        z-index: 1045 !important;
        display: none;
        box-shadow: 0 -4px 14px rgba(15, 23, 42, 0.2) !important;
    }

    #fdiDynamicScrollbar::-webkit-scrollbar {
        height: 16px !important;
    }

    #fdiDynamicScrollbar::-webkit-scrollbar-track {
        background: #f1f5f9 !important;
    }

    #fdiDynamicScrollbar::-webkit-scrollbar-thumb {
        background: #475569 !important;
        border-radius: 9999px !important;
        border: 2px solid #f1f5f9 !important;
    }

    #fdiDynamicScrollbar::-webkit-scrollbar-thumb:hover {
        background: #1e293b !important;
    }

    #fdiDynamicScrollbarTrack {
        height: 1px !important;
        min-height: 1px !important;
        line-height: 1px !important;
        font-size: 1px !important;
    }

</style>



<div class="d-flex flex-column gap-2">

    <!-- 1. Thanh Sub-header: Hóa đơn điện tử & Nút Đồng bộ / Tải nhanh -->

    <div class="fdi-subheader">

        <div class="d-flex align-items-center gap-2">

            <span class="fdi-subheader-tab">

                <i class="bi bi-file-earmark-text"></i> Hóa đơn điện tử

            </span>

        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">

            <button type="button" class="btn btn-primary btn-sm fw-semibold px-3" onclick="triggerAutoMultiCompanySync()" title="Đồng bộ tự động tất cả các công ty của bạn">

                <i class="bi bi-buildings me-1"></i> Đồng bộ nhiều công ty

            </button>

            <button type="button" class="btn btn-sm fw-semibold text-white px-3" style="background-color: #16a34a; border-color: #16a34a;" onclick="openSyncInvoiceModal()" title="Tự động đồng bộ hóa đơn không cần điền lại thông tin">

                <i class="bi bi-arrow-repeat me-1"></i> Đồng bộ dữ liệu hoá đơn điện tử

            </button>

            <button type="button" class="btn btn-primary btn-sm fw-semibold px-3" onclick="triggerAutoQuickDownload()" title="Tự động tải nhanh dữ liệu 30 ngày gần nhất và tệp gốc">

                <i class="bi bi-lightning-charge-fill me-1"></i> Tải nhanh dữ liệu hoá đơn

            </button>

        </div>

    </div>



    <!-- Thanh tiến trình đồng bộ tự động nổi (Auto Sync Progress Banner) -->

    <div id="autoSyncProgressBox" class="alert alert-primary border-0 shadow-sm d-none mb-0 py-2 px-3 align-items-center justify-content-between" style="border-radius: 8px;">

        <div class="d-flex align-items-center gap-3 flex-grow-1 me-3">

            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>

            <div class="flex-grow-1">

                <div class="d-flex justify-content-between align-items-center mb-1">

                    <strong class="small text-dark" id="autoSyncStatusTitle">Đang tự động kết nối Cổng Tổng cục Thuế...</strong>

                    <span class="small fw-bold text-primary" id="autoSyncPercent">0%</span>

                </div>

                <div class="progress" style="height: 6px;">

                    <div id="autoSyncProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%;"></div>

                </div>

                <div class="small text-muted mt-1" id="autoSyncStageDetail">Khởi tạo tiến trình...</div>

            </div>

        </div>

        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" onclick="cancelAutoSync()">Hủy</button>

    </div>



    <!-- 2. Thanh Tabs Tra cứu Bán ra / Mua vào / Kiểm tra NCC & Nút Lập tờ khai, Xuất file -->

    <div class="fdi-nav-bar">

        <div class="fdi-underline-tabs">

            <button type="button" class="fdi-tab-link @(isBanRa ? "active" : "")" onclick="switchInvoiceType('BanRa')">

                Tra cứu hóa đơn điện tử bán ra

            </button>

            <button type="button" class="fdi-tab-link @(!isBanRa ? "active" : "")" onclick="switchInvoiceType('MuaVao')">

                Tra cứu hóa đơn điện tử mua vào

            </button>

            <a href="/TaxAccount/Lookup" class="fdi-tab-link">

                Kiểm tra nhà cung cấp

            </a>

        </div>



        <div class="d-flex align-items-center gap-2 py-1">

            <button type="button" class="btn btn-primary btn-sm fw-semibold px-3" onclick="openTaxDeclarationModal()" title="Lập tờ khai thuế GTGT Mẫu 01/GTGT và bảng kê">

                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Lập tờ khai và bảng kê

            </button>



            <button type="button" class="btn btn-primary btn-sm fw-semibold px-3" onclick="filterRiskSuppliers()">

                <i class="bi bi-shield-exclamation me-1"></i> Kiểm tra nhà cung cấp rủi ro

            </button>



            <div class="dropdown">

                <button class="btn btn-primary btn-sm dropdown-toggle fw-semibold px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">

                    <i class="bi bi-file-earmark-excel me-1"></i> Xuất file excel tổng hợp và hóa đơn

                </button>

                <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="font-size: 0.84rem;">

                    <li>

                        <button type="button" class="dropdown-item py-2 fw-bold text-success" onclick="triggerExport('ExcelSummary')">

                            <i class="bi bi-file-earmark-excel-fill text-success me-2"></i> Xuất file Excel đầy đủ 7 Sheet

                        </button>

                    </li>

                    <li>

                        <button type="button" class="dropdown-item py-2 fw-semibold" style="color: #0284c7;" onclick="triggerExport('ExcelSmartPro')">

                            <i class="bi bi-file-earmark-spreadsheet-fill me-2" style="color: #0284c7;"></i> Xuất Excel Smart Pro

                        </button>

                    </li>

                    <li><hr class="dropdown-divider"></li>

                    <li>

                        <button type="button" class="dropdown-item py-2 fw-semibold" style="color: #0369a1;" onclick="triggerExport('ExcelFullMuaVao')">

                            <i class="bi bi-file-earmark-ruled me-2" style="color: #0284c7;"></i> Xuất Excel Chi tiết Mua vào

                        </button>

                    </li>

                    <li>

                        <button type="button" class="dropdown-item py-2 fw-semibold" style="color: #b45309;" onclick="triggerExport('ExcelFullBanRa')">

                            <i class="bi bi-file-earmark-ruled-fill me-2" style="color: #d97706;"></i> Xuất Excel Chi tiết Bán ra

                        </button>

                    </li>

                    <li><hr class="dropdown-divider"></li>

                    <li>

                        <button type="button" class="dropdown-item py-2 fw-semibold text-danger" onclick="triggerBatchPdfZip()">

                            <i class="bi bi-file-earmark-pdf-fill me-2"></i> Tải hàng loạt PDF gốc

                        </button>

                    </li>

                    <li>

                        <button type="button" class="dropdown-item py-2" onclick="triggerBatchZip()">

                            <i class="bi bi-file-earmark-zip text-primary me-2"></i> Tải file ZIP XML & Bản thể hiện

                        </button>

                    </li>

                </ul>

            </div>

        </div>

    </div>



    <!-- 3. Khung Bộ Lọc Hóa Đơn Đã Được Đồng Bộ -->

    <div class="fdi-filter-card">

        <div class="fdi-filter-header" data-bs-toggle="collapse" data-bs-target="#collapseFilterBody" aria-expanded="true">

            <h6 class="fdi-filter-title">

                <i class="bi bi-funnel text-secondary"></i>

                Bộ lọc hóa đơn @(isBanRa ? "bán ra" : "mua vào") đã được đồng bộ

            </h6>

            <button type="button" class="btn btn-sm btn-link text-secondary p-0 text-decoration-none">

                <i class="bi bi-dash-lg"></i>

            </button>

        </div>



        <div class="collapse show" id="collapseFilterBody">

            <div class="p-3 pt-2">

                <form id="filterForm" asp-controller="Invoice" asp-action="Index" method="get">

                    <input type="hidden" name="InvoiceType" id="inputInvoiceType" value="@filter.InvoiceType" />

                    <input type="hidden" name="QuickDateRange" id="inputQuickDateRange" value="custom" />

                    <input type="hidden" name="SortBy" id="inputSortBy" value="@filter.SortBy" />

                    <input type="hidden" name="Page" id="inputPage" value="1" />

                    <input type="hidden" name="HasTaxCode" id="inputHasTaxCode" value="@(filter.HasTaxCode.HasValue ? filter.HasTaxCode.Value.ToString().ToLower() : "")" />

                    <input type="hidden" name="IsCashRegister" id="inputIsCashRegister" value="@(filter.IsCashRegister.HasValue ? filter.IsCashRegister.Value.ToString().ToLower() : "")" />



                    <div class="row gx-4 gy-1">

                        <!-- Cột Trái -->

                        <div class="col-12 col-lg-6">

                            <div class="fdi-form-row">

                                <label class="fdi-form-label">@(isBanRa ? "MST người mua" : "MST người bán")</label>

                                <div class="fdi-form-input">

                                    <input type="text" name="SellerTaxCode" class="form-control" placeholder="Nhập mã số thuế..." value="@filter.SellerTaxCode" />

                                </div>

                            </div>



                            <div class="fdi-form-row">

                                <label class="fdi-form-label">Trạng thái <span class="text-danger">(*)</span></label>

                                <div class="fdi-form-input">

                                    <select name="Status" class="form-select">

                                        <option value="">Tất cả</option>

                                        <option value="Hóa đơn mới" selected="@(filter.Status == "Hóa đơn mới")">Hóa đơn mới / Đã cấp mã</option>

                                        <option value="Đã thay thế" selected="@(filter.Status == "Đã thay thế")">Đã thay thế</option>

                                        <option value="Đã điều chỉnh" selected="@(filter.Status == "Đã điều chỉnh")">Đã điều chỉnh</option>

                                        <option value="Đã bị hủy" selected="@(filter.Status == "Đã bị hủy")">Đã bị hủy</option>

                                    </select>

                                </div>

                            </div>



                            <div class="fdi-form-row">

                                <label class="fdi-form-label">Kết quả kiểm tra <span class="text-danger">(*)</span></label>

                                <div class="fdi-form-input">

                                    <select name="ValidationResult" id="selectValidationResult" class="form-select">

                                        <option value="">Tất cả</option>

                                        <option value="Normal" selected="@(filter.ValidationResult == "Normal")">Hợp lệ / Bình thường</option>

                                        <option value="Warning" selected="@(filter.ValidationResult == "Warning")">Cảnh báo rủi ro</option>

                                        <option value="HasTaxCode" selected="@(filter.ValidationResult == "HasTaxCode")">Có mã CQT</option>

                                        <option value="NoTaxCode" selected="@(filter.ValidationResult == "NoTaxCode")">Không mã CQT</option>

                                        <option value="CashRegister" selected="@(filter.ValidationResult == "CashRegister")">Hóa đơn từ máy tính tiền</option>

                                    </select>

                                </div>

                            </div>



                            <div class="fdi-form-row">

                                <label class="fdi-form-label">Số hóa đơn</label>

                                <div class="fdi-form-input">

                                    <input type="text" name="InvoiceNumber" class="form-control" placeholder="Ví dụ: 1702" value="@filter.InvoiceNumber" />

                                </div>

                            </div>

                        </div>



                        <!-- Cột Phải -->

                        <div class="col-12 col-lg-6">

                            <div class="fdi-form-row">

                                <label class="fdi-form-label">@(isBanRa ? "Tên người mua / Từ khóa" : "Tên người bán / Từ khóa")</label>

                                <div class="fdi-form-input">

                                    <input type="text" name="Keyword" class="form-control" placeholder="Tìm theo tên công ty, ký hiệu, số HĐ..." value="@filter.Keyword" />

                                </div>

                            </div>



                            <div class="fdi-form-row">

                                <label class="fdi-form-label">Ngày lập hóa đơn <span class="text-danger">(*)</span></label>

                                <div class="fdi-form-input d-flex align-items-center gap-2">

                                    <div class="fdi-date-box">

                                        <span class="date-sub-label">Từ ngày</span>

                                        <input type="text" name="FromDate" id="inputFromDate" class="form-control fdi-filter-datepicker bg-white" placeholder="dd/MM/yyyy" value="@(filter.FromDate?.ToString("dd/MM/yyyy"))" autocomplete="off" />

                                        <i class="bi bi-calendar3 date-box-icon"></i>

                                    </div>

                                    <div class="fdi-date-box">

                                        <span class="date-sub-label">Đến ngày</span>

                                        <input type="text" name="ToDate" id="inputToDate" class="form-control fdi-filter-datepicker bg-white" placeholder="dd/MM/yyyy" value="@(filter.ToDate?.ToString("dd/MM/yyyy"))" autocomplete="off" />

                                        <i class="bi bi-calendar3 date-box-icon"></i>

                                    </div>

                                </div>

                            </div>



                            <div class="fdi-form-row">

                                <label class="fdi-form-label">Ký hiệu mẫu số hóa đơn</label>

                                <div class="fdi-form-input">

                                    <select name="TemplateType" class="form-select">

                                        <option value="">Tất cả</option>

                                        <option value="1" selected="@(filter.TemplateType == "1")">1 - Hóa đơn giá trị gia tăng</option>

                                        <option value="2" selected="@(filter.TemplateType == "2")">2 - Hóa đơn bán hàng</option>

                                        <option value="3" selected="@(filter.TemplateType == "3")">3 - Hóa đơn bán tài sản công</option>

                                        <option value="4" selected="@(filter.TemplateType == "4")">4 - Hóa đơn bán hàng dự trữ quốc gia</option>

                                        <option value="5" selected="@(filter.TemplateType == "5")">5 - Hóa đơn khác (tem, vé, thẻ...)</option>

                                        <option value="6" selected="@(filter.TemplateType == "6")">6 - Chứng từ thu phí, lệ phí</option>

                                    </select>

                                </div>

                            </div>



                            <div class="fdi-form-row">

                                <label class="fdi-form-label">Ký hiệu hóa đơn</label>

                                <div class="fdi-form-input">

                                    <input type="text" name="InvoiceSymbol" class="form-control" placeholder="Ví dụ: C26TUL" value="@filter.InvoiceSymbol" />

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- Nút Tìm kiếm & Bỏ tìm kiếm ở chính giữa -->

                    <div class="d-flex justify-content-center align-items-center gap-2 mt-2 pt-1">

                        <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">

                            <i class="bi bi-search me-1"></i> Tìm kiếm

                        </button>

                        <a href="/phan-mem-ke-toan?InvoiceType=@filter.InvoiceType" class="btn btn-light border btn-sm px-3 text-secondary">

                            <i class="bi bi-arrow-counterclockwise me-1"></i> Bỏ tìm kiếm

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>



    <!-- Hidden Forms cho Xuất ZIP hàng loạt -->

    <form id="formBatchZip" asp-controller="Export" asp-action="BatchZip" method="post" class="d-none">

        @Html.AntiForgeryToken()

        <input type="hidden" name="InvoiceType" value="@filter.InvoiceType" />

        <input type="hidden" name="FromDate" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" />

        <input type="hidden" name="ToDate" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" />

        <input type="hidden" name="Keyword" value="@filter.Keyword" />

        <input type="hidden" name="SellerTaxCode" value="@filter.SellerTaxCode" />

        <input type="hidden" name="SellerName" value="@filter.SellerName" />

        <input type="hidden" name="InvoiceSymbol" value="@filter.InvoiceSymbol" />

        <input type="hidden" name="InvoiceNumber" value="@filter.InvoiceNumber" />

        <input type="hidden" name="TemplateType" value="@filter.TemplateType" />

        <input type="hidden" name="FileDownloadStatus" value="@filter.FileDownloadStatus" />

        <input type="hidden" name="ValidationResult" value="@filter.ValidationResult" />

        <input type="hidden" name="Status" value="@filter.Status" />

        <div id="selectedIdsContainer"></div>

    </form>



    <form id="formBatchPdfZip" asp-controller="Export" asp-action="BatchPdfZip" method="post" class="d-none">

        @Html.AntiForgeryToken()

        <input type="hidden" name="InvoiceType" value="@filter.InvoiceType" />

        <input type="hidden" name="FromDate" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" />

        <input type="hidden" name="ToDate" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" />

        <input type="hidden" name="Keyword" value="@filter.Keyword" />

        <input type="hidden" name="SellerTaxCode" value="@filter.SellerTaxCode" />

        <input type="hidden" name="SellerName" value="@filter.SellerName" />

        <input type="hidden" name="InvoiceSymbol" value="@filter.InvoiceSymbol" />

        <input type="hidden" name="InvoiceNumber" value="@filter.InvoiceNumber" />

        <input type="hidden" name="TemplateType" value="@filter.TemplateType" />

        <input type="hidden" name="FileDownloadStatus" value="@filter.FileDownloadStatus" />

        <input type="hidden" name="ValidationResult" value="@filter.ValidationResult" />

        <input type="hidden" name="Status" value="@filter.Status" />

        <div id="selectedPdfIdsContainer"></div>

    </form>



    <!-- 4. Khung Bảng Dữ Liệu Hóa Đơn -->

    <div class="fdi-table-card">

        <div class="fdi-table-topbar">

            <div class="d-flex align-items-center gap-3 flex-wrap">

                <div class="fdi-underline-tabs">

                    <button type="button" class="fdi-tab-link active py-1" id="tabBtnTongQuat" onclick="switchInvoiceViewTab('tong-quat')">Tổng quát</button>

                    <button type="button" class="fdi-tab-link py-1" id="tabBtnChiTiet" onclick="switchInvoiceViewTab('chi-tiet')">Chi tiết hoá đơn</button>

                </div>

                <div class="fdi-summary-pills">

                    <span class="fdi-summary-pill">

                        Tổng số HĐ: <strong class="text-primary">@summary.TotalCount.ToString("N0")</strong>

                    </span>

                    <span class="fdi-summary-pill">

                        Chưa thuế: <strong>@summary.TotalAmountBeforeTax.ToString("N0") đ</strong>

                    </span>

                    <span class="fdi-summary-pill">

                        Tiền thuế: <strong class="text-danger">@summary.TotalTaxAmount.ToString("N0") đ</strong>

                    </span>

                    <span class="fdi-summary-pill">

                        Tổng thanh toán: <strong class="text-primary">@summary.TotalAmount.ToString("N0") đ</strong>

                    </span>

                </div>

            </div>



            <div class="d-flex align-items-center gap-2 flex-wrap">

                <button type="button" class="btn btn-outline-danger btn-sm fw-semibold d-none" id="btnDeleteSelected" onclick="deleteSelectedInvoices()">

                    <i class="bi bi-trash me-1"></i> Xóa đã chọn (<span id="selectedCount">0</span>)

                </button>

                <button type="button" class="btn btn-primary btn-sm fw-semibold" id="btnBatchDownloadOriginal" onclick="triggerBatchOriginalDownload()" title="Tải hàng loạt file PDF và XML gốc từ Tổng cục Thuế">

                    <i class="bi bi-download me-1"></i> Tải hàng loạt hóa đơn gốc

                </button>

                <button type="button" class="btn btn-light border btn-sm fw-semibold text-secondary" id="btnConfigOriginalInvoices" onclick="openOriginalInvoiceConfigModal()" title="Cấu hình tài khoản Hóa đơn điện tử lấy hóa đơn gốc">

                    <i class="bi bi-gear me-1"></i> Cấu hình thông tin lấy hóa đơn gốc

                </button>

            </div>

        </div>

        <!-- 1. BẢNG TỔNG QUÁT HÓA ĐƠN -->
        <div class="table-responsive" id="invoiceTable">

            <table class="table fdi-table align-middle mb-0 text-nowrap">

                <thead>

                    <tr>

                        <th style="width: 36px;" class="text-center">

                            <input type="checkbox" id="selectAll" class="form-check-input" />

                        </th>

                        <th style="width: 45px;" class="text-center">STT</th>

                        <th style="width: 80px;" class="text-center">Ký hiệu mẫu số</th>

                        <th style="width: 95px;" class="text-center">Ký hiệu hóa đơn</th>

                        <th style="width: 90px;" class="text-center">Số hóa đơn</th>

                        <th style="width: 100px;" class="text-center">Ngày lập</th>

                        <th style="width: 130px;">MST người bán</th>

                        <th style="min-width: 220px;">Tên người bán</th>

                        <th style="min-width: 200px;">Địa chỉ người bán</th>

                        <th style="width: 130px;">MST người mua</th>

                        <th style="min-width: 200px;">Tên người mua</th>

                        <th style="width: 130px;" class="text-end">Tổng tiền chưa thuế</th>

                        <th style="width: 120px;" class="text-end">Tổng tiền thuế</th>

                        <th style="width: 140px;" class="text-end fw-bold text-primary">Tổng thanh toán</th>

                        <th style="width: 120px;" class="text-center">Trạng thái</th>

                        <th style="width: 120px;" class="text-center">Xem hóa đơn</th>

                        <th style="width: 110px;" class="text-center">Tải file</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Invoices.Any())

                    {

                        int stt = (Model.CurrentPage - 1) * Model.Filter.PageSize + 1;

                        foreach (var inv in Model.Invoices)

                        {

                            var rawSym = inv.InvoiceSymbol ?? "";

                            var templateNum = !string.IsNullOrWhiteSpace(inv.TemplateCode) ? inv.TemplateCode : ((rawSym.Length > 0 && char.IsDigit(rawSym[0])) ? rawSym.Substring(0, 1) : "1");

                            var shortSym = (rawSym.Length > 1 && char.IsDigit(rawSym[0])) ? rawSym.Substring(1) : rawSym;

                            var isForeign = !string.IsNullOrEmpty(inv.Currency) && !inv.Currency.Equals("VND", StringComparison.OrdinalIgnoreCase);

                            var amtBeforeVnd = inv.AmountBeforeTaxVnd > 0 ? inv.AmountBeforeTaxVnd : (inv.AmountBeforeTax * (inv.ExchangeRate > 0 ? inv.ExchangeRate : 1));

                            var taxVnd = inv.TaxAmountVnd > 0 ? inv.TaxAmountVnd : (inv.TaxAmount * (inv.ExchangeRate > 0 ? inv.ExchangeRate : 1));

                            var totalVnd = inv.TotalAmountVnd > 0 ? inv.TotalAmountVnd : (inv.TotalAmount * (inv.ExchangeRate > 0 ? inv.ExchangeRate : 1));

                            <tr>

                                <td class="text-center">

                                    <input type="checkbox" class="form-check-input row-select" value="@inv.Id" />

                                </td>

                                <td class="text-center text-muted">@stt</td>

                                <td class="text-center font-monospace">@templateNum</td>
                                <td class="text-center font-monospace fw-semibold">@shortSym</td>
                                <td class="text-center font-monospace fw-bold text-primary">@inv.InvoiceNumber</td>
                                <td class="text-center">@inv.IssueDate.ToString("dd/MM/yyyy")</td>
                                <td class="font-monospace">@inv.SellerTaxCode</td>
                                <td>
                                    <div class="fw-semibold text-wrap" style="max-width: 280px;">@inv.SellerName</div>
                                    @if (!string.IsNullOrEmpty(inv.RiskReason))
                                    {
                                        <div class="text-danger small"><i class="bi bi-exclamation-circle"></i> @inv.RiskReason</div>
                                    }
                                </td>
                                <td>
                                    <div class="text-muted small text-wrap" style="max-width: 250px;">@inv.SellerAddress</div>
                                </td>
                                <td class="font-monospace">@(string.IsNullOrEmpty(inv.BuyerTaxCode) ? "-" : inv.BuyerTaxCode)</td>
                                <td>
                                    <div class="text-wrap" style="max-width: 240px;">@inv.BuyerName</div>
                                </td>
                                <td class="text-end font-monospace">@amtBeforeVnd.ToString("N0")</td>
                                <td class="text-end font-monospace text-danger">@taxVnd.ToString("N0")</td>
                                <td class="text-end font-monospace fw-bold text-primary">@totalVnd.ToString("N0")</td>
                                <td class="text-center">
                                    @if (inv.Status == "Hóa đơn mới" || inv.Status == "Đã cấp mã" || inv.Status == "5")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Hóa đơn mới</span>
                                    }
                                    else if (inv.Status == "Đã điều chỉnh" || inv.Status == "8")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Đã điều chỉnh</span>
                                    }
                                    else if (inv.Status == "Đã thay thế" || inv.Status == "7")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Hóa đơn đã bị thay thế</span>
                                    }
                                    else if (inv.Status == "Đã bị hủy" || inv.Status == "9")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã bị hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">@inv.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none p-0 d-inline-flex align-items-center gap-1" onclick="openInvoiceModal(@inv.Id)" title="Xem chi tiết và PDF gốc">
                                        <i class="bi bi-eye"></i> Xem hóa đơn
                                    </button>
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-action="DownloadAllFiles" asp-route-invoiceId="@inv.Id" class="btn btn-sm btn-link text-primary text-decoration-none p-0 d-inline-flex align-items-center gap-1" title="Tải file hóa đơn (.zip)">
                                            <i class="bi bi-download"></i> Tải file
                                        </a>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1" title="Xóa hóa đơn" onclick="deleteSingleInvoice(@inv.Id, '@inv.InvoiceSymbol', '@inv.InvoiceNumber')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>

                            </tr>

                            stt++;

                        }

                    }

                    else

                    {

                        <tr>

                            <td colspan="17" class="text-muted py-4 px-3 text-center">

                                Không có dữ liệu hóa đơn nào phù hợp với bộ lọc hiện tại.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

        <!-- 2. BẢNG CHI TIẾT HÓA ĐƠN THEO MẶT HÀNG / DỊCH VỤ -->
        <div class="table-responsive d-none" id="invoiceDetailTable">

            <table class="table fdi-table align-middle mb-0 text-nowrap">

                <thead>

                    <tr>

                        <th style="width: 45px;" class="text-center">STT</th>

                        <th style="width: 80px;" class="text-center">Ký hiệu mẫu số</th>

                        <th style="width: 95px;" class="text-center">Ký hiệu hóa đơn</th>

                        <th style="width: 90px;" class="text-center">Số hóa đơn</th>

                        <th style="width: 100px;" class="text-center">Ngày lập hóa đơn</th>

                        <th style="width: 110px;" class="text-center">Ngày người bán ký số</th>

                        <th style="min-width: 220px;">Tên người bán</th>

                        <th style="width: 130px;">MST người bán</th>

                        <th style="min-width: 220px;">Địa chỉ người bán</th>

                        <th style="min-width: 200px;">Tên người mua</th>

                        <th style="width: 130px;">MST người mua</th>

                        <th style="width: 120px;">CCCD người mua</th>

                        <th style="min-width: 200px;">Địa chỉ người mua</th>

                        <th style="min-width: 250px;">Tên hàng hóa, dịch vụ</th>

                        <th style="width: 90px;" class="text-center">Đơn vị tính</th>

                        <th style="width: 80px;" class="text-end">Số lượng</th>

                        <th style="width: 110px;" class="text-end">Đơn giá</th>

                        <th style="width: 90px;" class="text-end">Chiết khấu</th>

                        <th style="width: 90px;" class="text-center">Thuế suất</th>

                        <th style="width: 130px;" class="text-end">Tiền chưa thuế nguyên tệ</th>

                        <th style="width: 120px;" class="text-end">Tiền thuế nguyên tệ</th>

                        <th style="width: 130px;" class="text-end">Tiền sau thuế nguyên tệ</th>

                        <th style="width: 130px;" class="text-end">Tiền chưa thuế (VND)</th>

                        <th style="width: 120px;" class="text-end">Tiền thuế (VND)</th>

                        <th style="width: 130px;" class="text-end">Tiền sau thuế (VND)</th>

                        <th style="width: 120px;" class="text-end">Số tiền chiết khấu</th>

                        <th style="width: 130px;" class="text-end">Tổng tiền chiết khấu TM</th>

                        <th style="width: 110px;" class="text-end">Tổng tiền phí</th>

                        <th style="width: 130px;" class="text-end">Tổng tiền thanh toán</th>

                        <th style="width: 140px;" class="text-end fw-bold text-primary">Tổng tiền thanh toán (VND)</th>

                        <th style="width: 120px;" class="text-center">Hình thức thanh toán</th>

                        <th style="width: 130px;" class="text-center">Tính chất</th>

                        <th style="width: 130px;" class="text-center">Trạng thái hóa đơn</th>

                        <th style="width: 140px;" class="text-center">Kết quả kiểm tra hóa đơn</th>

                        <th style="min-width: 160px;">Website người bán</th>

                        <th style="min-width: 180px;">Url tra cứu hóa đơn gốc</th>

                        <th style="width: 150px;" class="text-center">Mã tra cứu hóa đơn gốc</th>

                        <th style="width: 90px;" class="text-center">Đơn vị tiền tệ</th>

                        <th style="width: 80px;" class="text-end">Tỷ giá</th>

                        <th style="width: 110px;" class="text-center">Biển số xe</th>

                        <th style="min-width: 240px;">Ghi chú: Hóa đơn thay thế, điều chỉnh, bị thay thế, bị điều chỉnh</th>

                        <th style="width: 120px;" class="text-center">Xem hóa đơn</th>

                        <th style="width: 110px;" class="text-center">Tải file</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Invoices.Any())

                    {

                        int detailStt = 1;

                        foreach (var inv in Model.Invoices)

                        {

                            var rawSym = inv.InvoiceSymbol ?? "";

                            var templateNum = !string.IsNullOrWhiteSpace(inv.TemplateCode) ? inv.TemplateCode : ((rawSym.Length > 0 && char.IsDigit(rawSym[0])) ? rawSym.Substring(0, 1) : "1");

                            var shortSym = (rawSym.Length > 1 && char.IsDigit(rawSym[0])) ? rawSym.Substring(1) : rawSym;

                            var isForeign = !string.IsNullOrEmpty(inv.Currency) && !inv.Currency.Equals("VND", StringComparison.OrdinalIgnoreCase);

                            var totalVnd = inv.TotalAmountVnd > 0 ? inv.TotalAmountVnd : (inv.TotalAmount * (inv.ExchangeRate > 0 ? inv.ExchangeRate : 1));

                            var details = inv.Details.Any() ? inv.Details.OrderBy(d => d.LineNumber).ToList() : new List<InvoiceDetail>

                            {

                                new InvoiceDetail

                                {

                                    ItemName = "Hàng hóa, dịch vụ theo HĐ " + shortSym + "-" + inv.InvoiceNumber,

                                    Unit = "Dịch vụ",

                                    Quantity = 1,

                                    UnitPrice = inv.AmountBeforeTax,

                                    AmountBeforeTax = inv.AmountBeforeTax,

                                    TaxRate = 10,

                                    TaxAmount = inv.TaxAmount,

                                    TotalAmount = inv.TotalAmount,

                                    AmountBeforeTaxVnd = inv.AmountBeforeTaxVnd > 0 ? inv.AmountBeforeTaxVnd : inv.AmountBeforeTax,

                                    TaxAmountVnd = inv.TaxAmountVnd > 0 ? inv.TaxAmountVnd : inv.TaxAmount,

                                    TotalAmountVnd = totalVnd

                                }

                            };

                            foreach (var d in details)

                            {

                                var dAmtBeforeVnd = d.AmountBeforeTaxVnd > 0 ? d.AmountBeforeTaxVnd : (d.AmountBeforeTax * (inv.ExchangeRate > 0 ? inv.ExchangeRate : 1));

                                var dTaxVnd = d.TaxAmountVnd > 0 ? d.TaxAmountVnd : (d.TaxAmount * (inv.ExchangeRate > 0 ? inv.ExchangeRate : 1));

                                var dTotalVnd = d.TotalAmountVnd > 0 ? d.TotalAmountVnd : (d.TotalAmount * (inv.ExchangeRate > 0 ? inv.ExchangeRate : 1));

                                <tr>

                                    <td class="text-center text-muted">@detailStt</td>

                                    <td class="text-center font-monospace">@templateNum</td>

                                    <td class="text-center font-monospace fw-semibold">@shortSym</td>

                                    <td class="text-center font-monospace fw-bold text-primary">@inv.InvoiceNumber</td>

                                    <td class="text-center">@inv.IssueDate.ToString("dd/MM/yyyy")</td>

                                    <td class="text-center">@(inv.SignedDate?.ToString("dd/MM/yyyy") ?? inv.IssueDate.ToString("dd/MM/yyyy"))</td>

                                    <td>

                                        <div class="fw-semibold text-wrap" style="max-width: 250px;">@inv.SellerName</div>

                                    </td>

                                    <td class="font-monospace">@inv.SellerTaxCode</td>

                                    <td>

                                        <div class="text-muted small text-wrap" style="max-width: 230px;">@inv.SellerAddress</div>

                                    </td>

                                    <td>

                                        <div class="text-wrap" style="max-width: 230px;">@inv.BuyerName</div>

                                    </td>

                                    <td class="font-monospace">@(string.IsNullOrEmpty(inv.BuyerTaxCode) ? "-" : inv.BuyerTaxCode)</td>

                                    <td>@(string.IsNullOrEmpty(inv.BuyerCitizenId) ? "-" : inv.BuyerCitizenId)</td>

                                    <td>

                                        <div class="text-muted small text-wrap" style="max-width: 230px;">@(string.IsNullOrEmpty(inv.BuyerAddress) ? "-" : inv.BuyerAddress)</div>

                                    </td>

                                    <td>

                                        <div class="text-wrap fw-medium" style="max-width: 280px;">@d.ItemName</div>

                                    </td>

                                    <td class="text-center">@d.Unit</td>

                                    <td class="text-end font-monospace">@d.Quantity.ToString("G29")</td>

                                    <td class="text-end font-monospace">@(isForeign ? d.UnitPrice.ToString("N2") : d.UnitPrice.ToString("N0"))</td>

                                    <td class="text-end font-monospace">@(d.DiscountRate > 0 ? d.DiscountRate.ToString("G29") + "%" : "0")</td>

                                    <td class="text-center font-monospace">@(d.TaxRate >= 0 ? d.TaxRate.ToString("G29") + "%" : "KCT")</td>

                                    <td class="text-end font-monospace">@(isForeign ? d.AmountBeforeTax.ToString("N2") : d.AmountBeforeTax.ToString("N0"))</td>

                                    <td class="text-end font-monospace text-danger">@(isForeign ? d.TaxAmount.ToString("N2") : d.TaxAmount.ToString("N0"))</td>

                                    <td class="text-end font-monospace">@(isForeign ? d.TotalAmount.ToString("N2") : d.TotalAmount.ToString("N0"))</td>

                                    <td class="text-end font-monospace">@dAmtBeforeVnd.ToString("N0")</td>

                                    <td class="text-end font-monospace text-danger">@dTaxVnd.ToString("N0")</td>

                                    <td class="text-end font-monospace">@dTotalVnd.ToString("N0")</td>

                                    <td class="text-end font-monospace">@d.DiscountAmount.ToString("N0")</td>

                                    <td class="text-end font-monospace">@inv.DiscountAmount.ToString("N0")</td>

                                    <td class="text-end font-monospace">@inv.FeeAmount.ToString("N0")</td>

                                    <td class="text-end font-monospace fw-semibold">@(isForeign ? inv.TotalAmount.ToString("N2") : inv.TotalAmount.ToString("N0"))</td>

                                    <td class="text-end font-monospace fw-bold text-primary">@totalVnd.ToString("N0")</td>

                                    <td class="text-center">@(string.IsNullOrEmpty(inv.PaymentMethod) ? "TM/CK" : inv.PaymentMethod)</td>

                                    <td class="text-center">@(string.IsNullOrEmpty(inv.InvoiceProperty) ? "Hàng hoá/dịch vụ" : inv.InvoiceProperty)</td>

                                    <td class="text-center">

                                        @if (inv.Status == "Hóa đơn mới" || inv.Status == "Đã cấp mã" || inv.Status == "5")

                                        {

                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Hóa đơn mới</span>

                                        }

                                        else if (inv.Status == "Đã thay thế" || inv.Status == "7")

                                        {

                                            <span class="badge bg-info-subtle text-info border border-info-subtle">Hóa đơn đã bị thay thế</span>

                                        }

                                        else

                                        {

                                            <span class="badge bg-light text-dark border">@inv.Status</span>

                                        }

                                    </td>

                                    <td class="text-center">

                                        <span class="badge bg-light text-success border">@(string.IsNullOrEmpty(inv.VerificationResult) ? "Đã cấp mã hoá đơn" : inv.VerificationResult)</span>

                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(inv.SellerWebsite))
                                        {
                                            <a href="@(inv.SellerWebsite.StartsWith("http") ? inv.SellerWebsite : "https://" + inv.SellerWebsite)" target="_blank" class="text-truncate d-inline-block text-primary" style="max-width: 150px;" title="@inv.SellerWebsite">@inv.SellerWebsite</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td>
                                        @{
                                            var targetDetailLookupUrl = !string.IsNullOrEmpty(inv.LookupUrl) ? inv.LookupUrl : "https://hoadondientu.gdt.gov.vn/";
                                            if (targetDetailLookupUrl.Contains("vinvoice.viettel.vn", StringComparison.OrdinalIgnoreCase))
                                            {
                                                targetDetailLookupUrl = "https://vinvoice.viettel.vn/utilities/invoice-search";
                                            }
                                            else if (targetDetailLookupUrl.Contains("meinvoice.vn", StringComparison.OrdinalIgnoreCase) && targetDetailLookupUrl.Contains("tra-cuu-hoa-don", StringComparison.OrdinalIgnoreCase))
                                            {
                                                targetDetailLookupUrl = "https://meinvoice.vn/tra-cuu";
                                            }
                                        }
                                        <a href="@targetDetailLookupUrl" target="_blank" class="text-primary text-decoration-underline text-truncate d-inline-block font-monospace" style="max-width: 180px;" title="@targetDetailLookupUrl">
                                            @targetDetailLookupUrl
                                        </a>
                                    </td>

                                    <td class="text-center font-monospace">
                                        @{
                                            var detailLookupCodeVal = !string.IsNullOrEmpty(inv.LookupCode) ? inv.LookupCode : (!string.IsNullOrEmpty(inv.TaxAuthorityCode) ? inv.TaxAuthorityCode : inv.InvoiceNumber);
                                        }
                                        <a href="@targetDetailLookupUrl" target="_blank" onclick="copyLookupCodeAndOpen('@detailLookupCodeVal', '@inv.SellerTaxCode', event)" class="font-monospace fw-semibold text-primary text-decoration-underline" title="Bấm để sao chép mã và mở trang tra cứu">@detailLookupCodeVal</a>
                                    </td>

                                    <td class="text-center fw-semibold">@(string.IsNullOrEmpty(inv.Currency) ? "VND" : inv.Currency)</td>

                                    <td class="text-end font-monospace">@(inv.ExchangeRate > 0 ? inv.ExchangeRate.ToString("N0") : "1")</td>

                                    <td class="text-center">@(string.IsNullOrEmpty(inv.VehicleNumber) ? "-" : inv.VehicleNumber)</td>

                                    <td>
                                        <div class="small text-muted text-wrap" style="max-width: 240px;">@(string.IsNullOrEmpty(inv.ReplacedOrAdjustedNote) ? "-" : inv.ReplacedOrAdjustedNote)</div>
                                    </td>

                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none p-0 d-inline-flex align-items-center gap-1" onclick="openInvoiceModal(@inv.Id)" title="Xem chi tiết và PDF gốc">
                                            <i class="bi bi-eye"></i> Xem hóa đơn
                                        </button>
                                    </td>

                                    <td class="text-center">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <a asp-action="DownloadAllFiles" asp-route-invoiceId="@inv.Id" class="btn btn-sm btn-link text-primary text-decoration-none p-0 d-inline-flex align-items-center gap-1" title="Tải file hóa đơn (.zip)">
                                                <i class="bi bi-download"></i> Tải file
                                            </a>
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1" title="Xóa hóa đơn" onclick="deleteSingleInvoice(@inv.Id, '@inv.InvoiceSymbol', '@inv.InvoiceNumber')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>

                                </tr>

                                detailStt++;

                            }

                        }

                    }

                    else

                    {

                        <tr>

                            <td colspan="43" class="text-muted py-4 px-3 text-center">

                                Không có dữ liệu mặt hàng nào phù hợp với bộ lọc hiện tại.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

        <!-- Phân trang -->

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-top bg-light">

            <div class="small text-muted">

                Hiển thị <strong>@Model.Invoices.Count</strong> trên tổng số <strong>@Model.TotalItems.ToString("N0")</strong> hóa đơn

            </div>



            @if (Model.TotalPages > 1)

            {

                <nav aria-label="Phân trang hóa đơn">

                    <ul class="pagination pagination-sm mb-0">

                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">

                            <button type="button" class="page-link" onclick="goToPage(1)"><i class="bi bi-chevron-double-left"></i></button>

                        </li>

                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">

                            <button type="button" class="page-link" onclick="goToPage(@(Model.CurrentPage - 1))"><i class="bi bi-chevron-left"></i></button>

                        </li>



                        @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)

                        {

                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">

                                <button type="button" class="page-link" onclick="goToPage(@p)">@p</button>

                            </li>

                        }



                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">

                            <button type="button" class="page-link" onclick="goToPage(@(Model.CurrentPage + 1))"><i class="bi bi-chevron-right"></i></button>

                        </li>

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">

                            <button type="button" class="page-link" onclick="goToPage(@Model.TotalPages)"><i class="bi bi-chevron-double-right"></i></button>

                        </li>

                    </ul>

                </nav>

            }

        </div>

    </div>

</div>

<!-- Thanh trượt ngang linh hoạt nổi ở đáy màn hình khi xem giữa bảng -->
<div id="fdiDynamicScrollbar" title="Kéo để xem các cột thông tin bên phải">
    <div id="fdiDynamicScrollbarTrack" style="height: 1px; min-height: 1px; line-height: 1px; font-size: 1px;">&nbsp;</div>
</div>



