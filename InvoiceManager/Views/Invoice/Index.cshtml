@model InvoiceManager.Models.ViewModels.InvoiceIndexViewModel
@{
    ViewData["Title"] = "Quản lý Hóa đơn & Kế toán";
    var filter = Model.Filter;
    var summary = Model.Summary;

    // Đếm số lượng tiêu chí lọc đang được kích hoạt
    int activeFilterCount = 0;
    if (!string.IsNullOrEmpty(filter.FileDownloadStatus)) activeFilterCount++;
    if (!string.IsNullOrEmpty(filter.TemplateType)) activeFilterCount++;
    if (!string.IsNullOrEmpty(filter.InvoiceSymbol)) activeFilterCount++;
    if (!string.IsNullOrEmpty(filter.InvoiceNumber)) activeFilterCount++;
    if (!string.IsNullOrEmpty(filter.SellerName)) activeFilterCount++;
    if (!string.IsNullOrEmpty(filter.SellerTaxCode)) activeFilterCount++;
    if (!string.IsNullOrEmpty(filter.Status)) activeFilterCount++;
    if (!string.IsNullOrEmpty(filter.ValidationResult)) activeFilterCount++;
    if (filter.MinAmount.HasValue || filter.MaxAmount.HasValue) activeFilterCount++;
    if (filter.IsReconciled.HasValue) activeFilterCount++;
}

<div class="d-flex flex-column gap-3">
    <!-- 1. Thanh Tổng hợp Số liệu Thông Minh (Executive Financial & Volume Hub) -->
    <div class="row g-3 align-items-stretch">
        <!-- Khối 1: Tổng quan Nghiệp vụ Hóa đơn (Volume & Type Hub) -->
        <div class="col-12 col-xl-5">
            <div class="summary-hub-card h-100">
                <!-- Top: Header + Hero Count + Sync Status -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <div class="d-flex align-items-center gap-3">
                        <div class="hub-icon-badge bg-primary-subtle text-primary">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>
                        <div>
                            <div class="hub-title">Tổng số hóa đơn</div>
                            <div class="d-flex align-items-baseline gap-2">
                                <span class="hub-hero-value cursor-pointer" onclick="quickFilterTaxType('all')" title="Xem tất cả hóa đơn">
                                    @summary.TotalCount.ToString("N0")
                                </span>
                                <span class="hub-subtext">hóa đơn trong kỳ lọc</span>
                            </div>
                        </div>
                    </div>

                    <!-- Sync badge Hangfire -->
                    <div class="sync-pill" title="Hệ thống tự động quét và đồng bộ dữ liệu qua Hangfire">
                        <span class="sync-dot"></span>
                        <span class="sync-text">
                            <i class="bi bi-clock-history me-1 text-info"></i>
                            @(summary.LastSyncedAt.HasValue ? summary.LastSyncedAt.Value.ToString("dd/MM HH:mm") : "Chưa đồng bộ")
                        </span>
                    </div>
                </div>

                <!-- Bottom: 3 Phân loại hóa đơn tương tác -->
                <div class="hub-breakdown-grid">
                    <!-- Có mã CQT -->
                    <div class="mini-stat-item has-tax-code @(filter.HasTaxCode == true && filter.IsCashRegister != true ? "active" : "")" onclick="quickFilterTaxType('with_tax_code')" role="button" title="Lọc hóa đơn có mã CQT">
                        <div class="mini-stat-header">
                            <i class="bi bi-patch-check-fill text-success"></i>
                            <span>Có mã CQT</span>
                        </div>
                        <div class="mini-stat-value text-success">@summary.WithTaxCodeCount.ToString("N0")</div>
                        <div class="mini-stat-desc">Có mã cơ quan thuế</div>
                    </div>

                    <!-- Không mã CQT -->
                    <div class="mini-stat-item no-tax-code @(filter.HasTaxCode == false ? "active" : "")" onclick="quickFilterTaxType('without_tax_code')" role="button" title="Lọc hóa đơn không mã CQT">
                        <div class="mini-stat-header">
                            <i class="bi bi-shield-x text-secondary"></i>
                            <span>Không mã CQT</span>
                        </div>
                        <div class="mini-stat-value text-secondary">@summary.WithoutTaxCodeCount.ToString("N0")</div>
                        <div class="mini-stat-desc">HĐ không mã CQT</div>
                    </div>

                    <!-- Máy tính tiền -->
                    <div class="mini-stat-item cash-register @(filter.IsCashRegister == true ? "active" : "")" onclick="quickFilterTaxType('cash_register')" role="button" title="Lọc hóa đơn từ Máy tính tiền">
                        <div class="mini-stat-header">
                            <i class="bi bi-calculator-fill text-warning"></i>
                            <span>Máy tính tiền</span>
                        </div>
                        <div class="mini-stat-value text-warning">@summary.CashRegisterCount.ToString("N0")</div>
                        <div class="mini-stat-desc">Khởi tạo từ MTT</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Khối 2: Tổng hợp Dòng tiền & Nghĩa vụ Thuế (Financial Highlights) -->
        <div class="col-12 col-xl-7">
            <div class="row g-2 h-100">
                <!-- Chưa thuế -->
                <div class="col-12 col-sm-4">
                    <div class="financial-card h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="financial-label">Chưa thuế</span>
                            <div class="financial-icon-badge bg-light text-secondary border">
                                <i class="bi bi-box-seam"></i>
                            </div>
                        </div>
                        <div class="financial-value text-dark">
                            @summary.TotalAmountBeforeTax.ToString("N0") <span class="currency">đ</span>
                        </div>
                        <div class="financial-subtext text-muted">
                            <i class="bi bi-receipt me-1 text-muted"></i>Tổng tiền hàng
                        </div>
                    </div>
                </div>

                <!-- Tiền thuế GTGT -->
                <div class="col-12 col-sm-4">
                    <div class="financial-card h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="financial-label">Tiền thuế GTGT</span>
                            <div class="financial-icon-badge bg-danger-subtle text-danger border border-danger-subtle">
                                <i class="bi bi-percent"></i>
                            </div>
                        </div>
                        <div class="financial-value text-danger">
                            @summary.TotalTaxAmount.ToString("N0") <span class="currency">đ</span>
                        </div>
                        <div class="financial-subtext text-muted">
                            <i class="bi bi-shield-check me-1 text-success"></i>Thuế GTGT khấu trừ
                        </div>
                    </div>
                </div>

                <!-- Tổng thanh toán (Hero Card) -->
                <div class="col-12 col-sm-4">
                    <div class="financial-card hero-card h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="financial-label text-primary fw-bold">Tổng thanh toán</span>
                            <div class="financial-icon-badge bg-primary text-white shadow-sm">
                                <i class="bi bi-wallet2"></i>
                            </div>
                        </div>
                        <div class="financial-value text-primary">
                            @summary.TotalAmount.ToString("N0") <span class="currency text-primary">đ</span>
                        </div>
                        <div class="financial-subtext text-primary" style="font-weight: 500;">
                            <i class="bi bi-check2-circle me-1 text-primary"></i>Tổng tiền đã gồm thuế
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Thanh Công Cụ & Bộ Lọc Nghiệp Vụ -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-3">
            <form id="filterForm" asp-controller="Invoice" asp-action="Index" method="get">
                <input type="hidden" name="InvoiceType" id="inputInvoiceType" value="@filter.InvoiceType" />
                <input type="hidden" name="QuickDateRange" id="inputQuickDateRange" value="@filter.QuickDateRange" />
                <input type="hidden" name="SortBy" id="inputSortBy" value="@filter.SortBy" />
                <input type="hidden" name="Page" id="inputPage" value="1" />
                <input type="hidden" name="FileDownloadStatus" value="@filter.FileDownloadStatus" />
                <input type="hidden" name="TemplateType" value="@filter.TemplateType" />
                <input type="hidden" name="InvoiceSymbol" value="@filter.InvoiceSymbol" />
                <input type="hidden" name="InvoiceNumber" value="@filter.InvoiceNumber" />
                <input type="hidden" name="SellerName" value="@filter.SellerName" />
                <input type="hidden" name="SellerTaxCode" value="@filter.SellerTaxCode" />
                <input type="hidden" name="ValidationResult" value="@filter.ValidationResult" />
                <input type="hidden" name="Status" value="@filter.Status" />
                <input type="hidden" name="MinAmount" value="@filter.MinAmount" />
                <input type="hidden" name="MaxAmount" value="@filter.MaxAmount" />
                <input type="hidden" name="IsReconciled" value="@filter.IsReconciled" />
                <input type="hidden" name="IsCashRegister" id="inputIsCashRegister" value="@(filter.IsCashRegister.HasValue ? filter.IsCashRegister.Value.ToString().ToLower() : "")" />

                <!-- Row 1: Tab Loại HĐ & Quick Actions -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom">
                    <!-- Tabs Mua vào / Bán ra -->
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-sm px-3 fw-bold @(filter.InvoiceType == "MuaVao" ? "btn-primary" : "btn-outline-secondary")" onclick="switchInvoiceType('MuaVao')">
                            <i class="bi bi-box-arrow-in-down me-1"></i> Hóa đơn Mua vào
                        </button>
                        <button type="button" class="btn btn-sm px-3 fw-bold @(filter.InvoiceType == "BanRa" ? "btn-primary" : "btn-outline-secondary")" onclick="switchInvoiceType('BanRa')">
                            <i class="bi bi-box-arrow-up me-1"></i> Hóa đơn Bán ra
                        </button>
                    </div>

                    <!-- Right Quick Actions: Bộ lọc chuyên sâu, Đồng bộ, Nhập XML, Tải PDF Hàng loạt, Xuất file -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- Nút Mở Drawer Bộ Lọc (Khớp ảnh tham khảo) -->
                        <button type="button" class="btn btn-outline-primary btn-sm fw-semibold position-relative" data-bs-toggle="offcanvas" data-bs-target="#offcanvasFilter">
                            <i class="bi bi-funnel me-1"></i> Bộ lọc
                            @if (activeFilterCount > 0)
                            {
                                <span class="badge bg-danger rounded-pill ms-1">@activeFilterCount</span>
                            }
                        </button>

                        <!-- Nút Tải PDF gốc hàng loạt trực tiếp -->
                        <button type="button" class="btn btn-danger btn-sm fw-semibold" onclick="triggerBatchPdfZip()" title="Tải toàn bộ file PDF gốc các hóa đơn đang chọn hoặc đang lọc (.zip)">
                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Tải PDF gốc (.zip)
                        </button>

                        <!-- Nút Đồng bộ -->
                        <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" onclick="openImportModal('tab-remote-btn')">
                            <i class="bi bi-arrow-repeat me-1"></i> Đồng bộ
                        </button>

                        <!-- Nút Nhập XML / ZIP -->
                        <button type="button" class="btn btn-outline-success btn-sm fw-semibold" onclick="openImportModal('tab-upload-btn')">
                            <i class="bi bi-cloud-arrow-up me-1"></i> Nhập XML/ZIP
                        </button>

                        <!-- Nút Xóa Hàng Loạt (chỉ hiện khi có chọn checkbox) -->
                        <button type="button" class="btn btn-outline-danger btn-sm fw-semibold d-none" id="btnDeleteSelected" onclick="deleteSelectedInvoices()">
                            <i class="bi bi-trash me-1"></i> Xóa đã chọn (<span id="selectedCount">0</span>)
                        </button>

                        <!-- Nút Xuất Báo Cáo & File Hàng Loạt -->
                        <div class="dropdown">
                            <button class="btn btn-primary btn-sm dropdown-toggle fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-download me-1"></i> Xuất dữ liệu
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <button type="button" class="dropdown-item py-2 fw-semibold text-danger" onclick="triggerBatchPdfZip()">
                                        <i class="bi bi-file-earmark-pdf-fill me-2"></i> Tải PDF gốc hàng loạt (.zip)
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item py-2" onclick="triggerBatchZip()">
                                        <i class="bi bi-file-earmark-zip text-primary me-2"></i> Tải file ZIP Bản thể hiện & XML
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item py-2" onclick="triggerExport('ExcelDetailed')">
                                        <i class="bi bi-file-earmark-spreadsheet text-success me-2"></i> Xuất Excel Chi tiết (dòng hàng)
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item py-2" onclick="triggerExport('ExcelSummary')">
                                        <i class="bi bi-file-earmark-excel text-success me-2"></i> Xuất Excel Tổng hợp theo HĐ
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Row 2: Bộ lọc ngày & Tìm kiếm nhanh -->
                <div class="row g-2 align-items-center">
                    <!-- Quick Date Range Buttons -->
                    <div class="col-auto">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn @(filter.QuickDateRange == "today" ? "btn-secondary" : "btn-outline-secondary")" onclick="setQuickDate('today')">Hôm nay</button>
                            <button type="button" class="btn @(filter.QuickDateRange == "thisMonth" ? "btn-secondary" : "btn-outline-secondary")" onclick="setQuickDate('thisMonth')">Tháng này</button>
                            <button type="button" class="btn @(filter.QuickDateRange == "lastMonth" ? "btn-secondary" : "btn-outline-secondary")" onclick="setQuickDate('lastMonth')">Tháng trước</button>
                            <button type="button" class="btn @(filter.QuickDateRange == "thisQuarter" ? "btn-secondary" : "btn-outline-secondary")" onclick="setQuickDate('thisQuarter')">Quý này</button>
                            <button type="button" class="btn @(filter.QuickDateRange == "thisYear" ? "btn-secondary" : "btn-outline-secondary")" onclick="setQuickDate('thisYear')">Năm nay</button>
                        </div>
                    </div>

                    <!-- Custom Date Range -->
                    <div class="col-auto d-flex align-items-center gap-1">
                        <input type="date" name="FromDate" class="form-control form-control-sm" style="width: 135px;" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" title="Từ ngày lập" />
                        <span class="text-muted">-</span>
                        <input type="date" name="ToDate" class="form-control form-control-sm" style="width: 135px;" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" title="Đến ngày lập" />
                    </div>

                    <!-- Keyword Search Input -->
                    <div class="col">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="Keyword" class="form-control" placeholder="Tìm nhanh theo Ký hiệu, Số HĐ, Tên hoặc MST người bán..." value="@filter.Keyword" />
                        </div>
                    </div>

                    <!-- Submit & Filter Actions -->
                    <div class="col-auto d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="offcanvas" data-bs-target="#offcanvasFilter" title="Mở bộ lọc nâng cao bên trái">
                            <i class="bi bi-sliders"></i> Lọc chi tiết
                        </button>
                        @if (activeFilterCount > 0 || !string.IsNullOrEmpty(filter.Keyword))
                        {
                            <a asp-action="Index" class="btn btn-outline-danger btn-sm" title="Xóa toàn bộ bộ lọc">
                                <i class="bi bi-x-circle"></i> Đặt lại
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Hidden Form for Sync Now -->
    <form id="formSyncNow" asp-controller="Invoice" asp-action="SyncNow" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <!-- Hidden Form for Batch ZIP export (HTML & XML) -->
    <form id="formBatchZip" asp-controller="Export" asp-action="BatchZip" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="InvoiceType" value="@filter.InvoiceType" />
        <input type="hidden" name="FromDate" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="ToDate" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="Keyword" value="@filter.Keyword" />
        <input type="hidden" name="SellerTaxCode" value="@filter.SellerTaxCode" />
        <input type="hidden" name="SellerName" value="@filter.SellerName" />
        <input type="hidden" name="InvoiceSymbol" value="@filter.InvoiceSymbol" />
        <input type="hidden" name="InvoiceNumber" value="@filter.InvoiceNumber" />
        <input type="hidden" name="TemplateType" value="@filter.TemplateType" />
        <input type="hidden" name="FileDownloadStatus" value="@filter.FileDownloadStatus" />
        <input type="hidden" name="ValidationResult" value="@filter.ValidationResult" />
        <input type="hidden" name="Status" value="@filter.Status" />
        <input type="hidden" name="MinAmount" value="@filter.MinAmount" />
        <input type="hidden" name="MaxAmount" value="@filter.MaxAmount" />
        <input type="hidden" name="IsReconciled" value="@filter.IsReconciled" />
        <div id="selectedIdsContainer"></div>
    </form>

    <!-- Hidden Form for Batch PDF ZIP export (File PDF gốc hàng loạt) -->
    <form id="formBatchPdfZip" asp-controller="Export" asp-action="BatchPdfZip" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="InvoiceType" value="@filter.InvoiceType" />
        <input type="hidden" name="FromDate" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="ToDate" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="Keyword" value="@filter.Keyword" />
        <input type="hidden" name="SellerTaxCode" value="@filter.SellerTaxCode" />
        <input type="hidden" name="SellerName" value="@filter.SellerName" />
        <input type="hidden" name="InvoiceSymbol" value="@filter.InvoiceSymbol" />
        <input type="hidden" name="InvoiceNumber" value="@filter.InvoiceNumber" />
        <input type="hidden" name="TemplateType" value="@filter.TemplateType" />
        <input type="hidden" name="FileDownloadStatus" value="@filter.FileDownloadStatus" />
        <input type="hidden" name="ValidationResult" value="@filter.ValidationResult" />
        <input type="hidden" name="Status" value="@filter.Status" />
        <input type="hidden" name="MinAmount" value="@filter.MinAmount" />
        <input type="hidden" name="MaxAmount" value="@filter.MaxAmount" />
        <input type="hidden" name="IsReconciled" value="@filter.IsReconciled" />
        <div id="selectedPdfIdsContainer"></div>
    </form>

    <!-- 3. Bảng Danh Sách Hóa Đơn Điện Tử (Bám sát layout tham khảo) -->
    <div class="table-responsive table-invoice">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 40px;" class="text-center">
                        <input type="checkbox" id="selectAll" class="form-check-input" />
                    </th>
                    <th style="width: 50px;" class="text-center">STT</th>
                    <th style="width: 110px;">Ký hiệu</th>
                    <th style="width: 100px;">Số HĐ</th>
                    <th style="width: 110px;">Ngày lập</th>
                    <th>Thông tin người bán</th>
                    <th class="text-end" style="width: 130px;">Chưa thuế</th>
                    <th class="text-end" style="width: 120px;">Tiền thuế</th>
                    <th class="text-end" style="width: 140px;">Thanh toán</th>
                    <th class="text-center" style="width: 120px;">Trạng thái</th>
                    <th class="text-center" style="width: 110px;">Ghi sổ</th>
                    <th class="text-center" style="width: 120px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Invoices.Any())
                {
                    int stt = (Model.CurrentPage - 1) * Model.Filter.PageSize + 1;
                    foreach (var inv in Model.Invoices)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input row-select" value="@inv.Id" />
                            </td>
                            <td class="text-center text-muted">@stt</td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@inv.InvoiceSymbol</span>
                                @if (inv.IsCashRegister)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle" title="Khởi tạo từ máy tính tiền" style="font-size: 0.65rem;">MTT</span>
                                }
                                @if (inv.SourceProvider == "ManualExcel")
                                {
                                    <span class="badge bg-warning text-dark border border-warning-subtle" title="Hóa đơn nhập tay từ file Excel (Không có file XML gốc)" style="font-size: 0.65rem;"><i class="bi bi-file-earmark-excel text-success me-1"></i>Excel</span>
                                }
                            </td>
                            <td>
                                <strong class="text-primary font-monospace">@inv.InvoiceNumber</strong>
                            </td>
                            <td>
                                <div class="small fw-medium">@inv.IssueDate.ToString("dd/MM/yyyy")</div>
                                <div class="text-muted" style="font-size: 0.7rem;">@inv.IssueDate.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-secondary-subtle text-secondary font-monospace" style="font-size: 0.725rem;">MST: @inv.SellerTaxCode</span>
                                    @if (inv.HasTaxCode)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.65rem;" title="Hóa đơn có mã CQT: @inv.TaxAuthorityCode">Có mã</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border" style="font-size: 0.65rem;">Không mã</span>
                                    }
                                </div>
                                <div class="fw-semibold text-truncate" style="max-width: 320px;" title="@inv.SellerName">
                                    @inv.SellerName
                                </div>
                                @if (!string.IsNullOrEmpty(inv.RiskReason))
                                {
                                    <div class="text-danger small" style="font-size: 0.7rem;"><i class="bi bi-exclamation-circle"></i> @inv.RiskReason</div>
                                }
                            </td>
                            <td class="text-end font-monospace">
                                @inv.AmountBeforeTax.ToString("N0") <span class="text-muted" style="font-size: 0.7rem;">đ</span>
                            </td>
                            <td class="text-end font-monospace text-danger">
                                @inv.TaxAmount.ToString("N0") <span class="text-muted" style="font-size: 0.7rem;">đ</span>
                            </td>
                            <td class="text-end font-monospace">
                                <strong class="text-primary">@inv.TotalAmount.ToString("N0")</strong> <span class="text-muted" style="font-size: 0.7rem;">đ</span>
                            </td>
                            <td class="text-center">
                                @if (inv.Status == "Hóa đơn mới")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Hóa đơn mới</span>
                                }
                                else if (inv.Status == "Đã điều chỉnh")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Đã điều chỉnh</span>
                                }
                                else if (inv.Status == "Đã thay thế")
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">Đã thay thế</span>
                                }
                                else if (inv.Status == "Đã bị hủy")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã bị hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@inv.Status</span>
                                }
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm p-1 border-0" onclick="toggleReconciliation(@inv.Id)" title="Nhấp để đổi trạng thái vào sổ kế toán">
                                    @if (inv.IsReconciled)
                                    {
                                        <span class="badge bg-primary text-white" id="reconcile-badge-@inv.Id">
                                            <i class="bi bi-check2-circle"></i> Đã vào sổ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border" id="reconcile-badge-@inv.Id">
                                            Chưa ghi sổ
                                        </span>
                                    }
                                </button>
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1">
                                    <!-- Tải file PDF gốc trực tiếp -->
                                    <a href="/Export/DownloadPdf/@inv.Id" class="btn-action-icon" title="Tải file PDF hóa đơn gốc" download>
                                        <i class="bi bi-file-earmark-pdf text-danger"></i>
                                    </a>
                                    <!-- Xem bản thể hiện PDF / HTML -->
                                    <button type="button" class="btn-action-icon" title="Xem bản thể hiện hóa đơn" onclick="openInvoiceModal(@inv.Id)">
                                        <i class="bi bi-file-earmark-text text-primary"></i>
                                    </button>
                                    <!-- Xem XML gốc -->
                                    <a asp-action="ViewRawXml" asp-route-id="@inv.Id" target="_blank" class="btn-action-icon" title="Xem file XML gốc">
                                        <i class="bi bi-file-earmark-code text-secondary"></i>
                                    </a>
                                    <!-- Tải HTML mẫu trực tiếp -->
                                    <a asp-action="ViewHtml" asp-route-id="@inv.Id" target="_blank" class="btn-action-icon" title="Mở bản thể hiện ra tab mới">
                                        <i class="bi bi-box-arrow-up-right text-info"></i>
                                    </a>
                                    <!-- Xóa hóa đơn -->
                                    <button type="button" class="btn-action-icon text-danger" title="Xóa hóa đơn này" onclick="deleteSingleInvoice(@inv.Id, '@inv.InvoiceSymbol', '@inv.InvoiceNumber')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12" class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                            <div class="mt-2 text-muted fw-semibold">Không tìm thấy hóa đơn nào phù hợp với bộ lọc hiện tại.</div>
                            <div class="small text-muted">Vui lòng thử mở rộng khoảng ngày hoặc bấm <a asp-action="Index" class="text-primary">Xóa bộ lọc</a>.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 4. Phân Trang & Thống Kê Số Lượng Dòng -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2">
        <div class="small text-muted">
            Hiển thị <strong>@Model.Invoices.Count</strong> trên tổng số <strong>@Model.TotalItems.ToString("N0")</strong> hóa đơn
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang hóa đơn">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <button type="button" class="page-link" onclick="goToPage(1)"><i class="bi bi-chevron-double-left"></i></button>
                    </li>
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <button type="button" class="page-link" onclick="goToPage(@(Model.CurrentPage - 1))"><i class="bi bi-chevron-left"></i></button>
                    </li>

                    @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <button type="button" class="page-link" onclick="goToPage(@p)">@p</button>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <button type="button" class="page-link" onclick="goToPage(@(Model.CurrentPage + 1))"><i class="bi bi-chevron-right"></i></button>
                    </li>
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <button type="button" class="page-link" onclick="goToPage(@Model.TotalPages)"><i class="bi bi-chevron-double-right"></i></button>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

    <!-- Floating Bulk Action Bar (Thao tác hàng loạt khi chọn checkbox) -->
    <div id="bulkActionBar" class="card shadow-lg border-primary position-fixed bottom-0 start-50 translate-middle-x mb-4 d-none" style="z-index: 1050; min-width: 480px; border-radius: 12px; background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(8px); box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);">
        <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary fs-6 px-2 py-1" id="bulkSelectedCount">0</span>
                <span class="fw-semibold text-dark small">hóa đơn đã chọn</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <!-- Tải file PDF gốc hàng loạt -->
                <button type="button" class="btn btn-danger btn-sm fw-semibold shadow-sm" onclick="triggerBatchPdfZip()">
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Tải PDF gốc (.zip)
                </button>
                <!-- Tải bản thể hiện & XML hàng loạt -->
                <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" onclick="triggerBatchZip()">
                    <i class="bi bi-file-earmark-zip me-1"></i> Tải XML/HTML (.zip)
                </button>
                <!-- Nút bỏ chọn -->
                <button type="button" class="btn btn-light btn-sm text-secondary" onclick="clearAllSelections()">
                    Bỏ chọn
                </button>
            </div>
        </div>
    </div>

<!-- Offcanvas Bộ Lọc Nghiệp Vụ Chuẩn Ảnh Giao Diện Tham Khảo -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasFilter" aria-labelledby="offcanvasFilterLabel" style="width: 380px;">
    <div class="offcanvas-header border-bottom py-3">
        <h5 class="offcanvas-title fw-bold text-dark fs-5" id="offcanvasFilterLabel">
            <i class="bi bi-funnel text-primary me-2"></i>Bộ lọc
        </h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-3">
        <form id="drawerFilterForm" asp-controller="Invoice" asp-action="Index" method="get">
            <input type="hidden" name="InvoiceType" value="@filter.InvoiceType" />
            <input type="hidden" name="SortBy" value="@filter.SortBy" />
            <input type="hidden" name="Page" value="1" />

            <!-- 1. Trạng thái tải file -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Trạng thái tải file</label>
                <select name="FileDownloadStatus" class="form-select form-select-sm">
                    <option value="">Chọn trạng thái tải file</option>
                    <option value="HasPdf" selected="@(filter.FileDownloadStatus == "HasPdf")">Đã tải PDF gốc</option>
                    <option value="MissingPdf" selected="@(filter.FileDownloadStatus == "MissingPdf")">Chưa tải PDF</option>
                    <option value="HasXml" selected="@(filter.FileDownloadStatus == "HasXml")">Đã tải XML gốc</option>
                    <option value="MissingXml" selected="@(filter.FileDownloadStatus == "MissingXml")">Chưa tải XML</option>
                    <option value="HasBoth" selected="@(filter.FileDownloadStatus == "HasBoth")">Đã tải đủ PDF & XML</option>
                </select>
            </div>

            <!-- 2. Ký hiệu mẫu số hóa đơn -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Ký hiệu mẫu số hóa đơn</label>
                <select name="TemplateType" class="form-select form-select-sm">
                    <option value="">Chọn ký hiệu mẫu số hóa đơn</option>
                    <option value="1" selected="@(filter.TemplateType == "1")">1 - Hóa đơn GTGT</option>
                    <option value="2" selected="@(filter.TemplateType == "2")">2 - Hóa đơn bán hàng</option>
                    <option value="3" selected="@(filter.TemplateType == "3")">3 - Hóa đơn bán tài sản công</option>
                    <option value="4" selected="@(filter.TemplateType == "4")">4 - Hóa đơn bán hàng dự trữ quốc gia</option>
                    <option value="5" selected="@(filter.TemplateType == "5")">5 - Hóa đơn khác (tem, vé, thẻ...)</option>
                    <option value="6" selected="@(filter.TemplateType == "6")">6 - Chứng từ thu phí, lệ phí</option>
                </select>
            </div>

            <!-- 3. Ký hiệu hóa đơn -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Ký hiệu hóa đơn</label>
                <input type="text" name="InvoiceSymbol" class="form-control form-control-sm font-monospace" placeholder="C25TTP" value="@filter.InvoiceSymbol" />
            </div>

            <!-- 4. Số hóa đơn -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Số hóa đơn</label>
                <input type="text" name="InvoiceNumber" class="form-control form-control-sm font-monospace" placeholder="2835" value="@filter.InvoiceNumber" />
            </div>

            <!-- 5. Tên người bán -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Tên người bán</label>
                <input type="text" name="SellerName" class="form-control form-control-sm" placeholder="Công ty TNHH ABC" value="@filter.SellerName" />
            </div>

            <!-- 6. MST người bán -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">MST người bán</label>
                <input type="text" name="SellerTaxCode" class="form-control form-control-sm font-monospace" placeholder="0309587979" value="@filter.SellerTaxCode" />
            </div>

            <!-- 7. Trạng thái hóa đơn -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Trạng thái hóa đơn</label>
                <select name="Status" class="form-select form-select-sm">
                    <option value="">Chọn trạng thái hóa đơn</option>
                    <option value="Hóa đơn mới" selected="@(filter.Status == "Hóa đơn mới")">Hóa đơn mới</option>
                    <option value="Đã thay thế" selected="@(filter.Status == "Đã thay thế")">Đã thay thế</option>
                    <option value="Đã điều chỉnh" selected="@(filter.Status == "Đã điều chỉnh")">Đã điều chỉnh</option>
                    <option value="Đã bị hủy" selected="@(filter.Status == "Đã bị hủy")">Đã bị hủy</option>
                </select>
            </div>

            <!-- 8. Kết quả kiểm tra -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Kết quả kiểm tra</label>
                <select name="ValidationResult" class="form-select form-select-sm">
                    <option value="">Chọn kết quả kiểm tra</option>
                    <option value="Normal" selected="@(filter.ValidationResult == "Normal")">Hợp lệ / Bình thường</option>
                    <option value="Warning" selected="@(filter.ValidationResult == "Warning")">Cảnh báo rủi ro</option>
                    <option value="HasTaxCode" selected="@(filter.ValidationResult == "HasTaxCode")">Có mã CQT</option>
                    <option value="NoTaxCode" selected="@(filter.ValidationResult == "NoTaxCode")">Không mã CQT</option>
                    <option value="CashRegister" selected="@(filter.ValidationResult == "CashRegister")">HĐ từ máy tính tiền</option>
                </select>
            </div>

            <!-- 9. Khoảng ngày lập hóa đơn -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Khoảng ngày lập</label>
                <div class="row g-2">
                    <div class="col-6">
                        <input type="date" name="FromDate" class="form-control form-control-sm" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" title="Từ ngày" />
                    </div>
                    <div class="col-6">
                        <input type="date" name="ToDate" class="form-control form-control-sm" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" title="Đến ngày" />
                    </div>
                </div>
            </div>

            <!-- 10. Khoảng tiền thanh toán -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Khoảng tiền thanh toán (VND)</label>
                <div class="row g-2">
                    <div class="col-6">
                        <input type="number" name="MinAmount" class="form-control form-control-sm" placeholder="Từ số tiền..." value="@filter.MinAmount" />
                    </div>
                    <div class="col-6">
                        <input type="number" name="MaxAmount" class="form-control form-control-sm" placeholder="Đến số tiền..." value="@filter.MaxAmount" />
                    </div>
                </div>
            </div>

            <!-- 11. Ghi sổ kế toán -->
            <div class="mb-4">
                <label class="form-label small fw-semibold text-secondary mb-1">Vào sổ kế toán</label>
                <select name="IsReconciled" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="true" selected="@(filter.IsReconciled == true)">Đã vào sổ</option>
                    <option value="false" selected="@(filter.IsReconciled == false)">Chưa vào sổ</option>
                </select>
            </div>
        </form>
    </div>
    <div class="offcanvas-footer p-3 border-top bg-light d-flex gap-2">
        <button type="button" class="btn btn-primary w-100 fw-semibold" onclick="$('#drawerFilterForm').submit()">
            <i class="bi bi-funnel me-1"></i> Áp dụng bộ lọc
        </button>
        <a href="/Invoice?InvoiceType=@filter.InvoiceType" class="btn btn-outline-secondary w-50">
            Đặt lại
        </a>
    </div>
</div>

<!-- Modal Xem Thể Hiện Hóa Đơn Điện Tử Chuẩn Việt Nam -->
<div class="modal fade" id="invoiceModal" tabindex="-1" aria-labelledby="invoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="invoiceModalLabel">
                    <i class="bi bi-receipt text-primary me-2"></i> Chi tiết Hóa đơn Điện tử
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" id="invoiceModalBody" style="min-height: 480px;">
                <div class="d-flex justify-content-center align-items-center h-100 py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light d-flex justify-content-between">
                <div id="invoiceModalFooterActions"></div>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Check all rows & Cập nhật thanh thao tác hàng loạt
        function updateBulkActionBar() {
            var count = $('.row-select:checked').length;
            $('#bulkSelectedCount').text(count);
            if (count > 0) {
                $('#bulkActionBar').removeClass('d-none');
            } else {
                $('#bulkActionBar').addClass('d-none');
            }
        }

        $('#selectAll').on('change', function() {
            $('.row-select').prop('checked', $(this).is(':checked'));
            updateBulkActionBar();
            updateSelectedCount();
        });

        $(document).on('change', '.row-select', function() {
            updateBulkActionBar();
            updateSelectedCount();
            if (!$(this).is(':checked')) {
                $('#selectAll').prop('checked', false);
            } else if ($('.row-select:checked').length === $('.row-select').length) {
                $('#selectAll').prop('checked', true);
            }
        });

        function clearAllSelections() {
            $('.row-select, #selectAll').prop('checked', false);
            updateBulkActionBar();
            updateSelectedCount();
        }

        function updateSelectedCount() {
            var count = $('.row-select:checked').length;
            $('#selectedCount').text(count);
            if (count > 0) {
                $('#btnDeleteSelected').removeClass('d-none');
            } else {
                $('#btnDeleteSelected').addClass('d-none');
            }
        }

        // Xóa 1 hóa đơn
        function deleteSingleInvoice(id, symbol, number) {
            if (!confirm('Bạn có chắc chắn muốn xóa hóa đơn ' + symbol + '-' + number + ' khỏi hệ thống? Hành động này không thể hoàn tác!')) {
                return;
            }

            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '/Invoice/Delete',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: token
                },
                success: function(res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message || 'Lỗi khi xóa hóa đơn.');
                    }
                },
                error: function() {
                    alert('Lỗi hệ thống khi gửi yêu cầu xóa.');
                }
            });
        }

        // Xóa hàng loạt hóa đơn đã chọn
        function deleteSelectedInvoices() {
            var selectedIds = [];
            $('.row-select:checked').each(function() {
                selectedIds.push(parseInt($(this).val()));
            });

            if (selectedIds.length === 0) {
                alert('Vui lòng tích chọn ít nhất 1 hóa đơn để xóa.');
                return;
            }

            if (!confirm('CẢNH BÁO: Bạn có chắc chắn muốn xóa vĩnh viễn ' + selectedIds.length + ' hóa đơn đã chọn khỏi hệ thống?')) {
                return;
            }

            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '/Invoice/DeleteBatch',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    "RequestVerificationToken": token
                },
                data: JSON.stringify(selectedIds),
                success: function(res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message || 'Lỗi khi xóa hóa đơn hàng loạt.');
                    }
                },
                error: function() {
                    alert('Lỗi hệ thống khi xóa hàng loạt.');
                }
            });
        }

        // Quick date selection
        function setQuickDate(type) {
            $('#inputQuickDateRange').val(type);
            var now = new Date();
            var from = '';
            var to = '';

            if (type === 'today') {
                from = to = formatDate(now);
            } else if (type === 'thisMonth') {
                from = formatDate(new Date(now.getFullYear(), now.getMonth(), 1));
                to = formatDate(new Date(now.getFullYear(), now.getMonth() + 1, 0));
            } else if (type === 'lastMonth') {
                from = formatDate(new Date(now.getFullYear(), now.getMonth() - 1, 1));
                to = formatDate(new Date(now.getFullYear(), now.getMonth(), 0));
            } else if (type === 'thisQuarter') {
                var q = Math.floor(now.getMonth() / 3);
                from = formatDate(new Date(now.getFullYear(), q * 3, 1));
                to = formatDate(new Date(now.getFullYear(), (q + 1) * 3, 0));
            } else if (type === 'thisYear') {
                from = formatDate(new Date(now.getFullYear(), 0, 1));
                to = formatDate(new Date(now.getFullYear(), 11, 31));
            }

            $('input[name="FromDate"]').val(from);
            $('input[name="ToDate"]').val(to);
            $('#filterForm').submit();
        }

        function formatDate(d) {
            var month = '' + (d.getMonth() + 1),
                day = '' + d.getDate(),
                year = d.getFullYear();

            if (month.length < 2) month = '0' + month;
            if (day.length < 2) day = '0' + day;
            return [year, month, day].join('-');
        }

        function quickFilterTaxType(type) {
            if (type === 'all') {
                $('select[name="HasTaxCode"]').val('');
                $('#inputIsCashRegister').val('');
            } else if (type === 'with_tax_code') {
                $('select[name="HasTaxCode"]').val('true');
                $('#inputIsCashRegister').val('');
            } else if (type === 'without_tax_code') {
                $('select[name="HasTaxCode"]').val('false');
                $('#inputIsCashRegister').val('');
            } else if (type === 'cash_register') {
                $('select[name="HasTaxCode"]').val('');
                $('#inputIsCashRegister').val('true');
            }
            $('#inputPage').val(1);
            $('#filterForm').submit();
        }

        function switchInvoiceType(type) {
            $('#inputInvoiceType').val(type);
            $('#filterForm').submit();
        }

        function goToPage(page) {
            $('#inputPage').val(page);
            $('#filterForm').submit();
        }

        // Export trigger
        function triggerExport(actionName) {
            var params = $('#filterForm').serialize();
            window.location.href = '/Export/' + actionName + '?' + params;
        }

        // Xuất file ZIP XML & Bản thể hiện HTML
        function triggerBatchZip() {
            var selected = [];
            $('.row-select:checked').each(function() {
                selected.push($(this).val());
            });

            var container = $('#selectedIdsContainer');
            container.empty();

            if (selected.length > 0) {
                selected.forEach(function(id) {
                    container.append('<input type="hidden" name="selectedIds" value="' + id + '" />');
                });
            }

            $('#formBatchZip').submit();
        }

        // Tải File PDF Gốc Hàng Loạt (.zip)
        function triggerBatchPdfZip() {
            var selected = [];
            $('.row-select:checked').each(function() {
                selected.push($(this).val());
            });

            var container = $('#selectedPdfIdsContainer');
            container.empty();

            if (selected.length > 0) {
                selected.forEach(function(id) {
                    container.append('<input type="hidden" name="selectedIds" value="' + id + '" />');
                });
            }

            $('#formBatchPdfZip').submit();
        }

        // Open Invoice Detail Modal
        function openInvoiceModal(id) {
            $('#invoiceModal').modal('show');
            $('#invoiceModalBody').html('<div class="d-flex justify-content-center align-items-center py-5"><div class="spinner-border text-primary" role="status"></div></div>');

            $.get('/Invoice/Detail/' + id, function(html) {
                $('#invoiceModalBody').html(html);
                $('#invoiceModalFooterActions').html(
                    '<a href="/Export/DownloadPdf/' + id + '" target="_blank" class="btn btn-danger btn-sm" download><i class="bi bi-file-earmark-pdf-fill me-1"></i> Tải PDF gốc</a> ' +
                    '<a href="/Invoice/ViewHtml/' + id + '" target="_blank" class="btn btn-outline-primary btn-sm"><i class="bi bi-printer me-1"></i> In / Bản in gốc</a> ' +
                    '<a href="/Invoice/ViewRawXml/' + id + '" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="bi bi-filetype-xml me-1"></i> Tải XML gốc</a>'
                );
            }).fail(function() {
                $('#invoiceModalBody').html('<div class="alert alert-danger m-3">Không thể tải thông tin hóa đơn.</div>');
            });
        }

        // Toggle reconciliation
        function toggleReconciliation(id) {
            var refNo = prompt("Nhập số chứng từ kế toán nội bộ (Phiếu chi, UNC, v.v.):", "PC-" + new Date().toISOString().slice(0,10).replace(/-/g,''));
            if (refNo === null) return;

            $.post('/Invoice/ToggleReconciliation', {
                id: id,
                refNo: refNo,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(res) {
                if (res.success) {
                    var badge = $('#reconcile-badge-' + id);
                    if (res.isReconciled) {
                        badge.removeClass('bg-light text-muted border').addClass('bg-primary text-white').html('<i class="bi bi-check2-circle"></i> Đã vào sổ');
                    } else {
                        badge.removeClass('bg-primary text-white').addClass('bg-light text-muted border').html('Chưa ghi sổ');
                    }
                } else {
                    alert(res.message || 'Lỗi khi cập nhật trạng thái.');
                }
            });
        }

        // Mở Modal Nhập HĐ và tự động kích hoạt Tab mong muốn
        function openImportModal(tabButtonId) {
            var modalEl = document.getElementById('modalImportInvoice');
            if (!modalEl) return;
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            if (tabButtonId) {
                var btn = document.getElementById(tabButtonId);
                if (btn) {
                    var tab = new bootstrap.Tab(btn);
                    tab.show();
                }
            }
        }
    </script>
}

