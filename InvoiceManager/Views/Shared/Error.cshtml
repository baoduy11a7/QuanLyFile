@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi hệ thống";
}

<div class="container py-5">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <h5 class="mb-0">Đã xảy ra lỗi trong quá trình xử lý yêu cầu</h5>
        </div>
        <div class="card-body">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    <strong>Thông báo lỗi:</strong> @ViewBag.ErrorMessage
                    @if (ViewBag.ErrorPath != null)
                    {
                        <div class="small text-muted mt-1">Đường dẫn: <code>@ViewBag.ErrorPath</code></div>
                    }
                </div>
            }

            @if (Model.ShowRequestId)
            {
                <p class="text-muted small">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <div class="mt-4">
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm me-2">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại trang trước
                </a>
                <a href="/" class="btn btn-primary btn-sm">
                    <i class="bi bi-house me-1"></i> Về danh sách hóa đơn
                </a>
            </div>
        </div>
    </div>
</div>
