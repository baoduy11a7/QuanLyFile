@* 
    _SyncInvoiceModalPartial.cshtml
    Cửa sổ Đồng bộ hóa đơn tự động kết nối ngầm GOV (không yêu cầu nhập mật khẩu hay captcha)
    Thiết kế chuẩn theo giao diện FDI Accounting & hình ảnh người dùng yêu cầu
*@

<div class="modal fade" id="modalSyncInvoices" tabindex="-1" aria-labelledby="modalSyncInvoicesLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 860px;">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <!-- Modal Header -->
            <div class="modal-header border-bottom py-3 px-4 bg-white">
                <div>
                    <h5 class="modal-title fw-bold text-dark mb-1" id="modalSyncInvoicesLabel">Đồng bộ hóa đơn</h5>
                    <p class="text-muted small mb-0">Chọn khoảng thời gian cần đồng bộ từ hệ thống hóa đơn điện tử.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-4 py-3">
                @Html.AntiForgeryToken()
                <!-- Alert Box -->
                <div id="syncModalAlert" class="alert d-none py-2 px-3 small mb-3"></div>

                <!-- 1. Nhóm: Chọn đồng bộ hóa đơn mua vào / bán ra -->
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.95rem;">Chọn đồng bộ hóa đơn mua vào / bán ra</label>
                    <div class="d-flex flex-wrap gap-4 align-items-center">
                        <div class="form-check d-flex align-items-center gap-1.5 mb-0">
                            <input class="form-check-input sync-radio-teal" type="radio" name="syncInvoiceDirection" id="syncDirAll" value="All" checked>
                            <label class="form-check-label text-secondary small fw-medium" for="syncDirAll">
                                Đồng bộ tất cả
                            </label>
                        </div>
                        <div class="form-check d-flex align-items-center gap-1.5 mb-0">
                            <input class="form-check-input sync-radio-teal" type="radio" name="syncInvoiceDirection" id="syncDirSold" value="BanRa">
                            <label class="form-check-label text-secondary small fw-medium" for="syncDirSold">
                                Chỉ đồng bộ hóa đơn bán ra
                            </label>
                        </div>
                        <div class="form-check d-flex align-items-center gap-1.5 mb-0">
                            <input class="form-check-input sync-radio-teal" type="radio" name="syncInvoiceDirection" id="syncDirPurchase" value="MuaVao">
                            <label class="form-check-label text-secondary small fw-medium" for="syncDirPurchase">
                                Chỉ đồng bộ hoá đơn mua vào
                            </label>
                        </div>
                    </div>
                </div>

                <!-- 2. Nhóm: Chọn đồng bộ loại hoá đơn -->
                <div class="mb-3.5">
                    <label class="form-label fw-bold text-dark mb-2" style="font-size: 0.95rem;">Chọn đồng bộ loại hoá đơn</label>
                    <div class="d-flex flex-wrap gap-4 align-items-center">
                        <div class="form-check d-flex align-items-center gap-1.5 mb-0">
                            <input class="form-check-input sync-radio-teal" type="radio" name="syncInvoiceCategory" id="syncCatAll" value="All" checked>
                            <label class="form-check-label text-secondary small fw-medium" for="syncCatAll">
                                Đồng bộ tất cả
                            </label>
                        </div>
                        <div class="form-check d-flex align-items-center gap-1.5 mb-0">
                            <input class="form-check-input sync-radio-teal" type="radio" name="syncInvoiceCategory" id="syncCatExcludeCash" value="NoCashRegister">
                            <label class="form-check-label text-secondary small fw-medium" for="syncCatExcludeCash">
                                Đồng bộ tất cả trừ hoá đơn máy tính tiền
                            </label>
                        </div>
                        <div class="form-check d-flex align-items-center gap-1.5 mb-0">
                            <input class="form-check-input sync-radio-teal" type="radio" name="syncInvoiceCategory" id="syncCatOnlyCash" value="OnlyCashRegister">
                            <label class="form-check-label text-secondary small fw-medium" for="syncCatOnlyCash">
                                Chỉ đồng bộ hoá đơn máy tính tiền
                            </label>
                        </div>
                    </div>
                </div>

                <!-- 3. Nhóm: Chọn ngày tháng năm đồng bộ (1 ô duy nhất, ngày trước tháng sau dd/MM/yyyy) -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1.5">
                        <label for="syncDateRange" class="form-label small fw-semibold text-secondary mb-0">
                            <i class="bi bi-calendar-range me-1 text-teal" style="color: #0d9488;"></i> Thời gian đồng bộ (Ngày trước - Tháng sau):
                        </label>
                        <div class="d-flex gap-1.5">
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0.5 px-2" onclick="setQuickDateRange('30days')" style="font-size: 0.76rem;">30 ngày gần đây</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0.5 px-2" onclick="setQuickDateRange('thisMonth')" style="font-size: 0.76rem;">Tháng này</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0.5 px-2" onclick="setQuickDateRange('prevMonth')" style="font-size: 0.76rem;">Tháng trước</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0.5 px-2" onclick="setQuickDateRange('thisQuarter')" style="font-size: 0.76rem;">Quý này</button>
                        </div>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-white" style="border-radius: 6px 0 0 6px; cursor: pointer;" onclick="$('#syncDateRange').focus()">
                            <i class="bi bi-calendar3" style="color: #0d9488;"></i>
                        </span>
                        <input type="text" class="form-control bg-white fw-semibold" id="syncDateRange" placeholder="Chọn ngày (ví dụ: 07/10/2026 đến 06/11/2026)" readonly style="cursor: pointer; border-radius: 0 6px 6px 0; color: #1e293b; font-size: 0.95rem;">
                        <input type="hidden" id="syncFromDate" value="" />
                        <input type="hidden" id="syncToDate" value="" />
                    </div>
                    <small class="text-muted" style="font-size: 0.76rem;">
                        <i class="bi bi-info-circle me-1"></i>Định dạng chuẩn <strong>Ngày / Tháng / Năm (dd/MM/yyyy)</strong>. Nhấn vào ô để chọn khoảng ngày hoặc 1 ngày cụ thể.
                    </small>
                </div>

                <!-- Live Sync Progress Box (hiển thị khi đang đồng bộ ngầm) -->
                <div id="syncLiveProgressBox" class="card border border-teal-subtle bg-light mb-3 d-none">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <div class="d-flex align-items-center gap-2">
                                <div class="spinner-border spinner-border-sm text-teal" id="syncLiveSpinner" style="color: #0d9488;" role="status"></div>
                                <i class="bi bi-check-circle-fill text-success fs-5 d-none" id="syncLiveSuccessIcon"></i>
                                <i class="bi bi-x-circle-fill text-danger fs-5 d-none" id="syncLiveErrorIcon"></i>
                                <span class="fw-semibold text-dark small" id="syncLiveStageText">Đang tự động kết nối Cổng Tổng cục Thuế...</span>
                            </div>
                            <span class="badge rounded-pill fw-bold" style="background-color: #0d9488;" id="syncLivePercentBadge">10%</span>
                        </div>
                        <div class="progress" style="height: 7px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" id="syncLiveProgressBar" style="width: 10%; background-color: #0d9488;" role="progressbar"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mt-1.5" style="font-size: 0.78rem;">
                            <span id="syncLiveStatsText">Tự động giải Captcha bằng AI OCR ngầm...</span>
                            <span id="syncLiveTimeText"></span>
                        </div>
                    </div>
                </div>

                <!-- 4. Lịch sử đồng bộ hóa đơn cho công ty -->
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">
                            Lịch sử đồng bộ hóa đơn cho công ty <span id="syncModalCompanyName" class="text-success fw-bold">...</span>
                        </h6>
                        <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-muted" onclick="loadSyncHistory(true)" title="Làm mới lịch sử">
                            <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
                        </button>
                    </div>

                    <div class="table-responsive border rounded" style="max-height: 240px; overflow-y: auto;">
                        <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.82rem;" id="tableSyncHistory">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="text-center py-2 px-1" style="width: 45px;">STT</th>
                                    <th class="py-2 px-2" style="width: 105px;">Đồng bộ từ ngày</th>
                                    <th class="py-2 px-2" style="width: 105px;">Đồng bộ đến ngày</th>
                                    <th class="text-center py-2 px-2" style="width: 95px;">Số lượng HĐ</th>
                                    <th class="text-center py-2 px-2" style="width: 110px;">Trạng thái</th>
                                    <th class="py-2 px-2" style="min-width: 180px;">Diễn giải từ Cổng Thuế</th>
                                    <th class="text-center py-2 px-2" style="width: 125px;">Ngày đồng bộ</th>
                                </tr>
                            </thead>
                            <tbody id="tbodySyncHistory">
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
                                        Đang tải lịch sử đồng bộ API Cổng Thuế...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer d-flex justify-content-between py-2.5 px-4 bg-white border-top">
                <!-- Nút xóa dữ liệu đã đồng bộ bên trái -->
                <button type="button" class="btn btn-danger fw-semibold px-3 py-1.5 d-flex align-items-center gap-1.5" onclick="confirmDeleteSyncData()" id="btnDeleteSyncData" style="background-color: #ef4444; border-color: #ef4444;">
                    <i class="bi bi-trash"></i> Xóa dữ liệu đã đồng bộ
                </button>

                <!-- Nút Hủy và Đồng bộ bên phải -->
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light border px-4 py-1.5 fw-medium text-secondary" data-bs-dismiss="modal" id="btnCancelSync">Hủy</button>
                    <button type="button" class="btn text-white fw-semibold px-4 py-1.5 d-flex align-items-center gap-1.5" style="background-color: #0d9488; border-color: #0d9488;" id="btnSubmitSyncGov" onclick="executeDirectGovSync()">
                        <i class="bi bi-arrow-repeat"></i> Đồng bộ
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Styling khớp hoàn hảo với hình ảnh thiết kế */
    .sync-radio-teal {
        accent-color: #0d9488 !important;
        width: 1.15em;
        height: 1.15em;
        cursor: pointer;
    }
    .sync-radio-teal:checked {
        background-color: #0d9488;
        border-color: #0d9488;
    }
    #modalSyncInvoices .form-check-label {
        cursor: pointer;
    }
    #tableSyncHistory thead th {
        font-weight: 600;
        color: #374151;
        white-space: nowrap;
        background-color: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
        padding: 6px 8px;
    }
    #tableSyncHistory tbody td {
        padding: 6px 8px;
        white-space: nowrap;
        vertical-align: middle;
    }
    #tableSyncHistory tbody td.cell-truncate {
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

