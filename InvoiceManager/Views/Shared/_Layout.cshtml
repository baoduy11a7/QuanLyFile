@inject InvoiceManager.Services.ITaxAccountContext TaxContext
@{
    var currentTaxAccount = await TaxContext.GetCurrentTaxAccountAsync();
    var accessibleAccounts = await TaxContext.GetAccessibleTaxAccountsAsync();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phần mềm kế toán | Hệ thống Quản lý Hóa đơn & Doanh nghiệp</title>
    
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-navy: #1e3a8a;
            --primary-blue: #2563eb;
            --accent-emerald: #059669;
            --accent-amber: #d97706;
            --border-color: #e2e8f0;
            --bg-light: #f8fafc;
            --text-dark: #0f172a;
            --text-muted: #64748b;
        }

        html, body {
            overflow-x: clip;
            width: 100%;
            max-width: 100vw;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #f1f5f9;
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding-top: 56px;
        }

        /* Top Navbar - Fixed Sticky Top Design */
        .tax-navbar {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--border-color);
            padding: 0 1rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1030;
            height: 56px;
            display: flex;
            align-items: center;
            width: 100%;
            box-sizing: border-box;
        }

        .tax-navbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            flex-wrap: nowrap;
            gap: 0.5rem;
            min-width: 0;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            white-space: nowrap;
            flex-shrink: 0;
            user-select: none;
        }

        .brand-icon-box {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
            flex-shrink: 0;
            transition: transform 0.15s ease;
        }

        .brand-logo:hover .brand-icon-box {
            transform: scale(1.04);
        }

        .brand-title {
            font-weight: 800;
            font-size: 0.95rem;
            color: var(--primary-navy);
            letter-spacing: -0.01em;
            line-height: 1.15;
            white-space: nowrap;
        }

        .brand-subtitle {
            font-size: 0.6rem;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            line-height: 1;
            margin-top: 1px;
        }

        /* Navigation links */
        .nav-pills-custom {
            display: flex;
            align-items: center;
            flex-wrap: nowrap;
            gap: 0.2rem;
            margin: 0;
            padding: 0;
            list-style: none;
            min-width: 0;
        }

        .nav-pills-custom .nav-link {
            color: #475569;
            font-weight: 600;
            font-size: 0.8125rem;
            padding: 0.35rem 0.55rem;
            border-radius: 7px;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            white-space: nowrap;
            transition: all 0.15s ease;
            border: 1px solid transparent;
        }

        .nav-pills-custom .nav-link:hover {
            background-color: #f1f5f9;
            color: var(--primary-blue);
        }

        .nav-pills-custom .nav-link.active {
            background-color: #eff6ff;
            color: var(--primary-blue);
            font-weight: 700;
            border-color: #bfdbfe;
            box-shadow: 0 1px 2px rgba(37, 99, 235, 0.05);
        }

        @@media (max-width: 1399px) {
            .nav-pills-custom .nav-link {
                padding: 0.3rem 0.45rem;
                font-size: 0.785rem;
                gap: 0.25rem;
            }
        }

        /* Dropdown chọn Công ty / Hộ kinh doanh theo mẫu FDI */
        .tax-selector-dropdown {
            min-width: 360px;
            max-width: 420px;
            border-radius: 8px;
            box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.15);
            border: 1px solid #e2e8f0;
            padding: 0;
            overflow: hidden;
        }

        .tax-company-badge {
            background-color: #f8fafc;
            color: #1e293b;
            border: 1px solid #cbd5e1;
            padding: 0.32rem 0.65rem;
            border-radius: 7px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
            flex-shrink: 0;
            max-width: 290px;
        }

        .tax-company-badge:hover {
            background-color: #eff6ff;
            border-color: #93c5fd;
        }

        .tax-badge-name {
            font-size: 0.785rem;
            font-weight: 700;
            color: #0f172a;
            line-height: 1.25;
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .company-dropdown-list {
            max-height: 290px;
            overflow-y: auto;
        }

        .company-dropdown-item {
            width: 100%;
            text-align: left;
            border: none;
            background: transparent;
            padding: 0.55rem 0.9rem;
            font-size: 0.8rem;
            font-weight: 600;
            color: #334155;
            transition: background-color 0.12s ease, color 0.12s ease;
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .company-dropdown-item:hover {
            background-color: #f1f5f9;
            color: #1d4ed8;
        }

        .company-dropdown-item.active {
            background-color: #dbeafe;
            color: #1d4ed8;
            font-weight: 700;
        }

        @@media (max-width: 1399px) {
            .tax-badge-name {
                max-width: 165px;
            }
        }

        @@media (max-width: 1199px) {
            .tax-badge-name {
                max-width: 120px;
                font-size: 0.75rem;
            }
            .tax-company-badge {
                padding: 0.25rem 0.45rem;
                gap: 0.35rem;
            }
        }

        .user-profile-btn {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            padding: 0.25rem 0.5rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            transition: all 0.2s ease;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .user-profile-btn:hover {
            background-color: #f8fafc;
            border-color: #94a3b8;
        }

        .user-avatar-circle {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
            flex-shrink: 0;
            box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25);
        }

        .user-profile-info {
            font-size: 0.785rem;
            line-height: 1.2;
            text-align: left;
        }

        .user-profile-name {
            font-weight: 600;
            color: #0f172a;
            max-width: 95px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ==========================================================================
           Modern Polished Dashboard Summary Cards
           ========================================================================== */
        .stat-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 0.9rem 1.1rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px -2px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .stat-label {
            font-size: 0.725rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.25rem;
            font-weight: 700;
        }

        .stat-value {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1.2;
            font-variant-numeric: tabular-nums;
        }

        .stat-value.primary { color: var(--primary-blue); }
        .stat-value.success { color: var(--accent-emerald); }
        .stat-value.warning { color: var(--accent-amber); }

        /* Summary Hub Card (Volume & Breakdown) */
        .summary-hub-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 1rem 1.25rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .summary-hub-card:hover {
            box-shadow: 0 6px 18px -4px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .hub-icon-badge {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
            border: 1px solid #bfdbfe;
        }

        .hub-title {
            font-size: 0.725rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        .hub-hero-value {
            font-size: 1.75rem;
            font-weight: 800;
            line-height: 1.1;
            font-variant-numeric: tabular-nums;
            color: var(--primary-navy);
            transition: color 0.15s;
        }

        .hub-hero-value:hover {
            color: var(--primary-blue);
        }

        .hub-subtext {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-weight: 500;
        }


        /* 3 Mini breakdown items */
        .hub-breakdown-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.5rem;
            margin-top: 0.75rem;
            padding-top: 0.75rem;
            border-top: 1px dashed #e2e8f0;
        }

        .mini-stat-item {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 0.5rem 0.65rem;
            transition: all 0.15s ease;
            text-decoration: none;
            color: inherit;
            display: block;
            cursor: pointer;
            user-select: none;
        }

        .mini-stat-item:hover {
            background: #ffffff;
            border-color: #cbd5e1;
            transform: translateY(-2px);
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05);
        }

        .mini-stat-item.active {
            background: #eff6ff !important;
            border-color: #93c5fd !important;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
        }

        .mini-stat-header {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.725rem;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 0.2rem;
            white-space: nowrap;
        }

        .mini-stat-value {
            font-size: 1.15rem;
            font-weight: 800;
            line-height: 1.2;
            font-variant-numeric: tabular-nums;
        }

        .mini-stat-desc {
            font-size: 0.675rem;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Financial cards */
        .financial-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 1rem 1.15rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .financial-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px -3px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .financial-card.ring-active {
            box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.35), 0 8px 18px -3px rgba(15, 23, 42, 0.08) !important;
        }

        .financial-label {
            font-size: 0.725rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        .financial-icon-badge {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .financial-value {
            font-size: 1.25rem;
            font-weight: 800;
            line-height: 1.25;
            margin: 0.4rem 0;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.01em;
        }

        .financial-value .currency {
            font-size: 0.8rem;
            font-weight: 600;
            opacity: 0.8;
            margin-left: 2px;
        }

        .financial-subtext {
            font-size: 0.725rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
            font-weight: 500;
        }

        /* Hero card: Tổng thanh toán */
        .financial-card.hero-card {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
            border: 1.5px solid #93c5fd;
            box-shadow: 0 3px 12px rgba(37, 99, 235, 0.1);
        }

        .financial-card.hero-card:hover {
            box-shadow: 0 10px 22px -3px rgba(37, 99, 235, 0.2);
            border-color: #60a5fa;
        }

        .financial-card.hero-card .financial-value {
            color: #1d4ed8;
            font-size: 1.35rem;
            font-weight: 800;
        }

        /* Placeholder & Search inputs styling: ensure clear guidance is never truncated */
        ::placeholder {
            font-size: 0.85rem !important;
            font-weight: 400 !important;
            color: #64748b !important;
            opacity: 0.85;
        }
        .input-group-lg .form-control::placeholder,
        .form-control-lg::placeholder {
            font-size: 0.875rem !important;
            font-weight: 400 !important;
        }
        .search-instruction-input {
            font-size: 0.925rem !important;
        }
        .search-instruction-input::placeholder {
            font-size: 0.875rem !important;
            font-weight: 400 !important;
        }

        /* Modern Table styling */
        .table-invoice {
            background: #ffffff;
            border-radius: 8px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border: 1px solid var(--border-color);
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            font-size: 0.875rem;
        }

        .table-invoice thead th,
        .table thead th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
            padding: 0.65rem 0.75rem;
            white-space: nowrap;
            vertical-align: middle;
            font-size: 0.8125rem;
            letter-spacing: 0.25px;
        }

        .table-invoice tbody td,
        .table tbody td {
            padding: 0.65rem 0.75rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .table-invoice tbody tr:hover,
        .table tbody tr:hover {
            background-color: #f8fafc;
        }

        .btn-action-icon {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            background: #ffffff;
            color: #475569;
            transition: all 0.15s;
            cursor: pointer;
        }
        .btn-action-icon:hover {
            background: #eff6ff;
            color: var(--primary-blue);
            border-color: #bfdbfe;
        }

        /* Mobile & Multi-Device Utilities */
        .btn-group-responsive {
            display: flex;
            overflow-x: auto;
            white-space: nowrap;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 2px;
            scrollbar-width: none;
            gap: 0.25rem;
        }
        .btn-group-responsive::-webkit-scrollbar {
            display: none;
        }

        #bulkActionBar {
            max-width: calc(100vw - 20px) !important;
            width: auto !important;
            min-width: 0 !important;
        }

        @@media (max-width: 767.98px) {
            .table-invoice {
                font-size: 0.8rem;
            }
            .table-invoice thead th,
            .table-invoice tbody td {
                padding: 0.45rem 0.55rem;
            }
            .stat-card,
            .summary-hub-card,
            .financial-card {
                padding: 0.75rem 0.85rem;
            }
            .hub-hero-value {
                font-size: 1.4rem;
            }
            .financial-value {
                font-size: 1.15rem;
            }
            .financial-icon-badge {
                width: 28px;
                height: 28px;
                font-size: 0.85rem;
            }
            .hub-breakdown-grid {
                gap: 0.35rem;
                margin-top: 0.5rem;
                padding-top: 0.5rem;
            }
            .mini-stat-item {
                padding: 0.35rem 0.4rem;
            }
            .mini-stat-desc {
                display: none;
            }
            #bulkActionBar .card-body {
                flex-direction: column;
                align-items: stretch !important;
                gap: 0.4rem !important;
                padding: 0.5rem 0.75rem !important;
            }
        }

        @@media (max-width: 575.98px) {
            body {
                padding-top: 52px;
            }
            .tax-navbar {
                padding: 0 0.5rem;
                height: 52px;
            }
            .brand-icon-box {
                width: 28px;
                height: 28px;
                font-size: 0.95rem;
            }
            .brand-title {
                font-size: 0.825rem;
            }
            .tax-company-badge {
                padding: 0.2rem 0.35rem;
                max-width: 145px;
            }
            .tax-badge-name {
                max-width: 95px;
                font-size: 0.7rem;
            }
            .user-profile-btn {
                padding: 0.2rem 0.35rem;
            }
            .user-avatar-circle {
                width: 25px;
                height: 25px;
                font-size: 0.7rem;
            }
        }

                /* Button Thêm công ty trong dropdown */
        .company-dropdown-btn-add {
            background-color: #1d64f2 !important;
            color: #ffffff !important;
            border: none !important;
            border-radius: 8px !important;
            font-size: 0.85rem !important;
            font-weight: 600 !important;
            transition: all 0.15s ease !important;
        }
        .company-dropdown-btn-add:hover {
            background-color: #1557d4 !important;
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(29, 100, 242, 0.25) !important;
        }
        .company-dropdown-btn-add:focus,
        .company-dropdown-btn-add:active,
        .company-dropdown-btn-add:focus-visible {
            outline: none !important;
            box-shadow: none !important;
        }

        /* Footer */
        footer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid var(--border-color);
            font-size: 0.8rem;
            color: var(--text-muted);
            padding: 0.85rem 0;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Header (Simple, Clean FDI Accounting Style) -->
    <header class="tax-navbar">
        <div class="tax-navbar-inner">
            <!-- Left: Logo & Simple Navigation -->
            <div class="d-flex align-items-center gap-3 min-w-0">
                <a class="brand-logo" href="/phan-mem-ke-toan" title="Phần mềm kế toán">
                    <div class="brand-icon-box">
                        <i class="bi bi-file-earmark-ruled-fill"></i>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="brand-title">Phần mềm kế toán</span>
                        <span class="brand-subtitle d-none d-xl-block">HÓA ĐƠN & THUẾ</span>
                    </div>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="nav-pills-custom d-flex">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoice" ? "active" : "")" href="/phan-mem-ke-toan">
                                <i class="bi bi-file-earmark-check"></i>
                                <span>HĐ & TK</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaxAccount" ? "active" : "")" asp-controller="TaxAccount" asp-action="Index">
                                <i class="bi bi-buildings"></i>
                                <span>Danh sách Công ty</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-pie-chart"></i>
                                <span>Báo cáo & Đối soát</span>
                            </a>
                        </li>
                    </ul>
                }
            </div>

            <!-- Right: Company Selector Dropdown & User Profile -->
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button type="button" class="btn btn-light border d-flex align-items-center gap-2 py-1 px-3 rounded-2 shadow-xs" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" style="max-width: 380px; font-size: 0.84rem;" title="@(currentTaxAccount != null ? $"{currentTaxAccount.TaxCode} - {currentTaxAccount.CompanyName}" : "Chọn công ty...")">
                            <i class="bi bi-person text-secondary"></i>
                            <span class="fw-semibold text-dark text-truncate" style="max-width: 300px;">
                                @(currentTaxAccount != null ? currentTaxAccount.CompanyName : "Chọn công ty làm việc...")
                            </span>
                            <i class="bi bi-chevron-down text-muted small ms-1"></i>
                        </button>

                        <div class="dropdown-menu dropdown-menu-end shadow-lg border p-0" style="width: 360px; border-radius: 10px; overflow: hidden;">
                            <!-- Search input inside company dropdown -->
                            <div class="p-2 border-bottom bg-light">
                                <div class="input-group input-group-sm">
                                    <input type="text" id="companyDropdownSearch" class="form-control border-end-0" placeholder="Tìm kiếm tên công ty hoặc MST..." oninput="filterCompanyDropdown(this.value)">
                                    <span class="input-group-text bg-white border-start-0 text-muted">
                                        <i class="bi bi-search"></i>
                                    </span>
                                </div>
                            </div>

                            <!-- Saved Company List -->
                            <div id="companyDropdownList" style="max-height: 280px; overflow-y: auto;">
                                @if (!accessibleAccounts.Any())
                                {
                                    <div class="text-center text-muted small py-3 px-2">
                                        Chưa có công ty nào. Nhấn nút bên dưới để thêm mới.
                                    </div>
                                }
                                @foreach (var acc in accessibleAccounts)
                                {
                                    bool isSelected = currentTaxAccount?.Id == acc.Id;
                                    <form asp-controller="TaxAccount" asp-action="Switch" method="post" class="m-0 company-dropdown-item" data-search="@($"{acc.CompanyName} {acc.TaxCode}".ToLowerInvariant())">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@acc.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="dropdown-item py-2 px-3 d-flex justify-content-between align-items-center border-bottom border-light @(isSelected ? "bg-primary-subtle text-primary fw-bold" : "text-dark")" style="white-space: normal; font-size: 0.82rem;">
                                            <div class="pe-2">
                                                <div class="@(isSelected ? "fw-bold text-primary" : "fw-medium")">@acc.CompanyName</div>
                                                <div class="text-muted" style="font-size: 0.72rem;">MST: @acc.TaxCode</div>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <i class="bi bi-check2 text-primary fs-6 flex-shrink-0"></i>
                                            }
                                        </button>
                                    </form>
                                }
                            </div>

                            <!-- Bottom Button: + Thêm công ty / Hộ kinh doanh -->
                            <div class="p-2.5 bg-light border-top text-center">
                                <button type="button" class="btn btn-primary btn-sm w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm border-0 company-dropdown-btn-add" id="btnDropdownAddCompany" onclick="openCompanyModal(false)">
                                    <i class="bi bi-plus-circle-fill"></i> Thêm công ty / Hộ kinh doanh
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- User Menu -->
                    <div class="dropdown">
                        <button class="user-profile-btn dropdown-toggle" data-bs-toggle="dropdown" title="Tài khoản @User.Identity?.Name">
                            <div class="user-avatar-circle">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li class="dropdown-header">
                                <div class="fw-bold text-truncate" style="max-width: 220px;">@User.Identity?.Name</div>
                            </li>
                            <li><a class="dropdown-item" asp-controller="TaxAccount" asp-action="Index"><i class="bi bi-buildings me-2"></i>Quản lý danh sách công ty</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Settings"><i class="bi bi-gear me-2"></i>Cài đặt tài khoản</a></li>
                            <li><a class="dropdown-item" asp-controller="Feedback" asp-action="Index"><i class="bi bi-chat-left-dots me-2"></i>Báo lỗi / Yêu cầu tính năng</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm px-3 fw-medium">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Global Toast / Alert Notifications -->
    <div class="container-fluid px-2 px-sm-3 px-lg-4 mt-2">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm py-2 d-flex align-items-center mb-2" role="alert">
                <i class="bi bi-check-circle-fill me-2 text-success"></i>
                <div class="small">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2 d-flex align-items-center mb-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>
                <div class="small">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Body -->
    <main class="container-fluid px-2 px-sm-3 px-lg-4 py-2 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Modal: Thêm công ty / Hộ kinh doanh mới (Chuẩn giao diện Ảnh 2 - Nhập 1 lần ghi nhớ mãi mãi) -->
    <div class="modal fade" id="modalCompanySetup" tabindex="-1" aria-labelledby="modalCompanySetupLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 680px;">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom py-3 px-4">
                    <h6 class="modal-title fw-bold text-dark mb-0" id="modalCompanySetupLabel">Thêm công ty / Hộ kinh doanh mới</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formCompanySetup" onsubmit="submitCompanySetupModal(event)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="compModalId" name="id" value="" />
                    <div class="modal-body px-4 py-3">
                        <!-- Tabs: Công ty / Doanh nghiệp | Hộ kinh doanh -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <button type="button" id="btnTypeEnterprise" class="btn btn-primary btn-sm w-100 fw-semibold py-2" onclick="selectCompanyEntityType('enterprise')">
                                    Công ty / Doanh nghiệp
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="button" id="btnTypeHousehold" class="btn btn-light border btn-sm w-100 fw-medium text-secondary py-2" onclick="selectCompanyEntityType('household')">
                                    Hộ kinh doanh
                                </button>
                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Mã số thuế (*) -->
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Mã số thuế <span class="text-danger">(*)</span></label>
                                <div class="input-group input-group-sm">
                                    <input type="text" id="compModalTaxCode" name="taxCode" class="form-control" placeholder="Nhập MST (tự động điền tên CTy)..." required onblur="autoLookupCompanyByMst(this.value)" />
                                    <button type="button" class="btn btn-outline-primary" onclick="autoLookupCompanyByMst(document.getElementById('compModalTaxCode').value)" title="Tự động lấy tên và địa chỉ công ty từ MST">
                                        <i class="bi bi-search" id="compModalLookupIcon"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Tên gợi nhớ (*) -->
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Tên gợi nhớ <span class="text-danger">(*)</span></label>
                                <input type="text" id="compModalAlias" name="aliasName" class="form-control form-control-sm" placeholder="Nhập tên gợi nhớ công ty / Hộ kinh doanh" required />
                            </div>

                            <!-- Tên kế toán -->
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Tên kế toán</label>
                                <input type="text" id="compModalAccountant" name="accountantName" class="form-control form-control-sm" placeholder="Nhập tên kế toán" />
                            </div>

                            <!-- Tên công ty -->
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Tên công ty</label>
                                <input type="text" id="compModalCompanyName" name="companyName" class="form-control form-control-sm" placeholder="Nhập tên công ty" />
                            </div>

                            <!-- Tên giám đốc -->
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Tên giám đốc</label>
                                <input type="text" id="compModalDirector" name="representative" class="form-control form-control-sm" placeholder="Nhập tên giám đốc" />
                            </div>

                            <!-- Địa chỉ công ty / hộ kinh doanh -->
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Địa chỉ công ty / hộ kinh doanh</label>
                                <input type="text" id="compModalAddress" name="address" class="form-control form-control-sm" placeholder="Nhập địa chỉ..." />
                            </div>
                        </div>

                        <!-- Tài khoản Hóa đơn điện tử (Ghi nhớ 1 lần) -->
                        <div class="border rounded-3 p-2.5 px-3 mt-3 bg-light bg-opacity-50">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="small fw-semibold text-dark">Tài khoản Hóa đơn điện tử</span>
                                    <span id="compModalGdtSavedBadge" class="badge bg-success-subtle text-success border border-success-subtle ms-2 d-none" style="font-size: 0.7rem;">
                                        <i class="bi bi-check-circle-fill me-1"></i>Đã ghi nhớ mật khẩu
                                    </span>
                                </div>
                                <button type="button" class="btn btn-outline-success btn-sm py-1 px-2.5 fw-semibold" style="font-size: 0.78rem;" onclick="$('#compModalGdtCredentialsBox').slideToggle(150)">
                                    <i class="bi bi-link-45deg me-1"></i>Kết nối tài khoản
                                </button>
                            </div>
                            <div id="compModalGdtCredentialsBox" class="mt-2 pt-2 border-top">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label small text-muted mb-1" style="font-size: 0.75rem;">Tên đăng nhập Cổng HĐĐT (hoadondientu.gdt.gov.vn)</label>
                                        <input type="text" id="compModalGdtUser" name="gdtUsername" class="form-control form-control-sm" placeholder="Mặc định theo Mã số thuế" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small text-muted mb-1" style="font-size: 0.75rem;">Mật khẩu Cổng HĐĐT (Lưu 1 lần dùng mãi mãi)</label>
                                        <div class="input-group input-group-sm">
                                            <input type="password" id="compModalGdtPass" name="gdtPassword" class="form-control" placeholder="Nhập mật khẩu Cổng Thuế..." />
                                            <button class="btn btn-outline-secondary" type="button" onclick="toggleCompModalPass()">
                                                <i class="bi bi-eye" id="compModalPassIcon"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tài khoản Thuế điện tử -->
                        <div class="border rounded-3 p-2.5 px-3 mt-2 bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
                            <span class="small fw-semibold text-dark">Tài khoản Thuế điện tử</span>
                            <button type="button" class="btn btn-outline-success btn-sm py-1 px-2.5 fw-semibold" style="font-size: 0.78rem;" onclick="$('#compModalGdtCredentialsBox').slideDown(150); $('#compModalGdtPass').focus();">
                                <i class="bi bi-link-45deg me-1"></i>Kết nối tài khoản
                            </button>
                        </div>

                        <div id="compModalAlert" class="alert d-none mt-3 mb-0 py-2 small"></div>
                    </div>
                    <div class="modal-footer border-top py-2.5 px-4">
                        <button type="button" class="btn btn-light border btn-sm px-3" data-bs-dismiss="modal">Quay lại</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold" id="btnSaveCompanyModal">Lưu công ty</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Cấu hình thông tin lấy hóa đơn gốc (Chuẩn hệ thống kế toán) -->
    <div class="modal fade" id="modalOriginalInvoiceConfig" tabindex="-1" aria-labelledby="modalOriginalInvoiceConfigLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 620px;">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom py-3 px-4 bg-light">
                    <div class="d-flex align-items-center gap-2.5">
                        <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="bi bi-gear-fill fs-5"></i>
                        </div>
                        <div>
                            <h6 class="modal-title fw-bold text-dark mb-0" id="modalOriginalInvoiceConfigLabel">Cấu hình thông tin lấy hóa đơn gốc</h6>
                            <small class="text-muted" id="origModalCompanySub">Tài khoản kết nối Cổng Tổng cục Thuế</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formOriginalInvoiceConfig" onsubmit="submitOriginalInvoiceConfig(event)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="origModalAccountId" name="taxAccountId" value="" />
                    <div class="modal-body px-4 py-3">
                        <div id="origModalAlert" class="alert d-none py-2 px-3 small mb-3"></div>

                        <!-- Card 1: Tài khoản Cổng Tổng cục Thuế -->
                        <div class="border rounded-3 p-3 mb-3 bg-white shadow-xs">
                            <div class="d-flex justify-content-between align-items-center mb-2.5">
                                <span class="fw-semibold text-dark small d-flex align-items-center gap-1.5">
                                    <i class="bi bi-shield-lock-fill text-primary"></i> Tài khoản Cổng HĐĐT (Tổng cục Thuế)
                                </span>
                                <span id="origModalSavedBadge" class="badge bg-success-subtle text-success border border-success-subtle d-none" style="font-size: 0.72rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i>Đã ghi nhớ mật khẩu
                                </span>
                            </div>
                            <div class="row g-2.5">
                                <div class="col-12">
                                    <label class="form-label text-muted small mb-1" style="font-size: 0.78rem;">Mã số thuế / Tên đăng nhập (hoadondientu.gdt.gov.vn)</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                        <input type="text" id="origModalUsername" name="username" class="form-control" placeholder="Mã số thuế doanh nghiệp..." required />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label text-muted small mb-1" style="font-size: 0.78rem;">Mật khẩu Cổng Thuế (Lưu 1 lần dùng mãi mãi)</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                                        <input type="password" id="origModalPassword" name="password" class="form-control" placeholder="Nhập mật khẩu Cổng Thuế..." />
                                        <button class="btn btn-outline-secondary" type="button" onclick="toggleOrigModalPass()">
                                            <i class="bi bi-eye" id="origModalPassIcon"></i>
                                        </button>
                                    </div>
                                    <div class="form-text small text-muted mt-1" style="font-size: 0.72rem;">
                                        Hệ thống tự động mã hóa bảo mật chuẩn AES và tự động giải mã Captcha bằng AI OCR khi lấy hóa đơn.
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 pt-2.5 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted small" style="font-size: 0.75rem;">Kiểm tra kết nối trực tiếp với Cổng Thuế:</span>
                                <button type="button" class="btn btn-outline-primary btn-sm py-1 px-3 fw-medium" id="btnTestOrigConnection" onclick="testOriginalGdtConnection()">
                                    <i class="bi bi-arrow-repeat me-1" id="origModalTestIcon"></i>Kiểm tra kết nối
                                </button>
                            </div>
                        </div>

                        <!-- Card 2: Quy tắc & Phương thức lấy hóa đơn gốc -->
                        <div class="border rounded-3 p-3 bg-light bg-opacity-50">
                            <span class="fw-semibold text-dark small d-block mb-2">
                                <i class="bi bi-check-all text-success me-1"></i>Cơ chế lấy hóa đơn gốc tự động:
                            </span>
                            <div class="d-flex flex-column gap-2 small text-secondary" style="font-size: 0.78rem;">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-check-circle-fill text-success mt-0.5"></i>
                                    <div><strong>Ưu tiên 1 - Tải PDF gốc Tổng cục Thuế:</strong> Tải trực tiếp bản thể hiện gốc có chữ ký số điện tử CQT từ Cổng Thuế (hoadondientu.gdt.gov.vn).</div>
                                </div>
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-check-circle-fill text-success mt-0.5"></i>
                                    <div><strong>Ưu tiên 2 - PDF gốc từ Nhà cung cấp:</strong> Tự động truy xuất link tra cứu trong file XML (MISA meInvoice, Viettel S-Invoice, VNPT, BKAV...) để lấy bản gốc phát hành chuẩn từng nhà cung cấp.</div>
                                </div>
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-check-circle-fill text-success mt-0.5"></i>
                                    <div><strong>Ưu tiên 3 - Gói nén ZIP/XML:</strong> Tải và lưu trữ trọn bộ XML & file đính kèm phục vụ lưu trữ kế toán và kiểm tra quyết toán thuế.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-top py-2.5 px-4 bg-light">
                        <button type="button" class="btn btn-light border btn-sm px-3" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" id="btnSaveOrigConfig" class="btn btn-primary btn-sm px-4 fw-semibold shadow-xs">
                            <i class="bi bi-check-lg me-1"></i> Lưu cấu hình
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Accountant"))
    {
        <partial name="_AddCompanyModalPartial" />
    }

    <!-- Footer -->
    <footer>
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <div>
                <strong>Phần mềm kế toán</strong> &bull; Quản lý hóa đơn điện tử chuẩn Nghị định 123/2020/NĐ-CP & Thông tư 78/2021/TT-BTC
            </div>
            <div>
                Môi trường: <span class="badge bg-success-subtle text-success border border-success-subtle">Hệ thống sẵn sàng</span> &bull; Bản quyền &copy; @DateTime.Now.Year
            </div>
        </div>
    </footer>
    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function filterCompanyDropdown(keyword) {
            var q = (keyword || '').toLowerCase().trim();
            $('.company-dropdown-item').each(function() {
                var text = $(this).attr('data-search') || '';
                if (!q || text.indexOf(q) !== -1) {
                    $(this).removeClass('d-none');
                } else {
                    $(this).addClass('d-none');
                }
            });
        }

        function filterHeaderCompanyDropdown(keyword) {
            filterCompanyDropdown(keyword);
        }

        $('#formFeedback').on('submit', function(e) {
            e.preventDefault();
            var form = $(this);
            $.post(form.attr('action'), form.serialize(), function(res) {
                if (res.success) {
                    alert(res.message);
                    $('#feedbackModal').modal('hide');
                    form[0].reset();
                } else {
                    alert(res.message || 'Có lỗi xảy ra.');
                }
            });
        });

        function selectCompanyEntityType(type) {
            if (type === 'enterprise') {
                $('#btnTypeEnterprise').removeClass('btn-light border text-secondary fw-medium').addClass('btn-primary fw-semibold');
                $('#btnTypeHousehold').removeClass('btn-primary fw-semibold').addClass('btn-light border text-secondary fw-medium');
            } else {
                $('#btnTypeHousehold').removeClass('btn-light border text-secondary fw-medium').addClass('btn-primary fw-semibold');
                $('#btnTypeEnterprise').removeClass('btn-primary fw-semibold').addClass('btn-light border text-secondary fw-medium');
            }
        }

        function toggleCompModalPass() {
            var inp = document.getElementById('compModalGdtPass');
            var icon = document.getElementById('compModalPassIcon');
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                inp.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function openCompanyModal(editCurrent) {
            // 1. Đóng dropdown công ty ngay lập tức
            try {
                var dropdownToggle = document.querySelector('[data-bs-toggle="dropdown"][aria-expanded="true"]');
                if (dropdownToggle && window.bootstrap && bootstrap.Dropdown) {
                    var dd = bootstrap.Dropdown.getOrCreateInstance(dropdownToggle);
                    if (dd) dd.hide();
                }
            } catch(e) {}

            try {
                $('.dropdown-menu.show').removeClass('show');
                $('[data-bs-toggle="dropdown"]').attr('aria-expanded', 'false').removeClass('show');
            } catch(e) {}

            if (document.activeElement) {
                document.activeElement.blur();
            }

            // 2. Reset trạng thái modal
            $('#compModalAlert').addClass('d-none');
            var form = document.getElementById('formCompanySetup');
            if (form) form.reset();
            $('#compModalId').val('');
            $('#compModalGdtSavedBadge').addClass('d-none');

            if (editCurrent) {
                openOriginalInvoiceConfigModal();
                return;
            } else {
                $('#modalCompanySetupLabel').text('Thêm công ty / Hộ kinh doanh mới');
                $('#compModalTaxCode').val('');
                $('#compModalAlias').val('');
                $('#compModalCompanyName').val('');
                $('#compModalAddress').val('');
                $('#compModalDirector').val('');
                $('#compModalAccountant').val('');
                $('#compModalGdtUser').val('');
                $('#compModalGdtPass').val('').attr('placeholder', 'Nhập mật khẩu Cổng Thuế...');
                if (typeof selectCompanyEntityType === 'function') {
                    selectCompanyEntityType('enterprise');
                }
            }

            // 3. Hiển thị modal
            var modalEl = document.getElementById('modalCompanySetup');
            if (modalEl) {
                try {
                    if (window.bootstrap && bootstrap.Modal) {
                        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        modal.show();
                    } else {
                        $(modalEl).modal('show');
                    }
                } catch(err) {
                    $(modalEl).modal('show');
                }
            }
        }

        $(document).on('click', '#btnDropdownAddCompany', function(e) {
            e.preventDefault();
            e.stopPropagation();
            openCompanyModal(false);
        });

        function autoLookupCompanyByMst(mst) {
            var clean = (mst || '').trim();
            if (!clean || clean.length < 10) return;

            if (!$('#compModalGdtUser').val()) {
                $('#compModalGdtUser').val(clean);
            }

            var icon = document.getElementById('compModalLookupIcon');
            if (icon) icon.className = 'spinner-border spinner-border-sm text-primary';

            $.get('/TaxAccount/LookupApi', { taxCode: clean }, function(res) {
                if (icon) icon.className = 'bi bi-search';
                if (res && res.success && res.companyName) {
                    $('#compModalCompanyName').val(res.companyName);
                    if (!$('#compModalAlias').val()) {
                        $('#compModalAlias').val(res.companyName);
                    }
                    if (res.address && !$('#compModalAddress').val()) {
                        $('#compModalAddress').val(res.address);
                    }
                }
            }).fail(function() {
                if (icon) icon.className = 'bi bi-search';
            });
        }

        function submitCompanySetupModal(e) {
            e.preventDefault();
            var btn = $('#btnSaveCompanyModal');
            btn.prop('disabled', true).text('Đang lưu...');

            $.post('/TaxAccount/SaveCompanyModal', $('#formCompanySetup').serialize(), function(res) {
                btn.prop('disabled', false).text('Lưu công ty');
                if (res && res.success) {
                    window.location.href = '/phan-mem-ke-toan';
                } else {
                    $('#compModalAlert').removeClass('d-none alert-success').addClass('alert-danger').text(res.message || 'Lỗi khi lưu công ty.');
                }
            }).fail(function() {
                btn.prop('disabled', false).text('Lưu công ty');
                $('#compModalAlert').removeClass('d-none alert-success').addClass('alert-danger').text('Lỗi kết nối máy chủ khi lưu công ty.');
            });
        }
    
        function openOriginalInvoiceConfigModal() {
            // Đóng dropdown nếu có
            try {
                var dropdownToggle = document.querySelector('[data-bs-toggle="dropdown"][aria-expanded="true"]');
                if (dropdownToggle && window.bootstrap && bootstrap.Dropdown) {
                    var dd = bootstrap.Dropdown.getOrCreateInstance(dropdownToggle);
                    if (dd) dd.hide();
                }
            } catch(e) {}

            $('#origModalAlert').addClass('d-none').text('');
            $('#origModalSavedBadge').addClass('d-none');
            $('#origModalPassword').val('').attr('placeholder', 'Nhập mật khẩu Cổng Thuế...');

            $.get('/TaxAccount/GetCompanyInfo', function(res) {
                if (res && res.success) {
                    $('#origModalAccountId').val(res.id || '');
                    $('#origModalCompanySub').text((res.companyName || 'Công ty') + ' (MST: ' + (res.taxCode || '') + ')');
                    $('#origModalUsername').val(res.gdtUsername || res.taxCode || '');
                    if (res.hasSavedPassword) {
                        $('#origModalSavedBadge').removeClass('d-none');
                        $('#origModalPassword').attr('placeholder', 'Đã lưu mật khẩu Cổng Thuế (Để trống nếu giữ nguyên)');
                    }
                }
            });

            var modalEl = document.getElementById('modalOriginalInvoiceConfig');
            if (modalEl) {
                try {
                    if (window.bootstrap && bootstrap.Modal) {
                        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        modal.show();
                    } else {
                        $(modalEl).modal('show');
                    }
                } catch(err) {
                    $(modalEl).modal('show');
                }
            }
        }

        function toggleOrigModalPass() {
            var inp = document.getElementById('origModalPassword');
            var icon = document.getElementById('origModalPassIcon');
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                inp.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function testOriginalGdtConnection() {
            var btn = $('#btnTestOrigConnection');
            var icon = $('#origModalTestIcon');
            var user = $('#origModalUsername').val();
            var pass = $('#origModalPassword').val();

            btn.prop('disabled', true);
            icon.removeClass('bi-arrow-repeat').addClass('spinner-border spinner-border-sm');
            $('#origModalAlert').removeClass('d-none alert-success alert-danger').addClass('alert-info').html('<i class="bi bi-hourglass-split me-1"></i> Đang tự động vượt Captcha và kiểm tra kết nối Cổng Thuế...');

            var token = $('input[name="__RequestVerificationToken"]').first().val();

            $.ajax({
                url: '/TaxAccount/TestOriginalConnection',
                type: 'POST',
                data: {
                    username: user,
                    password: pass,
                    __RequestVerificationToken: token
                },
                success: function(res) {
                    btn.prop('disabled', false);
                    icon.removeClass('spinner-border spinner-border-sm').addClass('bi-arrow-repeat');
                    if (res && res.success) {
                        $('#origModalAlert').removeClass('alert-info alert-danger').addClass('alert-success').html('<i class="bi bi-check-circle-fill me-1"></i> ' + res.message);
                    } else {
                        $('#origModalAlert').removeClass('alert-info alert-success').addClass('alert-danger').html('<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + (res.message || 'Kiểm tra kết nối thất bại.'));
                    }
                },
                error: function() {
                    btn.prop('disabled', false);
                    icon.removeClass('spinner-border spinner-border-sm').addClass('bi-arrow-repeat');
                    $('#origModalAlert').removeClass('alert-info alert-success').addClass('alert-danger').html('<i class="bi bi-exclamation-triangle-fill me-1"></i> Lỗi kết nối tới máy chủ.');
                }
            });
        }

        function submitOriginalInvoiceConfig(e) {
            e.preventDefault();
            var btn = $('#btnSaveOrigConfig');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...');

            var token = $('input[name="__RequestVerificationToken"]').first().val();
            var user = $('#origModalUsername').val();
            var pass = $('#origModalPassword').val();

            $.ajax({
                url: '/TaxAccount/SaveOriginalInvoiceConfig',
                type: 'POST',
                data: {
                    username: user,
                    password: pass,
                    __RequestVerificationToken: token
                },
                success: function(res) {
                    btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i> Lưu cấu hình');
                    if (res && res.success) {
                        $('#origModalAlert').removeClass('d-none alert-danger alert-info').addClass('alert-success').html('<i class="bi bi-check-circle-fill me-1"></i> ' + res.message);
                        setTimeout(function() {
                            var modalEl = document.getElementById('modalOriginalInvoiceConfig');
                            if (modalEl && window.bootstrap && bootstrap.Modal) {
                                var modal = bootstrap.Modal.getInstance(modalEl);
                                if (modal) modal.hide();
                            } else {
                                $(modalEl).modal('hide');
                            }
                        }, 1200);
                    } else {
                        $('#origModalAlert').removeClass('d-none alert-success alert-info').addClass('alert-danger').html('<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + (res.message || 'Lỗi khi lưu cấu hình.'));
                    }
                },
                error: function() {
                    btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i> Lưu cấu hình');
                    $('#origModalAlert').removeClass('d-none alert-success alert-info').addClass('alert-danger').html('<i class="bi bi-exclamation-triangle-fill me-1"></i> Lỗi kết nối máy chủ.');
                }
            });
        }

    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
