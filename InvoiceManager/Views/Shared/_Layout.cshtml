@inject InvoiceManager.Services.ITaxAccountContext TaxContext
@{
    var currentTaxAccount = await TaxContext.GetCurrentTaxAccountAsync();
    var accessibleAccounts = await TaxContext.GetAccessibleTaxAccountsAsync();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phần mềm kế toán | Hệ thống Quản lý Hóa đơn & Doanh nghiệp</title>
    
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-navy: #1e3a8a;
            --primary-blue: #2563eb;
            --accent-emerald: #059669;
            --accent-amber: #d97706;
            --border-color: #e2e8f0;
            --bg-light: #f8fafc;
            --text-dark: #0f172a;
            --text-muted: #64748b;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #f1f5f9;
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Top Navbar */
        /* Top Navbar - Clean Single-Row Enterprise Design */
        .tax-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            padding: 0 1.5rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
            position: sticky;
            top: 0;
            z-index: 1030;
            height: 62px;
            display: flex;
            align-items: center;
        }

        .tax-navbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            flex-wrap: nowrap;
            gap: 1.25rem;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            text-decoration: none;
            white-space: nowrap;
            flex-shrink: 0;
            user-select: none;
        }

        .brand-icon-box {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            box-shadow: 0 3px 8px rgba(37, 99, 235, 0.28);
            flex-shrink: 0;
            transition: transform 0.15s ease;
        }

        .brand-logo:hover .brand-icon-box {
            transform: scale(1.04);
        }

        .brand-title {
            font-weight: 800;
            font-size: 1.1rem;
            color: var(--primary-navy);
            letter-spacing: -0.01em;
            line-height: 1.15;
            white-space: nowrap;
        }

        .brand-subtitle {
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            line-height: 1;
            margin-top: 2px;
        }

        /* Navigation links */
        .nav-pills-custom {
            display: flex;
            align-items: center;
            flex-wrap: nowrap;
            gap: 0.35rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .nav-pills-custom .nav-link {
            color: #475569;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.45rem 0.8rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            white-space: nowrap;
            transition: all 0.15s ease;
            border: 1px solid transparent;
        }

        .nav-pills-custom .nav-link:hover {
            background-color: #f1f5f9;
            color: var(--primary-blue);
        }

        .nav-pills-custom .nav-link.active {
            background-color: #eff6ff;
            color: var(--primary-blue);
            font-weight: 700;
            border-color: #bfdbfe;
            box-shadow: 0 1px 2px rgba(37, 99, 235, 0.05);
        }

        .tax-selector-dropdown {
            min-width: 320px;
            border-radius: 10px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            border: 1px solid var(--border-color);
            padding: 0.5rem 0;
        }

        .tax-company-badge {
            background-color: #f8fafc;
            color: #1e293b;
            border: 1px solid #cbd5e1;
            padding: 0.35rem 0.75rem;
            border-radius: 9px;
            font-size: 0.825rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .tax-company-badge:hover {
            background-color: #eff6ff;
            border-color: #93c5fd;
        }

        .tax-badge-icon {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: #eff6ff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .tax-badge-label {
            font-size: 0.65rem;
            font-weight: 700;
            color: #64748b;
            letter-spacing: 0.04em;
            line-height: 1;
        }

        .tax-badge-name {
            font-size: 0.8rem;
            font-weight: 600;
            color: #0f172a;
            line-height: 1.2;
        }

        .user-profile-btn {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            padding: 0.3rem 0.65rem;
            border-radius: 9px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .user-profile-btn:hover {
            background-color: #f8fafc;
            border-color: #94a3b8;
        }

        .user-avatar-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            flex-shrink: 0;
            box-shadow: 0 2px 4px rgba(37, 99, 235, 0.25);
        }

        /* ==========================================================================
           Modern Polished Dashboard Summary Cards
           ========================================================================== */
        .stat-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 0.9rem 1.1rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px -2px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .stat-label {
            font-size: 0.725rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.25rem;
            font-weight: 700;
        }

        .stat-value {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1.2;
            font-variant-numeric: tabular-nums;
        }

        .stat-value.primary { color: var(--primary-blue); }
        .stat-value.success { color: var(--accent-emerald); }
        .stat-value.warning { color: var(--accent-amber); }

        /* Summary Hub Card (Volume & Breakdown) */
        .summary-hub-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 1rem 1.25rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .summary-hub-card:hover {
            box-shadow: 0 6px 18px -4px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .hub-icon-badge {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
            border: 1px solid #bfdbfe;
        }

        .hub-title {
            font-size: 0.725rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        .hub-hero-value {
            font-size: 1.75rem;
            font-weight: 800;
            line-height: 1.1;
            font-variant-numeric: tabular-nums;
            color: var(--primary-navy);
            transition: color 0.15s;
        }

        .hub-hero-value:hover {
            color: var(--primary-blue);
        }

        .hub-subtext {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .sync-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 0.35rem 0.75rem;
            font-size: 0.75rem;
            color: #475569;
            font-weight: 500;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
        }

        .sync-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #10b981;
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            animation: syncPulse 2s infinite;
        }

        @@keyframes syncPulse {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
            70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        /* 3 Mini breakdown items */
        .hub-breakdown-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.5rem;
            margin-top: 0.75rem;
            padding-top: 0.75rem;
            border-top: 1px dashed #e2e8f0;
        }

        .mini-stat-item {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 0.5rem 0.65rem;
            transition: all 0.15s ease;
            text-decoration: none;
            color: inherit;
            display: block;
            cursor: pointer;
            user-select: none;
        }

        .mini-stat-item:hover {
            background: #ffffff;
            border-color: #cbd5e1;
            transform: translateY(-2px);
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05);
        }

        .mini-stat-item.active {
            background: #eff6ff !important;
            border-color: #93c5fd !important;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
        }

        .mini-stat-header {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.725rem;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 0.2rem;
            white-space: nowrap;
        }

        .mini-stat-value {
            font-size: 1.15rem;
            font-weight: 800;
            line-height: 1.2;
            font-variant-numeric: tabular-nums;
        }

        .mini-stat-desc {
            font-size: 0.675rem;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Financial cards */
        .financial-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 1rem 1.15rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .financial-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px -3px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .financial-label {
            font-size: 0.725rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        .financial-icon-badge {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .financial-value {
            font-size: 1.25rem;
            font-weight: 800;
            line-height: 1.25;
            margin: 0.4rem 0;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.01em;
        }

        .financial-value .currency {
            font-size: 0.8rem;
            font-weight: 600;
            opacity: 0.8;
            margin-left: 2px;
        }

        .financial-subtext {
            font-size: 0.725rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
            font-weight: 500;
        }

        /* Hero card: Tổng thanh toán */
        .financial-card.hero-card {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
            border: 1.5px solid #93c5fd;
            box-shadow: 0 3px 12px rgba(37, 99, 235, 0.1);
        }

        .financial-card.hero-card:hover {
            box-shadow: 0 10px 22px -3px rgba(37, 99, 235, 0.2);
            border-color: #60a5fa;
        }

        .financial-card.hero-card .financial-value {
            color: #1d4ed8;
            font-size: 1.35rem;
            font-weight: 800;
        }

        /* Modern Table styling */
        .table-invoice {
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            font-size: 0.875rem;
        }

        .table-invoice thead th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
            padding: 0.75rem 0.85rem;
            white-space: nowrap;
        }

        .table-invoice tbody td {
            padding: 0.75rem 0.85rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .table-invoice tbody tr:hover {
            background-color: #f8fafc;
        }

        .btn-action-icon {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            background: #ffffff;
            color: #475569;
            transition: all 0.15s;
            cursor: pointer;
        }
        .btn-action-icon:hover {
            background: #eff6ff;
            color: var(--primary-blue);
            border-color: #bfdbfe;
        }

        /* Footer */
        footer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid var(--border-color);
            font-size: 0.8rem;
            color: var(--text-muted);
            padding: 0.85rem 0;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Header -->
    <header class="tax-navbar">
        <div class="tax-navbar-inner">
            <!-- Left: Logo & Navigation -->
            <div class="d-flex align-items-center gap-3">
                <a class="brand-logo" href="/phan-mem-ke-toan" title="Phần mềm kế toán">
                    <div class="brand-icon-box">
                        <i class="bi bi-file-earmark-ruled-fill"></i>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="brand-title">Phần mềm kế toán</span>
                        <span class="brand-subtitle">HÓA ĐƠN & THUẾ</span>
                    </div>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="nav-pills-custom d-none d-md-flex">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoice" ? "active" : "")" href="/phan-mem-ke-toan">
                                <i class="bi bi-receipt"></i> Hóa đơn & Kế toán
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Import" ? "active" : "")" asp-controller="Import" asp-action="Index">
                                <i class="bi bi-cloud-arrow-up"></i> Nhập XML / Excel
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-pie-chart"></i> Dashboard & Đối soát
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaxAccount" && ViewContext.RouteData.Values["action"]?.ToString() != "Lookup" ? "active" : "")" asp-controller="TaxAccount" asp-action="Index">
                                <i class="bi bi-buildings"></i> Tài khoản thuế
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaxAccount" && ViewContext.RouteData.Values["action"]?.ToString() == "Lookup" ? "active" : "")" asp-controller="TaxAccount" asp-action="Lookup">
                                <i class="bi bi-search"></i> Tra cứu MST
                            </a>
                        </li>
                        <!-- Dropdown Hệ thống / Tiện ích mở rộng -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLog" ? "active" : "")" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-gear-wide-connected"></i> Hệ thống
                            </a>
                            <ul class="dropdown-menu shadow">
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="AuditLog" asp-action="Index">
                                        <i class="bi bi-shield-check text-success fs-6"></i>
                                        <div>
                                            <div class="fw-semibold">Nhật ký kiểm toán</div>
                                            <div class="small text-muted">Lịch sử tra cứu, tải file & xuất dữ liệu</div>
                                        </div>
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/hangfire" target="_blank">
                                            <i class="bi bi-cpu text-info fs-6"></i>
                                            <div>
                                                <div class="fw-semibold">Hangfire Jobs</div>
                                                <div class="small text-muted">Giám sát tiến trình đồng bộ ngầm</div>
                                            </div>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    </ul>
                }
            </div>

            <!-- Right: TaxAccount Switcher & User Profile -->
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Tài khoản thuế Dropdown (Chuyển đổi đa công ty) -->
                    <div class="dropdown">
                        <div class="tax-company-badge dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Nhấp để đổi Tài khoản thuế">
                            <div class="tax-badge-icon">
                                <i class="bi bi-buildings text-primary"></i>
                            </div>
                            <div class="text-start">
                                <div class="tax-badge-label">MST CÔNG TY</div>
                                <div class="tax-badge-name text-truncate" style="max-width: 190px;">
                                    @(currentTaxAccount != null ? $"{currentTaxAccount.TaxCode} • {currentTaxAccount.CompanyName}" : "Chọn công ty...")
                                </div>
                            </div>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end tax-selector-dropdown shadow">
                            <li class="dropdown-header text-uppercase" style="font-size: 0.7rem; font-weight: 700; color: #64748b;">
                                <i class="bi bi-repeat me-1"></i> Chuyển đổi Tài khoản thuế
                            </li>
                            @foreach (var acc in accessibleAccounts)
                            {
                                bool isSelected = currentTaxAccount?.Id == acc.Id;
                                <li>
                                    <form asp-controller="TaxAccount" asp-action="Switch" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@acc.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="dropdown-item py-2 d-flex justify-content-between align-items-center @(isSelected ? "bg-light text-primary fw-bold" : "")">
                                            <div>
                                                <div class="fw-bold">@acc.TaxCode</div>
                                                <div class="small text-muted text-truncate" style="max-width: 260px;">@acc.CompanyName</div>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <i class="bi bi-check-circle-fill text-primary ms-2"></i>
                                            }
                                        </button>
                                    </form>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 small d-flex align-items-center gap-2" asp-controller="TaxAccount" asp-action="Index">
                                    <i class="bi bi-list-ul"></i> Quản lý danh sách MST
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- User Menu -->
                    <div class="dropdown">
                        <button class="user-profile-btn dropdown-toggle" data-bs-toggle="dropdown">
                            <div class="user-avatar-circle">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="text-start d-none d-xl-block" style="font-size: 0.8rem; line-height: 1.2;">
                                <div class="fw-bold text-dark text-truncate" style="max-width: 140px;">@User.Identity?.Name</div>
                                <div class="badge @(User.IsInRole("Admin") ? "bg-danger" : User.IsInRole("Accountant") ? "bg-primary" : "bg-secondary")" style="font-size: 0.65rem;">
                                    @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Accountant") ? "Kế toán" : "Người xem")
                                </div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li class="dropdown-header">Tài khoản: @User.Identity?.Name</li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Settings"><i class="bi bi-gear me-2"></i>Cài đặt tài khoản</a></li>
                            <li><a class="dropdown-item" asp-controller="Feedback" asp-action="Index"><i class="bi bi-chat-left-dots me-2"></i>Báo lỗi / Yêu cầu tính năng</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm px-3 fw-medium">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Global Toast / Alert Notifications -->
    <div class="container-fluid px-4 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Body -->
    <main class="container-fluid px-4 py-3 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Feedback Modal -->
    <div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="formFeedback" asp-controller="Feedback" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold" id="feedbackModalLabel"><i class="bi bi-chat-left-dots text-primary me-2"></i>Báo lỗi / Yêu cầu tính năng</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Phân loại yêu cầu</label>
                            <select name="requestType" class="form-select">
                                <option value="Báo lỗi">🐞 Báo lỗi hệ thống / Lỗi đọc XML / Sai lệch tiền</option>
                                <option value="Yêu cầu tính năng">💡 Đề xuất tính năng mới / Biểu mẫu báo cáo mới</option>
                                <option value="Hỗ trợ nghiệp vụ">🛠 Hỗ trợ nghiệp vụ đối soát / Thuế GTGT</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tiêu đề yêu cầu <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control" placeholder="Tóm tắt yêu cầu hoặc lỗi cần xử lý..." required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nội dung chi tiết <span class="text-danger">*</span></label>
                            <textarea name="description" class="form-control" rows="4" placeholder="Mô tả cụ thể số hóa đơn, ký hiệu hoặc tình huống phát sinh..." required></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Người liên hệ</label>
                                <input type="text" name="contactName" class="form-control" placeholder="Họ tên người gửi..." />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Số điện thoại</label>
                                <input type="text" name="contactPhone" class="form-control" placeholder="SĐT để kỹ thuật liên hệ..." />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light d-flex justify-content-between">
                        <a asp-controller="Feedback" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-list-ul me-1"></i> Danh sách yêu cầu
                        </a>
                        <div>
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-primary btn-sm fw-semibold"><i class="bi bi-send me-1"></i> Gửi yêu cầu</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <div>
                <strong>Phần mềm kế toán</strong> &bull; Quản lý hóa đơn điện tử chuẩn Nghị định 123/2020/NĐ-CP & Thông tư 78/2021/TT-BTC
            </div>
            <div>
                Môi trường: <span class="badge bg-success-subtle text-success border border-success-subtle">Hệ thống sẵn sàng</span> &bull; Bản quyền &copy; @DateTime.Now.Year
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Submit feedback ajax
        $('#formFeedback').on('submit', function(e) {
            e.preventDefault();
            var form = $(this);
            $.post(form.attr('action'), form.serialize(), function(res) {
                if (res.success) {
                    alert(res.message);
                    $('#feedbackModal').modal('hide');
                    form[0].reset();
                } else {
                    alert(res.message || 'Có lỗi xảy ra.');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
