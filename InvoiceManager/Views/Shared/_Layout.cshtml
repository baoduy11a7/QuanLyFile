@inject InvoiceManager.Services.ITaxAccountContext TaxContext
@{
    var currentTaxAccount = await TaxContext.GetCurrentTaxAccountAsync();
    var accessibleAccounts = await TaxContext.GetAccessibleTaxAccountsAsync();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phần mềm kế toán | Hệ thống Quản lý Hóa đơn & Doanh nghiệp</title>
    
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-navy: #1e3a8a;
            --primary-blue: #2563eb;
            --accent-emerald: #059669;
            --accent-amber: #d97706;
            --border-color: #e2e8f0;
            --bg-light: #f8fafc;
            --text-dark: #0f172a;
            --text-muted: #64748b;
        }

        html, body {
            overflow-x: hidden;
            width: 100%;
            max-width: 100vw;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #f1f5f9;
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Top Navbar - Responsive Auto-Fitting Design */
        .tax-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            padding: 0 1rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
            position: sticky;
            top: 0;
            z-index: 1030;
            height: 56px;
            display: flex;
            align-items: center;
            width: 100%;
            max-width: 100vw;
            box-sizing: border-box;
        }

        .tax-navbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            flex-wrap: nowrap;
            gap: 0.5rem;
            min-width: 0;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            white-space: nowrap;
            flex-shrink: 0;
            user-select: none;
        }

        .brand-icon-box {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
            flex-shrink: 0;
            transition: transform 0.15s ease;
        }

        .brand-logo:hover .brand-icon-box {
            transform: scale(1.04);
        }

        .brand-title {
            font-weight: 800;
            font-size: 0.95rem;
            color: var(--primary-navy);
            letter-spacing: -0.01em;
            line-height: 1.15;
            white-space: nowrap;
        }

        .brand-subtitle {
            font-size: 0.6rem;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            line-height: 1;
            margin-top: 1px;
        }

        /* Navigation links */
        .nav-pills-custom {
            display: flex;
            align-items: center;
            flex-wrap: nowrap;
            gap: 0.2rem;
            margin: 0;
            padding: 0;
            list-style: none;
            min-width: 0;
        }

        .nav-pills-custom .nav-link {
            color: #475569;
            font-weight: 600;
            font-size: 0.8125rem;
            padding: 0.35rem 0.55rem;
            border-radius: 7px;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            white-space: nowrap;
            transition: all 0.15s ease;
            border: 1px solid transparent;
        }

        .nav-pills-custom .nav-link:hover {
            background-color: #f1f5f9;
            color: var(--primary-blue);
        }

        .nav-pills-custom .nav-link.active {
            background-color: #eff6ff;
            color: var(--primary-blue);
            font-weight: 700;
            border-color: #bfdbfe;
            box-shadow: 0 1px 2px rgba(37, 99, 235, 0.05);
        }

        @@media (max-width: 1399px) {
            .nav-pills-custom .nav-link {
                padding: 0.3rem 0.45rem;
                font-size: 0.785rem;
                gap: 0.25rem;
            }
        }

        .tax-selector-dropdown {
            min-width: 300px;
            border-radius: 10px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            border: 1px solid var(--border-color);
            padding: 0.5rem 0;
        }

        .tax-company-badge {
            background-color: #f8fafc;
            color: #1e293b;
            border: 1px solid #cbd5e1;
            padding: 0.25rem 0.55rem;
            border-radius: 8px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
            flex-shrink: 0;
            max-width: 220px;
        }

        .tax-company-badge:hover {
            background-color: #eff6ff;
            border-color: #93c5fd;
        }

        .tax-badge-icon {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: #eff6ff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .tax-badge-label {
            font-size: 0.6rem;
            font-weight: 700;
            color: #64748b;
            letter-spacing: 0.04em;
            line-height: 1;
        }

        .tax-badge-name {
            font-size: 0.785rem;
            font-weight: 600;
            color: #0f172a;
            line-height: 1.2;
            max-width: 140px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        @@media (max-width: 1399px) {
            .tax-badge-name {
                max-width: 95px;
            }
        }

        @@media (max-width: 1199px) {
            .tax-badge-name {
                max-width: 80px;
                font-size: 0.75rem;
            }
            .tax-badge-label {
                display: none;
            }
            .tax-company-badge {
                padding: 0.25rem 0.4rem;
                gap: 0.35rem;
            }
        }

        .user-profile-btn {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            padding: 0.25rem 0.5rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            transition: all 0.2s ease;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .user-profile-btn:hover {
            background-color: #f8fafc;
            border-color: #94a3b8;
        }

        .user-avatar-circle {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
            flex-shrink: 0;
            box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25);
        }

        .user-profile-info {
            font-size: 0.785rem;
            line-height: 1.2;
            text-align: left;
        }

        .user-profile-name {
            font-weight: 600;
            color: #0f172a;
            max-width: 95px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ==========================================================================
           Modern Polished Dashboard Summary Cards
           ========================================================================== */
        .stat-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 0.9rem 1.1rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px -2px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .stat-label {
            font-size: 0.725rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.25rem;
            font-weight: 700;
        }

        .stat-value {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1.2;
            font-variant-numeric: tabular-nums;
        }

        .stat-value.primary { color: var(--primary-blue); }
        .stat-value.success { color: var(--accent-emerald); }
        .stat-value.warning { color: var(--accent-amber); }

        /* Summary Hub Card (Volume & Breakdown) */
        .summary-hub-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 1rem 1.25rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .summary-hub-card:hover {
            box-shadow: 0 6px 18px -4px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .hub-icon-badge {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
            border: 1px solid #bfdbfe;
        }

        .hub-title {
            font-size: 0.725rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        .hub-hero-value {
            font-size: 1.75rem;
            font-weight: 800;
            line-height: 1.1;
            font-variant-numeric: tabular-nums;
            color: var(--primary-navy);
            transition: color 0.15s;
        }

        .hub-hero-value:hover {
            color: var(--primary-blue);
        }

        .hub-subtext {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-weight: 500;
        }


        /* 3 Mini breakdown items */
        .hub-breakdown-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.5rem;
            margin-top: 0.75rem;
            padding-top: 0.75rem;
            border-top: 1px dashed #e2e8f0;
        }

        .mini-stat-item {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 0.5rem 0.65rem;
            transition: all 0.15s ease;
            text-decoration: none;
            color: inherit;
            display: block;
            cursor: pointer;
            user-select: none;
        }

        .mini-stat-item:hover {
            background: #ffffff;
            border-color: #cbd5e1;
            transform: translateY(-2px);
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05);
        }

        .mini-stat-item.active {
            background: #eff6ff !important;
            border-color: #93c5fd !important;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
        }

        .mini-stat-header {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.725rem;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 0.2rem;
            white-space: nowrap;
        }

        .mini-stat-value {
            font-size: 1.15rem;
            font-weight: 800;
            line-height: 1.2;
            font-variant-numeric: tabular-nums;
        }

        .mini-stat-desc {
            font-size: 0.675rem;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Financial cards */
        .financial-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 1rem 1.15rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .financial-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px -3px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .financial-label {
            font-size: 0.725rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }

        .financial-icon-badge {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .financial-value {
            font-size: 1.25rem;
            font-weight: 800;
            line-height: 1.25;
            margin: 0.4rem 0;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.01em;
        }

        .financial-value .currency {
            font-size: 0.8rem;
            font-weight: 600;
            opacity: 0.8;
            margin-left: 2px;
        }

        .financial-subtext {
            font-size: 0.725rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
            font-weight: 500;
        }

        /* Hero card: Tổng thanh toán */
        .financial-card.hero-card {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
            border: 1.5px solid #93c5fd;
            box-shadow: 0 3px 12px rgba(37, 99, 235, 0.1);
        }

        .financial-card.hero-card:hover {
            box-shadow: 0 10px 22px -3px rgba(37, 99, 235, 0.2);
            border-color: #60a5fa;
        }

        .financial-card.hero-card .financial-value {
            color: #1d4ed8;
            font-size: 1.35rem;
            font-weight: 800;
        }

        /* Modern Table styling */
        .table-invoice {
            background: #ffffff;
            border-radius: 8px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border: 1px solid var(--border-color);
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            font-size: 0.875rem;
        }

        .table-invoice thead th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
            padding: 0.75rem 0.85rem;
            white-space: nowrap;
        }

        .table-invoice tbody td {
            padding: 0.75rem 0.85rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .table-invoice tbody tr:hover {
            background-color: #f8fafc;
        }

        .btn-action-icon {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            background: #ffffff;
            color: #475569;
            transition: all 0.15s;
            cursor: pointer;
        }
        .btn-action-icon:hover {
            background: #eff6ff;
            color: var(--primary-blue);
            border-color: #bfdbfe;
        }

        /* Mobile & Multi-Device Utilities */
        .btn-group-responsive {
            display: flex;
            overflow-x: auto;
            white-space: nowrap;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 2px;
            scrollbar-width: none;
            gap: 0.25rem;
        }
        .btn-group-responsive::-webkit-scrollbar {
            display: none;
        }

        #bulkActionBar {
            max-width: calc(100vw - 20px) !important;
            width: auto !important;
            min-width: 0 !important;
        }

        @@media (max-width: 767.98px) {
            .table-invoice {
                font-size: 0.8rem;
            }
            .table-invoice thead th,
            .table-invoice tbody td {
                padding: 0.45rem 0.55rem;
            }
            .stat-card,
            .summary-hub-card,
            .financial-card {
                padding: 0.75rem 0.85rem;
            }
            .hub-hero-value {
                font-size: 1.4rem;
            }
            .financial-value {
                font-size: 1.15rem;
            }
            .financial-icon-badge {
                width: 28px;
                height: 28px;
                font-size: 0.85rem;
            }
            .hub-breakdown-grid {
                gap: 0.35rem;
                margin-top: 0.5rem;
                padding-top: 0.5rem;
            }
            .mini-stat-item {
                padding: 0.35rem 0.4rem;
            }
            .mini-stat-desc {
                display: none;
            }
            #bulkActionBar .card-body {
                flex-direction: column;
                align-items: stretch !important;
                gap: 0.4rem !important;
                padding: 0.5rem 0.75rem !important;
            }
        }

        @@media (max-width: 575.98px) {
            .tax-navbar {
                padding: 0 0.5rem;
                height: 52px;
            }
            .brand-icon-box {
                width: 28px;
                height: 28px;
                font-size: 0.95rem;
            }
            .brand-title {
                font-size: 0.825rem;
            }
            .tax-company-badge {
                padding: 0.2rem 0.35rem;
                max-width: 125px;
            }
            .tax-badge-icon {
                width: 22px;
                height: 22px;
                font-size: 0.75rem;
            }
            .tax-badge-name {
                max-width: 65px;
                font-size: 0.7rem;
            }
            .user-profile-btn {
                padding: 0.2rem 0.35rem;
            }
            .user-avatar-circle {
                width: 25px;
                height: 25px;
                font-size: 0.7rem;
            }
        }

        /* Footer */
        footer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid var(--border-color);
            font-size: 0.8rem;
            color: var(--text-muted);
            padding: 0.85rem 0;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Header -->
    <header class="tax-navbar">
        <div class="tax-navbar-inner">
            <!-- Left: Logo & Navigation -->
            <div class="d-flex align-items-center gap-2 min-w-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Hamburger Toggle on small screens (< 992px) -->
                    <button class="btn btn-sm btn-light border d-lg-none p-1 px-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavDrawer" aria-controls="mobileNavDrawer" title="Danh mục hệ thống">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                }

                <a class="brand-logo" href="/phan-mem-ke-toan" title="Phần mềm kế toán">
                    <div class="brand-icon-box">
                        <i class="bi bi-file-earmark-ruled-fill"></i>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="brand-title">Phần mềm kế toán</span>
                        <span class="brand-subtitle d-none d-xl-block">HÓA ĐƠN & THUẾ</span>
                    </div>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="nav-pills-custom d-none d-lg-flex">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoice" ? "active" : "")" href="/phan-mem-ke-toan" title="Quản lý hóa đơn">
                                <i class="bi bi-receipt"></i>
                                <span>Hóa đơn<span class="d-none d-xxl-inline"> & Kế toán</span></span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Import" ? "active" : "")" asp-controller="Import" asp-action="Index" title="Đồng bộ hóa đơn từ API Thuế & Nhập file XML/Excel">
                                <i class="bi bi-cloud-arrow-down-fill text-success"></i>
                                <span>API Thuế & Nhập file</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index" title="Dashboard thống kê & Đối soát số liệu">
                                <i class="bi bi-pie-chart"></i>
                                <span>Đối soát<span class="d-none d-xxl-inline"> & Dashboard</span></span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaxAccount" && ViewContext.RouteData.Values["action"]?.ToString() != "Lookup" ? "active" : "")" asp-controller="TaxAccount" asp-action="Index" title="Quản lý tài khoản cơ quan thuế">
                                <i class="bi bi-buildings"></i>
                                <span>Tài khoản thuế</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaxAccount" && ViewContext.RouteData.Values["action"]?.ToString() == "Lookup" ? "active" : "")" asp-controller="TaxAccount" asp-action="Lookup" title="Tra cứu mã số thuế doanh nghiệp">
                                <i class="bi bi-search"></i>
                                <span>Tra cứu<span class="d-none d-xxl-inline"> MST</span></span>
                            </a>
                        </li>
                        <!-- Dropdown Hệ thống / Tiện ích mở rộng -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLog" ? "active" : "")" href="#" data-bs-toggle="dropdown" aria-expanded="false" title="Công cụ hệ thống">
                                <i class="bi bi-gear-wide-connected"></i>
                                <span>Hệ thống</span>
                            </a>
                            <ul class="dropdown-menu shadow">
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="AuditLog" asp-action="Index">
                                        <i class="bi bi-shield-check text-success fs-6"></i>
                                        <div>
                                            <div class="fw-semibold">Nhật ký kiểm toán</div>
                                            <div class="small text-muted">Lịch sử tra cứu, tải file & xuất dữ liệu</div>
                                        </div>
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/hangfire" target="_blank">
                                            <i class="bi bi-cpu text-info fs-6"></i>
                                            <div>
                                                <div class="fw-semibold">Hangfire Jobs</div>
                                                <div class="small text-muted">Giám sát tiến trình đồng bộ ngầm</div>
                                            </div>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    </ul>
                }
            </div>

            <!-- Right: TaxAccount Switcher & User Profile -->
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Tài khoản thuế Dropdown (Chuyển đổi đa công ty) -->
                    <div class="dropdown">
                        <div class="tax-company-badge dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="@(currentTaxAccount != null ? $"{currentTaxAccount.TaxCode} - {currentTaxAccount.CompanyName} (Nhấp để đổi)" : "Chọn công ty...")">
                            <div class="tax-badge-icon">
                                <i class="bi bi-buildings text-primary"></i>
                            </div>
                            <div class="text-start">
                                <div class="tax-badge-label">MST CÔNG TY</div>
                                <div class="tax-badge-name">
                                    @(currentTaxAccount != null ? $"{currentTaxAccount.TaxCode} • {currentTaxAccount.CompanyName}" : "Chọn công ty...")
                                </div>
                            </div>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end tax-selector-dropdown shadow">
                            <li class="dropdown-header text-uppercase" style="font-size: 0.7rem; font-weight: 700; color: #64748b;">
                                <i class="bi bi-repeat me-1"></i> Chuyển đổi Tài khoản thuế
                            </li>
                            @foreach (var acc in accessibleAccounts)
                            {
                                bool isSelected = currentTaxAccount?.Id == acc.Id;
                                <li>
                                    <form asp-controller="TaxAccount" asp-action="Switch" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@acc.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="dropdown-item py-2 d-flex justify-content-between align-items-center @(isSelected ? "bg-light text-primary fw-bold" : "")">
                                            <div>
                                                <div class="fw-bold">@acc.TaxCode</div>
                                                <div class="small text-muted text-truncate" style="max-width: 250px;">@acc.CompanyName</div>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <i class="bi bi-check-circle-fill text-primary ms-2"></i>
                                            }
                                        </button>
                                    </form>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 small d-flex align-items-center gap-2" asp-controller="TaxAccount" asp-action="Index">
                                    <i class="bi bi-list-ul"></i> Quản lý danh sách MST
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- User Menu -->
                    <div class="dropdown">
                        <button class="user-profile-btn dropdown-toggle" data-bs-toggle="dropdown" title="Tài khoản @User.Identity?.Name">
                            <div class="user-avatar-circle">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <!-- Wide screens (>= 1400px): Name + Badge -->
                            <div class="user-profile-info d-none d-xxl-block">
                                <div class="user-profile-name">@(User.Identity?.Name?.Split('@')[0] ?? User.Identity?.Name)</div>
                                <div class="badge @(User.IsInRole("Admin") ? "bg-danger" : User.IsInRole("Accountant") ? "bg-primary" : "bg-secondary")" style="font-size: 0.6rem; padding: 2px 5px;">
                                    @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Accountant") ? "Kế toán" : "Người xem")
                                </div>
                            </div>
                            <!-- Medium screens (992px to 1399px): Badge only -->
                            <div class="d-none d-lg-block d-xxl-none">
                                <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : User.IsInRole("Accountant") ? "bg-primary" : "bg-secondary")" style="font-size: 0.65rem; padding: 2px 6px;">
                                    @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Accountant") ? "Kế toán" : "User")
                                </span>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li class="dropdown-header">
                                <div class="fw-bold text-truncate" style="max-width: 220px;">@User.Identity?.Name</div>
                                <small class="text-muted">@(User.IsInRole("Admin") ? "Quản trị viên hệ thống" : User.IsInRole("Accountant") ? "Nhân viên kế toán" : "Người dùng")</small>
                            </li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Settings"><i class="bi bi-gear me-2"></i>Cài đặt tài khoản</a></li>
                            <li><a class="dropdown-item" asp-controller="Feedback" asp-action="Index"><i class="bi bi-chat-left-dots me-2"></i>Báo lỗi / Yêu cầu tính năng</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm px-3 fw-medium">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                    </a>
                }
            </div>
        </div>
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Mobile Navigation Drawer (Offcanvas for < 992px) -->
        <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileNavDrawer" aria-labelledby="mobileNavDrawerLabel" style="max-width: 280px;">
            <div class="offcanvas-header border-bottom">
                <div class="d-flex align-items-center gap-2" id="mobileNavDrawerLabel">
                    <div class="brand-icon-box" style="width: 28px; height: 28px; font-size: 0.9rem;">
                        <i class="bi bi-file-earmark-ruled-fill"></i>
                    </div>
                    <span class="fw-bold text-primary" style="font-size: 0.95rem;">Phần mềm kế toán</span>
                </div>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-2">
                <div class="list-group list-group-flush">
                    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2.5 rounded mb-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoice" ? "active" : "")" href="/phan-mem-ke-toan">
                        <i class="bi bi-receipt fs-5"></i>
                        <span class="fw-medium">Hóa đơn & Kế toán</span>
                    </a>
                    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2.5 rounded mb-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Import" ? "active" : "")" asp-controller="Import" asp-action="Index">
                        <i class="bi bi-cloud-arrow-up fs-5"></i>
                        <span class="fw-medium">Nhập XML / Excel</span>
                    </a>
                    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2.5 rounded mb-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-pie-chart fs-5"></i>
                        <span class="fw-medium">Dashboard & Đối soát</span>
                    </a>
                    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2.5 rounded mb-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaxAccount" && ViewContext.RouteData.Values["action"]?.ToString() != "Lookup" ? "active" : "")" asp-controller="TaxAccount" asp-action="Index">
                        <i class="bi bi-buildings fs-5"></i>
                        <span class="fw-medium">Tài khoản thuế</span>
                    </a>
                    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2.5 rounded mb-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "TaxAccount" && ViewContext.RouteData.Values["action"]?.ToString() == "Lookup" ? "active" : "")" asp-controller="TaxAccount" asp-action="Lookup">
                        <i class="bi bi-search fs-5"></i>
                        <span class="fw-medium">Tra cứu MST</span>
                    </a>
                    <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2.5 rounded mb-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLog" ? "active" : "")" asp-controller="AuditLog" asp-action="Index">
                        <i class="bi bi-shield-check fs-5"></i>
                        <span class="fw-medium">Nhật ký kiểm toán</span>
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2.5 rounded mb-1 text-info" href="/hangfire" target="_blank">
                            <i class="bi bi-cpu fs-5"></i>
                            <span class="fw-medium">Hangfire Jobs</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }


    <!-- Global Toast / Alert Notifications -->
    <div class="container-fluid px-2 px-sm-3 px-lg-4 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Body -->
    <main class="container-fluid px-2 px-sm-3 px-lg-4 py-2 py-sm-3 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Feedback Modal -->
    <div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="formFeedback" asp-controller="Feedback" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold" id="feedbackModalLabel"><i class="bi bi-chat-left-dots text-primary me-2"></i>Báo lỗi / Yêu cầu tính năng</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Phân loại yêu cầu</label>
                            <select name="requestType" class="form-select">
                                <option value="Báo lỗi">🐞 Báo lỗi hệ thống / Lỗi đọc XML / Sai lệch tiền</option>
                                <option value="Yêu cầu tính năng">💡 Đề xuất tính năng mới / Biểu mẫu báo cáo mới</option>
                                <option value="Hỗ trợ nghiệp vụ">🛠 Hỗ trợ nghiệp vụ đối soát / Thuế GTGT</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tiêu đề yêu cầu <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control" placeholder="Tóm tắt yêu cầu hoặc lỗi cần xử lý..." required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nội dung chi tiết <span class="text-danger">*</span></label>
                            <textarea name="description" class="form-control" rows="4" placeholder="Mô tả cụ thể số hóa đơn, ký hiệu hoặc tình huống phát sinh..." required></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Người liên hệ</label>
                                <input type="text" name="contactName" class="form-control" placeholder="Họ tên người gửi..." />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Số điện thoại</label>
                                <input type="text" name="contactPhone" class="form-control" placeholder="SĐT để kỹ thuật liên hệ..." />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light d-flex justify-content-between">
                        <a asp-controller="Feedback" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-list-ul me-1"></i> Danh sách yêu cầu
                        </a>
                        <div>
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-primary btn-sm fw-semibold"><i class="bi bi-send me-1"></i> Gửi yêu cầu</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <div>
                <strong>Phần mềm kế toán</strong> &bull; Quản lý hóa đơn điện tử chuẩn Nghị định 123/2020/NĐ-CP & Thông tư 78/2021/TT-BTC
            </div>
            <div>
                Môi trường: <span class="badge bg-success-subtle text-success border border-success-subtle">Hệ thống sẵn sàng</span> &bull; Bản quyền &copy; @DateTime.Now.Year
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Submit feedback ajax
        $('#formFeedback').on('submit', function(e) {
            e.preventDefault();
            var form = $(this);
            $.post(form.attr('action'), form.serialize(), function(res) {
                if (res.success) {
                    alert(res.message);
                    $('#feedbackModal').modal('hide');
                    form[0].reset();
                } else {
                    alert(res.message || 'Có lỗi xảy ra.');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
