@model List<InvoiceManager.Models.ViewModels.TaxAccountListItemViewModel>
@{
    ViewData["Title"] = "Quản lý Công ty / Hộ kinh doanh";
    int? currentId = ViewBag.CurrentTaxAccountId as int?;
    int totalPurchaseAll = Model.Sum(m => m.PurchaseInvoiceCount);
    int totalSoldAll = Model.Sum(m => m.SoldInvoiceCount);
    int totalInvoicesAll = Model.Sum(m => m.TotalInvoiceCount);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="fw-bold text-primary mb-1">
            <i class="bi bi-buildings me-2"></i> Quản lý Công ty & Hộ kinh doanh
        </h4>
        <p class="text-muted small mb-0">Tạo công ty 1 lần duy nhất, hệ thống tự động ghi nhớ thông tin và tài khoản kết nối cho các lần làm việc sau</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Lookup" class="btn btn-outline-primary btn-sm fw-semibold">
            <i class="bi bi-search me-1"></i> Tra cứu & Cào MST
        </a>
        <button type="button" class="btn btn-primary btn-sm fw-semibold px-3 shadow-sm" style="background-color: #1d64f2; border-color: #1d64f2;" onclick="openAddCompanyModal()">
            <i class="bi bi-plus-lg me-1"></i> Thêm công ty / Hộ kinh doanh
        </button>
    </div>
</div>

<!-- Thống kê nhanh tổng quan -->
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Công ty / HKD đã lưu</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@Model.Count <span class="fs-6 fw-normal text-muted">đơn vị</span></div>
                </div>
                <div class="bg-primary-subtle text-primary p-2 rounded-3">
                    <i class="bi bi-buildings fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Tổng HĐ Mua vào</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@totalPurchaseAll.ToString("N0") <span class="fs-6 fw-normal text-muted">HĐ</span></div>
                </div>
                <div class="bg-info-subtle text-info p-2 rounded-3">
                    <i class="bi bi-cart-check fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Tổng HĐ Bán ra</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@totalSoldAll.ToString("N0") <span class="fs-6 fw-normal text-muted">HĐ</span></div>
                </div>
                <div class="bg-success-subtle text-success p-2 rounded-3">
                    <i class="bi bi-send-check fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Tổng số Hóa đơn</div>
                    <div class="fs-4 fw-bold text-primary mt-1">@totalInvoicesAll.ToString("N0") <span class="fs-6 fw-normal text-muted">HĐ</span></div>
                </div>
                <div class="bg-warning-subtle text-warning p-2 rounded-3">
                    <i class="bi bi-receipt fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng Danh sách Doanh nghiệp & Hộ kinh doanh -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="fw-bold text-dark d-flex align-items-center gap-2">
            <i class="bi bi-table text-primary"></i> Danh sách Công ty / Hộ kinh doanh đã ghi nhớ
            <span class="badge bg-secondary-subtle text-secondary rounded-pill">@Model.Count</span>
        </div>
        <div class="d-flex gap-2">
            <div class="input-group input-group-sm" style="width: 280px;">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="filterInput" class="form-control border-start-0" placeholder="Tìm theo Tên, Tên gợi nhớ hoặc MST..." onkeyup="filterCompanyTable()" />
            </div>
        </div>
    </div>

    <div class="table-responsive table-invoice">
        <table class="table table-hover align-middle mb-0" id="companyTable">
            <thead class="table-light text-secondary small fw-semibold border-bottom">
                <tr>
                    <th class="text-center" style="width: 48px; white-space: nowrap;">STT</th>
                    <th style="min-width: 280px;">Công ty / Hộ kinh doanh & MST</th>
                    <th style="min-width: 150px;">Giám đốc / Kế toán</th>
                    <th class="text-center" style="width: 150px; white-space: nowrap;">Tài khoản kết nối</th>
                    <th class="text-center" style="width: 105px; white-space: nowrap;">Ngày tạo</th>
                    <th class="text-end" style="width: 100px; white-space: nowrap;">HĐ Mua vào</th>
                    <th class="text-end" style="width: 100px; white-space: nowrap;">HĐ Bán ra</th>
                    <th class="text-center" style="width: 210px; white-space: nowrap;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-buildings fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            Chưa có công ty hoặc hộ kinh doanh nào. Bấm nút <strong>"+ Thêm công ty / Hộ kinh doanh"</strong> để tạo mới.
                        </td>
                    </tr>
                }
                @{
                    int stt = 1;
                }
                @foreach (var acc in Model)
                {
                    bool isCurrent = acc.IsCurrent;
                    <tr class="@(isCurrent ? "table-primary bg-primary-subtle bg-opacity-25" : "")">
                        <td class="text-center text-muted fw-semibold">@stt</td>

                        <td>
                            <div>
                                <div class="d-flex align-items-center flex-wrap gap-1">
                                    <span class="fw-bold text-dark company-name">@acc.CompanyName</span>
                                    <span class="company-mst text-primary font-monospace" style="font-size: 0.85rem;">(@acc.TaxCode)</span>
                                    @if (!string.IsNullOrWhiteSpace(acc.ShortName) && !string.Equals(acc.ShortName, acc.CompanyName, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle" style="font-size: 0.68rem;">@acc.ShortName</span>
                                    }
                                    @if (acc.BusinessType == "HoKinhDoanh")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 0.68rem;">Hộ kinh doanh</span>
                                    }
                                    @if (isCurrent)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.68rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đang chọn
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(acc.Address))
                                {
                                    <div class="text-muted small text-truncate mt-1" style="max-width: 440px;" title="@acc.Address">
                                        <i class="bi bi-geo-alt text-danger me-1"></i>@acc.Address
                                    </div>
                                }
                            </div>
                        </td>

                        <td>
                            <div class="small">
                                @if (!string.IsNullOrWhiteSpace(acc.Representative))
                                {
                                    <div><span class="text-muted">GĐ:</span> <strong class="text-dark">@acc.Representative</strong></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(acc.AccountantName))
                                {
                                    <div><span class="text-muted">KT:</span> <span class="text-secondary fw-medium">@acc.AccountantName</span></div>
                                }
                                @if (string.IsNullOrWhiteSpace(acc.Representative) && string.IsNullOrWhiteSpace(acc.AccountantName))
                                {
                                    <span class="text-muted">—</span>
                                }
                            </div>
                        </td>

                        <td class="text-center" style="white-space: nowrap;">
                            <div class="d-flex flex-column gap-1 align-items-center">
                                @if (acc.HasEInvoiceConnected)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.68rem;">
                                        <i class="bi bi-link-45deg"></i> HĐĐT: Đã kết nối
                                    </span>
                                }
                                @if (acc.HasETaxConnected)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.68rem;">
                                        <i class="bi bi-link-45deg"></i> Thuế ĐT: Đã kết nối
                                    </span>
                                }
                                @if (!acc.HasEInvoiceConnected && !acc.HasETaxConnected)
                                {
                                    <span class="badge bg-light text-secondary border" style="font-size: 0.68rem;">Chưa liên kết</span>
                                }
                            </div>
                        </td>

                        <td class="text-center text-secondary small font-monospace" style="white-space: nowrap;">
                            @acc.CreatedAt.ToString("dd/MM/yyyy")
                        </td>

                        <td class="text-end font-monospace" style="white-space: nowrap;">
                            <span class="fw-semibold text-info">@acc.PurchaseInvoiceCount.ToString("N0")</span>
                        </td>

                        <td class="text-end font-monospace" style="white-space: nowrap;">
                            <span class="fw-semibold text-success">@acc.SoldInvoiceCount.ToString("N0")</span>
                        </td>

                        <td class="text-center" style="white-space: nowrap;">
                            <div class="d-inline-flex gap-1 align-items-center flex-nowrap">
                                @if (isCurrent)
                                {
                                    <a asp-controller="Invoice" asp-action="Index" class="btn btn-primary btn-sm px-2 fw-semibold" title="Xem danh sách hóa đơn">
                                        <i class="bi bi-receipt me-1"></i> Xem HĐ
                                    </a>
                                    <a asp-controller="Import" asp-action="Index" class="btn btn-success btn-sm px-2 fw-semibold" title="Đồng bộ hóa đơn từ Cổng Thuế">
                                        <i class="bi bi-cloud-arrow-down-fill me-1"></i> API Thuế
                                    </a>
                                }
                                else
                                {
                                    <form asp-action="Switch" method="post" class="m-0 d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@acc.Id" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm px-2 fw-semibold" title="Chọn làm việc với công ty này">
                                            <i class="bi bi-check2-circle me-1"></i> Chọn
                                        </button>
                                    </form>
                                    <form asp-action="Switch" method="post" class="m-0 d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@acc.Id" />
                                        <input type="hidden" name="returnUrl" value="/Import?tab=api" />
                                        <button type="submit" class="btn btn-outline-success btn-sm px-2 fw-semibold" title="Mở đồng bộ API Thuế cho công ty này">
                                            <i class="bi bi-cloud-arrow-down-fill"></i> API
                                        </button>
                                    </form>
                                }

                                <button type="button" class="btn btn-outline-danger btn-sm px-2 fw-semibold" title="Xóa công ty khỏi hệ thống" 
                                        onclick="openDeleteModal(@acc.Id, '@Html.Raw(acc.TaxCode.Replace("'", "\\'"))', '@Html.Raw(acc.CompanyName.Replace("'", "\\'").Replace("\"", "&quot;"))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    stt++;
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer bg-white py-3 text-center border-top">
        <button type="button" class="btn text-white fw-bold px-4 py-2 shadow-sm rounded-3" style="background-color: #1d64f2; border: none; font-size: 0.9rem;" onclick="openAddCompanyModal()">
            <i class="bi bi-plus-lg me-1"></i> Thêm công ty / Hộ kinh doanh
        </button>
    </div>
</div>

<!-- Modal Xác nhận xóa Doanh nghiệp -->
<div class="modal fade" id="deleteTaxAccountModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-danger text-white py-3">
                <h6 class="modal-title fw-bold" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Xác nhận xóa Công ty / Hộ kinh doanh
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Delete" method="post" id="deleteForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteTaxAccountId" value="" />
                <div class="modal-body p-4">
                    <p class="mb-2">Bạn có chắc chắn muốn xóa công ty / hộ kinh doanh sau:</p>
                    <div class="p-3 bg-light rounded border mb-3">
                        <div class="fw-bold text-dark fs-6" id="deleteCompanyName"></div>
                        <div class="font-monospace text-primary small mt-1">
                            <i class="bi bi-card-heading me-1"></i> MST: <span id="deleteTaxCode"></span>
                        </div>
                    </div>
                    <div class="alert alert-danger border-danger-subtle small mb-0">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        <strong>Cảnh báo:</strong> Thao tác này <u>không thể hoàn tác</u>. Toàn bộ hóa đơn, dòng hàng chi tiết và dữ liệu đồng bộ của đơn vị này sẽ bị xóa khỏi hệ thống.
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-4">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> Hủy bỏ
                    </button>
                    <button type="submit" class="btn btn-danger btn-sm fw-bold">
                        <i class="bi bi-trash me-1"></i> Xác nhận xóa vĩnh viễn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(id, taxCode, companyName) {
            $('#deleteTaxAccountId').val(id);
            $('#deleteTaxCode').text(taxCode);
            $('#deleteCompanyName').text(companyName);
            var modal = new bootstrap.Modal(document.getElementById('deleteTaxAccountModal'));
            modal.show();
        }

        function filterCompanyTable() {
            var input = document.getElementById("filterInput");
            var filter = input.value.toUpperCase();
            var table = document.getElementById("companyTable");
            var tr = table.getElementsByTagName("tr");

            for (var i = 1; i < tr.length; i++) {
                var rowText = tr[i].textContent || tr[i].innerText || "";
                if (rowText.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    </script>
}
