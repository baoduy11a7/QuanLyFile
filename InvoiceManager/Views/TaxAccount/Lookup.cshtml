@model InvoiceManager.Models.ViewModels.TaxCodeLookupResult
@{
    ViewData["Title"] = "Tra cứu & Cào thông tin Mã số thuế";
    string initialTaxCode = ViewBag.InitialTaxCode as string ?? "";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <!-- Header & Search Box -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4 bg-light-subtle rounded-3">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-primary text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-search fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-primary mb-1">Tra Cứu & Cào Thông Tin Mã Số Thuế</h4>
                        <p class="text-muted small mb-0">Truy xuất dữ liệu pháp nhân trực tiếp từ Cổng thông tin Quốc gia & Tổng cục Thuế</p>
                    </div>
                </div>

                <form method="get" asp-action="Lookup" id="lookupForm" class="mt-3">
                    <div class="input-group input-group-lg shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-building"></i>
                        </span>
                        <input type="text" name="taxCode" id="taxCodeInput" class="form-control border-start-0 font-monospace fw-bold text-primary fs-4" 
                               placeholder="Nhập mã số thuế doanh nghiệp (ví dụ: 0105880697)..." 
                               value="@(Model?.TaxCode ?? initialTaxCode)" autofocus required />
                        <button type="submit" id="btnSubmitLookup" class="btn btn-primary px-4 fw-semibold d-flex align-items-center gap-2">
                            <span id="lookupSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                            <i id="lookupIcon" class="bi bi-cloud-arrow-down-fill"></i>
                            <span>Cào thông tin</span>
                        </button>
                    </div>
                </form>

                <!-- Gợi ý MST mẫu để thử nghiệm nhanh -->
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-2 border-top">
                    <span class="small text-muted fw-semibold"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Thử nhanh:</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm font-monospace sample-mst" data-mst="0105880697">
                        0105880697 (Hà Nội Lighting)
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm font-monospace sample-mst" data-mst="0100109106">
                        0100109106 (Viettel)
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm font-monospace sample-mst" data-mst="0101234567">
                        0101234567 (An Phát)
                    </button>
                </div>
            </div>
        </div>

        <!-- Kết quả tra cứu -->
        @if (Model != null)
        {
            if (Model.Success)
            {
                <div class="card shadow-sm border-0 border-top border-4 border-success animate__animated animate__fadeIn">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-2">
                                <i class="bi bi-check-circle-fill me-1"></i> @(Model.Status ?? "NNT đang hoạt động")
                            </span>
                            @if (Model.ExistsInSystem)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-2">
                                    <i class="bi bi-database-check me-1"></i> Đã có trong hệ thống
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fs-6 px-3 py-2">
                                    <i class="bi bi-plus-circle me-1"></i> Chưa thêm vào hệ thống
                                </span>
                            }
                        </div>
                        <span class="text-muted small">
                            <i class="bi bi-shield-check text-success me-1"></i> Nguồn: @Model.Source
                        </span>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-12">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Tên doanh nghiệp chính thức</div>
                                <h4 class="fw-bold text-dark mb-1">@Model.CompanyName</h4>
                                @if (!string.IsNullOrEmpty(Model.InternationalName))
                                {
                                    <div class="text-secondary fst-italic">@Model.InternationalName</div>
                                }
                            </div>

                            <div class="col-md-6">
                                <div class="border rounded-3 p-3 bg-light-subtle h-100">
                                    <div class="text-muted small text-uppercase fw-semibold mb-1">
                                        <i class="bi bi-upc-scan me-1 text-primary"></i> Mã số thuế
                                    </div>
                                    <div class="fs-4 font-monospace fw-bold text-primary">@Model.TaxCode</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="border rounded-3 p-3 bg-light-subtle h-100">
                                    <div class="text-muted small text-uppercase fw-semibold mb-1">
                                        <i class="bi bi-activity me-1 text-success"></i> Tình trạng hoạt động
                                    </div>
                                    <div class="fs-5 fw-bold text-success">
                                        <i class="bi bi-check-circle me-1"></i> @(Model.Status ?? "Đang hoạt động")
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="border rounded-3 p-3 bg-light-subtle">
                                    <div class="text-muted small text-uppercase fw-semibold mb-1">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Địa chỉ trụ sở chính (theo ĐKKD)
                                    </div>
                                    <div class="fw-semibold text-dark fs-6">@Model.Address</div>
                                </div>
                            </div>
                        </div>

                        <!-- Các hành động tiếp theo -->
                        <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                            </a>

                            <div class="d-flex gap-2">
                                @if (Model.ExistsInSystem && Model.ExistingAccountId.HasValue)
                                {
                                    <form asp-action="Switch" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.ExistingAccountId.Value" />
                                        <button type="submit" class="btn btn-primary fw-semibold px-4">
                                            <i class="bi bi-arrow-left-right me-1"></i> Chuyển sang làm việc với MST này
                                        </button>
                                    </form>
                                }
                                else if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="QuickAddFromTaxCode" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="taxCode" value="@Model.TaxCode" />
                                        <button type="submit" class="btn btn-success fw-semibold px-4">
                                            <i class="bi bi-plus-circle-fill me-1"></i> Thêm nhanh vào Hệ thống (1-Click)
                                        </button>
                                    </form>

                                    <a asp-action="Create" 
                                       asp-route-taxCode="@Model.TaxCode" 
                                       asp-route-companyName="@Model.CompanyName" 
                                       asp-route-address="@Model.Address" 
                                       class="btn btn-outline-primary fw-semibold">
                                        <i class="bi bi-pencil-square me-1"></i> Tùy chỉnh chi tiết & Lưu
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger shadow-sm p-4 d-flex align-items-start gap-3">
                    <i class="bi bi-exclamation-octagon-fill fs-2 text-danger"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Không thể lấy thông tin doanh nghiệp</h5>
                        <p class="mb-0">@Model.Message</p>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Xử lý khi nhấn nút MST mẫu
            $('.sample-mst').on('click', function () {
                var mst = $(this).data('mst');
                $('#taxCodeInput').val(mst);
                $('#lookupForm').submit();
            });

            $('#lookupForm').on('submit', function () {
                $('#btnSubmitLookup').prop('disabled', true);
                $('#lookupSpinner').removeClass('d-none');
                $('#lookupIcon').addClass('d-none');
            });
        });
    </script>
}
